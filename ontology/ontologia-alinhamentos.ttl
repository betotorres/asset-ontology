@prefix rec: <https://www.latitude.unb.br/ontologia/recuperacao-ativos#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://www.latitude.unb.br/ontologia/recuperacao-ativos-alinhamentos> a owl:Ontology ;
  owl:imports <https://www.latitude.unb.br/ontologia/recuperacao-ativos> , <http://xmlns.com/foaf/0.1/> , <http://www.w3.org/ns/org#> , <http://www.w3.org/ns/prov#> , <http://www.w3.org/ns/regorg#> ;
  dcterms:title "Ontologia do domínio recuperacao-ativos — módulo de alinhamento"@pt-BR ;
  dcterms:description "Módulo de alinhamento (EOA/OCO): importa o núcleo e declara o reuso de ontologias externas (FIBO, FOAF, FTM, ORG, PROV-O, REGORG, schema), a tipagem PROV-O e as origens de desenho."@pt-BR ;
  dcterms:created "2026-10-06" ;
  owl:versionInfo "0.2.0-oco" ;
  rdfs:comment "Versões das ontologias reusadas: ACO (desenho); FIBO (owl) master/latest (2026Q1); FOAF (owl) 0.99; FTM (skos) v4.11.0; ORG (owl) W3C Recommendation 2014-01-16; PROV-O (owl) W3C Recommendation 2013-04-30; REGORG (owl) W3C Working Group Note 2013-08-01; schema (owl) latest; SUMO (desenho)."@pt-BR .

# --- Propriedades de anotação do alinhamento
rec:origemDeDesenho a owl:AnnotationProperty ; rdfs:label "origem de desenho"@pt-BR ; rdfs:comment "Conceito de ontologia sem IRI OWL utilizável (ACO, SUMO) que serviu de referência de modelagem — registro de reuso sem axioma."@pt-BR .
rec:referenciaExternaNaoResolvida a owl:AnnotationProperty ; rdfs:label "referência externa não resolvida"@pt-BR ; rdfs:comment "Correspondência decidida no EOA cuja IRI não pôde ser confirmada na fonte; fica como texto até resolução."@pt-BR .

