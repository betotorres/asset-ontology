rec:registradoEm a owl:ObjectProperty ;
  rdfs:label "REGISTRADO_EM"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:Ativo rec:AtoNotarial rec:Avaliacao rec:Destinacao rec:EventoDeTramitacao rec:PedidoDeCooperacaoJuridicaInternacional rec:ProcessoJudicial ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( rec:RegistroPublicoDeBem rec:SistemaDeInformacao ) ] ;
  rdfs:comment "Ativo REGISTRADO_EM RegistroPublicoDeBem — Relação registral consolidada."@pt-BR ;
  rdfs:comment "AtoNotarial REGISTRADO_EM SistemaDeInformacao"@pt-BR ;
  rdfs:comment "Avaliacao REGISTRADO_EM SistemaDeInformacao"@pt-BR ;
  rdfs:comment "Destinacao REGISTRADO_EM SistemaDeInformacao — Sistema de registro da decisao ja e classe propria (SistemaDeInformacao) — reaproveitando o mesmo tipo de relacao ja usado por Ativo->RegistroPublicoDeBem."@pt-BR ;
  rdfs:comment "EventoDeTramitacao REGISTRADO_EM SistemaDeInformacao"@pt-BR ;
  rdfs:comment "PedidoDeCooperacaoJuridicaInternacional REGISTRADO_EM SistemaDeInformacao"@pt-BR ;
  rdfs:comment "ProcessoJudicial REGISTRADO_EM SistemaDeInformacao"@pt-BR ;
  skos:changeNote "AJ-119 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Relação adicionada à mão na revisão da DKD. O que se registra no sistema é a decisão de destinação, não a autoridade que a toma: a origem passa a ser Destinacao."@pt-BR ;
  skos:changeNote "AJ-207 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC identificação e registro: \"AtoNotarial —INDEXADO_EM→ CentralNotarialDeServiçosCompartilhados\"; resposta humana do ASD e R39 pedem a integração com a CENSEC. Mesmo verbo já usado para Destinacao e Ativo."@pt-BR ;
  skos:changeNote "AJ-221 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC constrição: \"AvaliaçãoPatrimonial —REGISTRADA_EM→ SistemaDeInformação\"; DKC movimentação registra o teste de compatibilidade nos autos. Comum às duas, vai para o gênero."@pt-BR ;
  skos:changeNote "AJ-372 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura o evento de tramitação em quatro categorias — \"EventoDeAndamento: estado do pedido no momento; data/hora; sequência de estados ao longo do tempo (histórico, não valor único)\" (pedidos), \"EventoDeTramitação: tipoDeEvento (envio, saneamento, reclassificação de via, resposta), dataDoEvento\" (marco normativo), \"EventoDeTramitação (marco/mudança de estado) … OCORRE_EM Pedido, É_PRATICADO_POR órgão, É_REGISTRADO_EM SistemaDeInformação\" (tramitação) e EventoDeReclassificaçãoDeVia/EventoDeRetrabalho (gestão) — e a DKD manteve só faseDoFluxo e status como valor único no pedido. ASD R27 pede os marcos visíveis (pedido formulado, saneamento, complementação, resposta, bloqueio confirmado, repatriação) e R59 a linha do tempo. Evento concreto, com dado por trás — não o gênero abstrato Evento, que ficou descartado."@pt-BR ;
  skos:changeNote "AJ-391 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal em duas categorias: \"Pedido —REGISTRADO_EM→ SistemaDeTramitaçãoDeCooperação\" / \"—TRAMITA_EM→\". Mesmo verbo já usado por Ativo, Destinacao e Avaliacao."@pt-BR ;
  skos:changeNote "AJ-407 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal em três categorias: \"TRAMITA_EM SistemaDeProcessoEletrônico\", \"REGISTRADO_EM SistemaOuBaseDeDados\", \"sistema eletrônico em que tramita\". Mesmo verbo já usado por Pedido, Ativo, Destinacao e Avaliacao."@pt-BR .

rec:relacionaSeCom a owl:ObjectProperty ;
  rdfs:label "RELACIONA_SE_COM"@pt-BR ;
  rdfs:domain rec:ProcessoJudicial ;
  rdfs:range rec:ProcessoJudicial ;
  rdfs:comment "ProcessoJudicial RELACIONA_SE_COM ProcessoJudicial"@pt-BR ;
  skos:changeNote "AJ-406 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal em duas categorias: \"ProcessoJudicial —RELACIONA_SE_COM→ ProcessoJudicial (mesmo bem ou mesma pessoa em outra jurisdição/esfera; constrição sobreposta em outra vara)\". ASD R55 (mesmo nome, entidade ou bem em processos anteriores, varas e esferas diferentes) e B31 (constrição do mesmo bem por juízos diferentes, descoberta por acaso)."@pt-BR .

rec:requeridaPor a owl:ObjectProperty ;
  rdfs:label "REQUERIDA_POR"@pt-BR ;
  rdfs:domain rec:MedidaJudicialSobreAtivo ;
  rdfs:range rec:OrgaoDeAcusacao ;
  rdfs:comment "MedidaJudicialSobreAtivo REQUERIDA_POR OrgaoDeAcusacao"@pt-BR ;
  skos:changeNote "AJ-362 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC constricao: \"MedidaDeConstrição —REQUERIDA_POR→ ÓrgãoDeAcusação\" e \"DecretoDePerdimento —REQUERIDO_POR→ ÓrgãoDeAcusação\"; a ontologia tinha só a primeira, mais a inversa OrgaoDeAcusacao REQUER MedidaDeConstricao. Sobe para o gênero (cobre também o decreto e a alienação, que o MP requer) e a inversa sai por duplicar."@pt-BR .

