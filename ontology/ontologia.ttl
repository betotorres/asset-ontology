  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:DecretoDePerdimento rec:Destinacao rec:LancamentoFinanceiro ) ] ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-248 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação. A lista \"fundo, vítimas, erário, partilha, leilão\" mistura o tipo do destinatário (fundo, vítimas, erário — já em EnteDestinatario.tipoDeDestinatario, via BENEFICIA) com a modalidade (partilha, leilão); e \"partilha internacional\" é agora a subclasse Repatriacao."@pt-BR .

rec:moeda a owl:DatatypeProperty ;
