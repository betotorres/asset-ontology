  rdfs:range xsd:string ;
  skos:changeNote "AJ-205 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: tipoDeAto (AtoNotarial: escritura, procuração) e naturezaDoAto (AtoRegistral: transmissão, registro, averbação) são o mesmo dado com dois nomes; a DKC usa \"naturezaDoAto\" nas duas fichas. Unificado no gênero, com a regra de Ativo.tipoDeAtivo: usar só quando não houver subclasse específica."@pt-BR .

rec:naturezaDoCanal a owl:DatatypeProperty ;
