rec:indica a owl:ObjectProperty ;
  rdfs:label "INDICA"@pt-BR ;
  rdfs:domain rec:PedidoDeCooperacaoJuridicaInternacional ;
  rdfs:range rec:ValorEconomicoDeAtivo ;
  rdfs:comment "PedidoDeCooperacaoJuridicaInternacional INDICA ValorEconomicoDeAtivo — Substitui valorEstimado/moeda — REFERE_SE_A já aponta pro ativo específico, tipoDeValor já lista \"estimado\". INDICA (não DETERMINA) porque um pedido apenas informa uma estimativa, não a determina."@pt-BR ;
  rec:proveniencia "inclui par(es) adicionado(s) manualmente na revisão humana da DKD"@pt-BR .

rec:instaura a owl:ObjectProperty ;
  rdfs:label "INSTAURA"@pt-BR ;
  rdfs:domain rec:PecaProcessual ;
  rdfs:range rec:IncidenteDeRestituicao ;
  rdfs:comment "PecaProcessual INSTAURA IncidenteDeRestituicao"@pt-BR ;
  skos:changeNote "AJ-140 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC tramitação captura PeçaProcessual (tipo, data de elaboração, data de juntada, autor, nível de sigilo) com DecisãoJudicial como sua especialização e relações com processo, incidente e documentos anexos; nada disso chegou à DKD. ASD R20 e R50 pedem o vínculo da decisão e da procedência à \"peça\"."@pt-BR .

rec:instrui a owl:ObjectProperty ;
  rdfs:label "INSTRUI"@pt-BR ;
