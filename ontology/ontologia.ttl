  rdfs:comment "[LancamentoFinanceiro] data do lançamento"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:Exequatur rec:LancamentoFinanceiro ) ] ;
  rdfs:range xsd:dateTime .

rec:dataBase a owl:DatatypeProperty ;
