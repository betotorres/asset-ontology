  rdfs:domain rec:RedeDeCooperacaoInternacional ;
  rdfs:range xsd:string .

rec:tipoDeArtefato a owl:DatatypeProperty ;
  rdfs:label "tipoDeArtefato"@pt-BR ;
  rdfs:comment "[SistemaDeInformacao] sistema, base, planilha, correio ou repositório"@pt-BR ;
  rdfs:domain rec:SistemaDeInformacao ;
  rdfs:range xsd:string .

rec:tipoDeAtivo a owl:DatatypeProperty ;
  rdfs:label "tipoDeAtivo"@pt-BR ;
  rdfs:comment "[Ativo] Tipo do bem ou ativo — usar apenas quando não houver uma subclasse específica já associada (ex.: Aeronave, Veículo, BemImóvel, AtivoFinanceiro, AtivoDePropriedadeIntelectual, Criptoativo)."@pt-BR ;
  rdfs:domain rec:Ativo ;
  rdfs:range xsd:string .

rec:tipoDeAtor a owl:DatatypeProperty ;
  rdfs:label "tipoDeAtor"@pt-BR ;
  rdfs:comment "[AtorInstitucional] Tipo institucional — usar apenas quando não houver uma subclasse específica já associada (ex.: OrgaoJudicial, OrgaoDeAcusacao, AutoridadeCentral, UnidadeOrganizacional)."@pt-BR ;
  rdfs:domain rec:AtorInstitucional ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-106 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Recriado só para documentar: o atributo compete com a taxonomia de subclasses e passa a valer apenas quando não houver subclasse específica — mesma regra dada a Ativo.tipoDeAtivo na DKD."@pt-BR .

rec:tipoDeDecisao a owl:DatatypeProperty ;
  rdfs:label "tipoDeDecisao"@pt-BR ;
  rdfs:comment "[DecisaoJudicial] tipo de pronunciamento ou decisão"@pt-BR ;
  rdfs:domain rec:DecisaoJudicial ;
  rdfs:range xsd:string .

rec:tipoDeDestinatario a owl:DatatypeProperty ;
  rdfs:label "tipoDeDestinatario"@pt-BR ;
  rdfs:comment "[EnteDestinatario] fundo, vítimas, erário ou ente estrangeiro"@pt-BR ;
  rdfs:domain rec:EnteDestinatario ;
  rdfs:range xsd:string .

rec:tipoDeDocumento a owl:DatatypeProperty ;
  rdfs:label "tipoDeDocumento"@pt-BR ;
  rdfs:comment "[DocumentoComprobatorio] tipo do documento comprobatório (certidão de matrícula, CRLV, contrato social, contrato, recibo, nota fiscal)"@pt-BR ;
  rdfs:comment "[DocumentoDoPedido] formulário, certidão, tradução, relatório, PDF ou outro anexo"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:DocumentoComprobatorio rec:DocumentoDoPedido ) ] ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-144 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC tramitação captura DocumentoComprobatório (certidões e documentos juntados: registro de imóveis, trânsito, societários, contratos, declarações retificadas, recibos, notas fiscais) com emissor, data de juntada, bem comprovado e alegação que sustenta; a DKD ficou só com Documento genérico."@pt-BR .

rec:tipoDeEvento a owl:DatatypeProperty ;
  rdfs:label "tipoDeEvento"@pt-BR ;
  rdfs:comment "[EventoDeTramitacao] tipo do evento: formulação, envio, saneamento, complementação, reclassificação de via, resposta recebida, bloqueio confirmado, repatriação, exequatur"@pt-BR ;
  rdfs:comment "[SucessaoDeEntidade] Fusão, cisão, incorporação ou reestruturação (ORG ChangeEvent; FTM Succession)."@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:EventoDeTramitacao rec:SucessaoDeEntidade ) ] ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-368 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura o evento de tramitação em quatro categorias — \"EventoDeAndamento: estado do pedido no momento; data/hora; sequência de estados ao longo do tempo (histórico, não valor único)\" (pedidos), \"EventoDeTramitação: tipoDeEvento (envio, saneamento, reclassificação de via, resposta), dataDoEvento\" (marco normativo), \"EventoDeTramitação (marco/mudança de estado) … OCORRE_EM Pedido, É_PRATICADO_POR órgão, É_REGISTRADO_EM SistemaDeInformação\" (tramitação) e EventoDeReclassificaçãoDeVia/EventoDeRetrabalho (gestão) — e a DKD manteve só faseDoFluxo e status como valor único no pedido. ASD R27 pede os marcos visíveis (pedido formulado, saneamento, complementação, resposta, bloqueio confirmado, repatriação) e R59 a linha do tempo. Evento concreto, com dado por trás — não o gênero abstrato Evento, que ficou descartado."@pt-BR .

rec:tipoDeIdentificador a owl:DatatypeProperty ;
  rdfs:label "tipoDeIdentificador"@pt-BR ;
  rdfs:comment "[IdentificadorDePessoa] tipo do identificador"@pt-BR ;
  rdfs:domain rec:IdentificadorDePessoa ;
  rdfs:range xsd:string .

rec:tipoDeInstrumento a owl:DatatypeProperty ;
  rdfs:label "tipoDeInstrumento"@pt-BR ;
  rdfs:comment "[InstrumentoJuridicoDeCooperacao] Tipo do instrumento (convenção multilateral, tratado bilateral, reciprocidade) — usar apenas quando não houver uma subclasse específica já associada."@pt-BR ;
  rdfs:domain rec:InstrumentoJuridicoDeCooperacao ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-298 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: \"InstrumentoJurídicoDeCooperação —ESPECIALIZA_SE_EM→ ConvençãoMultilateral / TratadoBilateralDeAssistênciaJurídicaMútua / BaseDeCooperaçãoPorReciprocidade\", cada uma com atributos próprios (marco-normativo-e-instrumentos-juridicos-aplicaveis-entidades.md). ASD R46 nomeia UNCAC, Palermo, OEA e MLATs; R25 põe o instrumento como determinante da via. O atributo tipoDeInstrumento passa a valer só quando não houver subclasse específica — mesma regra de Ativo.tipoDeAtivo e AtorInstitucional.tipoDeAtor."@pt-BR .

rec:tipoDeLista a owl:DatatypeProperty ;
  rdfs:label "tipoDeLista"@pt-BR ;
  rdfs:comment "[ListaRestritiva] tipo da lista de sanções"@pt-BR ;
  rdfs:domain rec:ListaRestritiva ;
  rdfs:range xsd:string .

rec:tipoDeMedida a owl:DatatypeProperty ;
  rdfs:label "tipoDeMedida"@pt-BR ;
  rdfs:comment "[MedidaDeConstricao] Tipo da medida (sequestro, arresto, hipoteca legal, bloqueio, indisponibilidade, apreensão ou outra) — usar apenas quando não houver uma subclasse específica já associada."@pt-BR ;
  rdfs:domain rec:MedidaDeConstricao ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-366 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação: MedidaDeConstricao tem cinco espécies (AJ-66 a AJ-70), então tipoDeMedida vale só quando não houver subclasse específica — mesma regra de Ativo.tipoDeAtivo, AtorInstitucional.tipoDeAtor e InstrumentoJuridicoDeCooperacao.tipoDeInstrumento."@pt-BR .

rec:tipoDeMedidaSolicitada a owl:DatatypeProperty ;
  rdfs:label "tipoDeMedidaSolicitada"@pt-BR ;
  rdfs:comment "[PedidoDeCooperacaoJuridicaInternacional] tipo de medida solicitada em texto (bloqueio, sequestro, confisco, repatriação) — recuo quando a fonte não tipifica; a forma estruturada é SOLICITA"@pt-BR ;
  rdfs:domain rec:PedidoDeCooperacaoJuridicaInternacional ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-388 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC em duas categorias: \"tipoDeMedidaSolicitada — bloqueio, sequestro, confisco, repatriação (categórico ou texto livre; sem tipificação estruturada)\". A forma estruturada é SOLICITA MedidaDeConstricao / Repatriacao; o texto fica como recuo quando a fonte não tipifica — mesmo padrão de FundamentoLegal.referenciaNormativa e NexoCausal.descricaoDoNexo."@pt-BR .

rec:tipoDeOnus a owl:DatatypeProperty ;
  rdfs:label "tipoDeOnus"@pt-BR ;
  rdfs:comment "[AverbacaoDeOnus] tipo do ônus real: hipoteca convencional, penhor, usufruto, servidão ou outro"@pt-BR ;
  rdfs:domain rec:AverbacaoDeOnus ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-307 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: \"AverbaçãoDeÔnus —SUBCLASSE_DE→ RestriçãoOuÔnusSobreBem\" (tipoDeÔnus, beneficiárioDoÔnus, dataDaAverbação) e \"AlienaçãoFiduciária —SUBCLASSE_DE→ RestriçãoOuÔnusSobreBem\" (credorFiduciário, dataDoRegistro) (registro-e-titularidade-de-bens-entidades.md); a DKD manteve só o gênero. ASD B21: oneração proposital do bem (alienação fiduciária, hipoteca, ônus averbado) para diluir a aparência de valor disponível. O beneficiário e o credor fiduciário são o BENEFICIA Pessoa herdado."@pt-BR .

rec:tipoDeOrigemDoBem a owl:DatatypeProperty ;
  rdfs:label "tipoDeOrigemDoBem"@pt-BR ;
  rdfs:comment "[FundamentoLegal] origem do bem associada ao fundamento de perdimento"@pt-BR ;
  rdfs:domain rec:FundamentoLegal ;
  rdfs:range xsd:string .

rec:tipoDeParentesco a owl:DatatypeProperty ;
  rdfs:label "tipoDeParentesco"@pt-BR ;
  rdfs:comment "[VinculoDeParentesco] cônjuge, ex-cônjuge, companheiro, ascendente, descendente, colateral (FTM Family.relationship)"@pt-BR ;
  rdfs:domain rec:VinculoDeParentesco ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-430 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: \"VínculoDeParentesco (especialização de VínculoEntrePessoas): tipoDeParentesco — cônjuge, ex-cônjuge, parente em diferentes graus; grauDeParentesco — ex.: primeiro grau; parentescoPorAfinidade — não declarado nas bases\" (identificacao-de-pessoas-e-estruturas-societarias-entidades.md). A DKD manteve só o gênero, com regimeDeBens (\"aplicável a vínculos de parentesco\") pendurado nele. Das quatro espécies de tipoDeVinculo, parentesco era a única sem classe — e é a do núcleo da tese (isMotherOf, isFatherOf, isSpouseOf) e do ASD R37 (interpostas pessoas por parentesco), R34 e B26. FTM Family (person, relative, relationship) é o par exato; o narrowMatch que VinculoEntrePessoas tinha com Family passa a esta classe."@pt-BR .

rec:tipoDePeca a owl:DatatypeProperty ;
  rdfs:label "tipoDePeca"@pt-BR ;
  rdfs:comment "[PecaProcessual] tipo da peça (denúncia, pedido de sequestro/arresto, manifestação, alegações finais, recurso, petição da defesa, despacho)"@pt-BR ;
  rdfs:domain rec:PecaProcessual ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-133 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC tramitação captura PeçaProcessual (tipo, data de elaboração, data de juntada, autor, nível de sigilo) com DecisãoJudicial como sua especialização e relações com processo, incidente e documentos anexos; nada disso chegou à DKD. ASD R20 e R50 pedem o vínculo da decisão e da procedência à \"peça\"."@pt-BR .

rec:tipoDePropriedadeIntelectual a owl:DatatypeProperty ;
  rdfs:label "tipoDePropriedadeIntelectual"@pt-BR ;
  rdfs:comment "[AtivoDePropriedadeIntelectual] marca, patente ou desenho [requer pesquisa adicional]"@pt-BR ;
  rdfs:domain rec:AtivoDePropriedadeIntelectual ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-166 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: O atributo tinha o mesmo nome de Ativo.tipoDeAtivo, herdado, com outro sentido (marca, patente ou desenho)."@pt-BR .

rec:tipoDeRegistro a owl:DatatypeProperty ;
  rdfs:label "tipoDeRegistro"@pt-BR ;
  rdfs:comment "[RegistroPublicoDeBem] tipo do registro"@pt-BR ;
  rdfs:domain rec:RegistroPublicoDeBem ;
  rdfs:range xsd:string .

rec:tipoDeRepresentacao a owl:DatatypeProperty ;
  rdfs:label "tipoDeRepresentacao"@pt-BR ;
  rdfs:comment "[VinculoDeRepresentacao] representante legal de empresa, procurador ou outra forma de representação"@pt-BR ;
  rdfs:domain rec:VinculoDeRepresentacao ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-215 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC identificação de pessoas: \"VínculoDeRepresentação (especialização de VínculoEntrePessoas): tipoDeRepresentação (representante legal, procurador), indicadorDeControleDeFato (ex.: empresa controlada por procuração), INSTRUMENTADO_POR AtoNotarial\". Lacuna externa FTM Representation mantida no ORR, IRI confirmada."@pt-BR .

rec:tipoDeRequisito a owl:DatatypeProperty ;
  rdfs:label "tipoDeRequisito"@pt-BR ;
  rdfs:comment "[RequisitoFormal] tradução, apostilamento, autenticação, formato ou detalhamento"@pt-BR ;
  rdfs:domain rec:RequisitoFormal ;
  rdfs:range xsd:string .

rec:tipoDeRestricao a owl:DatatypeProperty ;
  rdfs:label "tipoDeRestricao"@pt-BR ;
  rdfs:comment "[RestricaoOuOnusSobreBem] Tipo da restrição (ônus real, restrição administrativa — ex.: de órgão de trânsito — ou outra) — usar apenas quando não houver uma subclasse específica. Indisponibilidade e constrição judicial são MedidaDeConstricao."@pt-BR ;
  rdfs:domain rec:RestricaoOuOnusSobreBem ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-313 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação. A lista da DKC (\"ônus, indisponibilidade, constrição judicial, restrição administrativa\") foi capturada antes de existir MedidaDeConstricao com suas espécies (AJ-66 a AJ-70, AJ-185): indisponibilidade e constrição judicial são medidas, não ônus — o que fica aqui é o ônus real e a restrição administrativa, e o atributo vale só quando não houver subclasse específica."@pt-BR .

rec:tipoDeTitularidade a owl:DatatypeProperty ;
  rdfs:label "tipoDeTitularidade"@pt-BR ;
  rdfs:comment "[AssercaoDeTitularidade] formal, indireta ou outra forma capturada"@pt-BR ;
  rdfs:domain rec:AssercaoDeTitularidade ;
  rdfs:range xsd:string .

rec:tipoDeValor a owl:DatatypeProperty ;
  rdfs:label "tipoDeValor"@pt-BR ;
  rdfs:comment "[ValorEconomicoDeAtivo] Natureza do valor: venal ou cadastral, declarado, estimado, de avaliação, de face, atualizado, do dano ou a recuperar, bloqueado, de alienação, repatriado ou de mercado."@pt-BR ;
  rdfs:domain rec:ValorEconomicoDeAtivo ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-480 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação: a lista de tipoDeValor estava menor que a da DKC e que o uso atual da classe. DKC valoração: \"venal/cadastral, declarado, estimado, de avaliação, do dano/a recuperar, bloqueado, de alienação\"; DKC constrição: \"atualizado, valor de face\"; e Repatriacao PRODUZ ValorEconomicoDeAtivo (repatriado). A DKC também as lista como sete subclasses, mas todas com os mesmos campos (montante, data) — sem conteúdo próprio, ficam como valores do atributo."@pt-BR .

rec:tipoDeVariante a owl:DatatypeProperty ;
  rdfs:label "tipoDeVariante"@pt-BR ;
  rdfs:comment "[NomeEVarianteDeGrafia] grafia divergente, homônimo, alias, transliteração ou tradução"@pt-BR ;
  rdfs:domain rec:NomeEVarianteDeGrafia ;
  rdfs:range xsd:string .

rec:tipoDeVia a owl:DatatypeProperty ;
  rdfs:label "tipoDeVia"@pt-BR ;
  rdfs:comment "[ViaProcessual] auxílio direto, carta rogatória, via diplomática ou rede"@pt-BR ;
  rdfs:domain rec:ViaProcessual ;
  rdfs:range xsd:string .

rec:tipoDeVinculo a owl:DatatypeProperty ;
  rdfs:label "tipoDeVinculo"@pt-BR ;
  rdfs:comment "[VinculoEntrePessoas] Tipo do vínculo (societário, controle, representação, parentesco, interposição, amizade, proximidade funcional) — usar apenas quando não houver uma subclasse específica já associada."@pt-BR ;
  rdfs:domain rec:VinculoEntrePessoas ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-434 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação: com ParticipacaoSocietaria, IndicacaoDeBeneficiarioFinal, VinculoDeRepresentacao, InterposicaoDePessoa e VinculoDeParentesco, tipoDeVinculo vale só quando não houver subclasse específica — mesma regra de tipoDeAtivo, tipoDeAtor, tipoDeInstrumento e tipoDeMedida."@pt-BR .

rec:tituloQueFundamentaABusca a owl:DatatypeProperty ;
  rdfs:label "tituloQueFundamentaABusca"@pt-BR ;
  rdfs:comment "[DossieDeBuscaPatrimonial] título ou fundamento da busca"@pt-BR ;
  rdfs:domain rec:DossieDeBuscaPatrimonial ;
  rdfs:range xsd:string .

rec:tradicaoJuridica a owl:DatatypeProperty ;
  rdfs:label "tradicaoJuridica"@pt-BR ;
  rdfs:comment "[Jurisdição] tradição jurídica predominante (common law, civil law, mista), condicionante das exigências formais"@pt-BR ;
  rdfs:domain rec:Jurisdicao ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-333 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC em duas categorias: \"tradição jurídica predominante (common law, civil law) como condicionante de exigências formais\" (pedidos) e \"tradiçãoJurídica (common law × civil law)\" (marco normativo). ASD B36: common law mais rigoroso com certificação e affidavits, civil law mais tolerante a cópia autenticada e tradução juramentada."@pt-BR .

rec:transitouEmJulgado a owl:DatatypeProperty ;
  rdfs:label "transitouEmJulgado"@pt-BR ;
  rdfs:comment "[DecisaoJudicial] se a decisão transitou em julgado"@pt-BR ;
  rdfs:domain rec:DecisaoJudicial ;
  rdfs:range xsd:boolean ;
  skos:changeNote "AJ-506 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: DecisaoJudicial.transitoEmJulgado era um texto para duas coisas (\"indicador e data de trânsito\"). Separa-se em booleano e data, para que a consulta gerencial que a DKC de gestão de carteira descreve (casos por estágio; \"trânsito em julgado\"; \"gap temporal entre perdimento declarado e destinação\") seja possível, e para sustentar StatusProbatorio.estagioProbatorio = \"decisão transitada em julgado\" (AJ-467)."@pt-BR .

rec:usoDeNotaVerbal a owl:DatatypeProperty ;
  rdfs:label "usoDeNotaVerbal"@pt-BR ;
  rdfs:comment "[BaseDeCooperacaoPorReciprocidade] se a cooperação por reciprocidade é formalizada por nota verbal"@pt-BR ;
  rdfs:domain rec:BaseDeCooperacaoPorReciprocidade ;
  rdfs:range xsd:boolean ;
  skos:changeNote "AJ-296 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC: BaseDeCooperaçãoPorReciprocidade.usoDeNotaVerbal (booleano) (marco-normativo-e-instrumentos-juridicos-aplicaveis-entidades.md); forma de formalização e jurisdições sob o regime ficam [requer pesquisa adicional]."@pt-BR .

rec:valorConvertido a owl:DatatypeProperty ;
  rdfs:label "valorConvertido"@pt-BR ;
  rdfs:comment "[ValorEconomicoDeAtivo] valor após conversão cambial quando aplicável"@pt-BR ;
  rdfs:domain rec:ValorEconomicoDeAtivo ;
  rdfs:range xsd:decimal .

rec:valorDoIdentificador a owl:DatatypeProperty ;
  rdfs:label "valorDoIdentificador"@pt-BR ;
  rdfs:comment "[IdentificadorDePessoa] valor do identificador"@pt-BR ;
  rdfs:domain rec:IdentificadorDePessoa ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-229 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: O atributo valor de IdentificadorDePessoa (o número do CPF, passaporte etc.) tinha alcance xsd:decimal herdado do nome compartilhado com LancamentoFinanceiro.valor; identificador é código, não quantia (mesma regra aplicada a numeroDaConta, renavam, isin). Renomeado e tipado como texto."@pt-BR .

rec:versao a owl:DatatypeProperty ;
  rdfs:label "versao"@pt-BR ;
  rdfs:comment "[DeclaracaoFiscalDeRendaEPatrimonio] versão da declaração"@pt-BR ;
  rdfs:comment "[DocumentoDoPedido] versão do documento"@pt-BR ;
  rdfs:comment "[PedidoDeCooperacaoJuridicaInternacional] versão do pedido (N), ligada à anterior por VERSIONA"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:DeclaracaoFiscalDeRendaEPatrimonio rec:DocumentoDoPedido rec:PedidoDeCooperacaoJuridicaInternacional ) ] ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-385 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC constricao: \"versaoDoPedido (vínculo versão N ↔ N-1)\" e \"Pedido —VERSIONA→ Pedido\". A DKD não manteve nem o atributo nem a relação; sem eles, pedido complementado ou reenviado vira registro duplicado (DKC gestão: \"efeito de duplicidade\")."@pt-BR .

rec:viaDeObtencao a owl:DatatypeProperty ;
  rdfs:label "viaDeObtencao"@pt-BR ;
  rdfs:comment "[ConsultaAFonte] consulta direta, integração, ofício, anexo processual ou cooperação"@pt-BR ;
  rdfs:domain rec:ConsultaAFonte ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-453 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: DKC: ConsultaAFonte / ConsultaAFonteDeDados / RegistroDeConsultaAFonte aparece em cinco categorias (identificação de pessoas, constrição, movimentação financeira, registro e titularidade, valoração) com os mesmos campos — base consultada, data da consulta, data de corte, chave utilizada, resultado (inclusive negativo), via de obtenção — e as relações \"ConsultaAFonte —DIRIGIDA_A→ SistemaOuBaseDeDados\", \"—REALIZADA_POR→ ÓrgãoDeBuscaPatrimonial\", \"—TEM_ALVO→ Pessoa\", \"—PRODUZ→ AsserçãoDeTitularidade / ValorEconômicoDeAtivo / DocumentoFonte\", \"—ATRIBUI→ StatusProbatório\" e \"DossiêPatrimonial —COMPOSTO_POR→ ConsultaAFonte\". A DKD descartou a classe, e com isso SistemaDeInformacao ficou sem uso analítico: nada dizia de que base, em que data e com que chave veio uma informação. É o que o ASD pede em R50 (procedência: base consultada, data da consulta), R51 (resultado como \"foto\" datada, não sobrescrita) e R52 (negativa de consulta registrada, para que ausência de resultado não seja lida como ausência de patrimônio) [R50–R52: lastro apenas sintético — requer validação humana]; a DKC marca a negativa e a data de corte como \"inexistente hoje\". O ORR já previa prov:Activity para \"a cadeia de proveniência das diligências que compõem o dossiê\"."@pt-BR .

rec:vigencia a owl:DatatypeProperty ;
  rdfs:label "vigencia"@pt-BR ;
  rdfs:comment "[DispositivoNormativo] vigência [requer pesquisa adicional]"@pt-BR ;
  rdfs:comment "[InstrumentoJuridicoDeCooperacao] vigência [requer pesquisa adicional]"@pt-BR ;
  rdfs:comment "[NormaNacional] vigência [requer pesquisa adicional]"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:DispositivoNormativo rec:InstrumentoJuridicoDeCooperacao rec:NormaNacional ) ] ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-288 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura NormaNacional (\"legislação interna de um Estado\": númeroEAnoDaLei, denominaçãoPopular, jurisdiçãoDeOrigem, temaNormativo, vigência) com \"É_COMPOSTA_POR DispositivoNormativo\", \"FUNDAMENTA MedidaDeConstriçãoOuPerdimento\" e \"VIGE_EM Jurisdição\" (marco-normativo-e-instrumentos-juridicos-aplicaveis-entidades.md). A DKD não a manteve: hoje um dispositivo de lei interna (CPP art. 125, Lei 8.429 art. 16, Lei 9.613) não tem norma a que pertencer — só o tratado tem (É_COMPOSTO_POR). Os próprios ajustes desta revisão citam essas leis como fonte \"norma\". Lacuna reconhecida pela DKC: \"tipificação penal como domínio conexo × interno [requer validação]\"."@pt-BR .

rec:volumeDePedidosEmAberto a owl:DatatypeProperty ;
  rdfs:label "volumeDePedidosEmAberto"@pt-BR ;
  rdfs:comment "[Jurisdição] quantidade de pedidos de cooperação em aberto com a jurisdição (métrica derivada dos pedidos)"@pt-BR ;
  rdfs:domain rec:Jurisdicao ;
  rdfs:range xsd:integer ;
  skos:changeNote "AJ-337 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC gestão de carteira, atributos literais da Jurisdição: \"volume de pedidos em aberto; tempo médio entre envio e resposta; taxa de sucesso\". ASD R56: \"tempo médio de resposta por país e taxa de sucesso por país/tratado\". tempoMedioDeResposta era string, inútil para a consulta gerencial; passa a decimal em dias (unidade é decisão de modelagem — a DKC não a informa). São métricas derivadas dos pedidos, mantidas como atributos porque a DKC as captura assim e o histórico consolidado \"inexistente\" é exatamente a lacuna que o ASD quer suprir."@pt-BR .

# --- Object properties (por verbo da DKD; domínio/alcance = união dos pares)
rec:incideSobreAtivo a owl:ObjectProperty ;
  rdfs:label "incide sobre ativo"@pt-BR ;
  rdfs:comment "Superpropriedade que reúne tudo o que pesa sobre um ativo (constrição, perdimento, destinação, restituição, alienação, repatriação, referência processual). Consolidação decidida no OCO (02, seção 4)."@pt-BR ;
  rdfs:range rec:Ativo .

rec:administra a owl:ObjectProperty ;
  rdfs:label "ADMINISTRA"@pt-BR ;
  rdfs:domain rec:OrgaoDeGestaoPatrimonial ;
  rdfs:range rec:Ativo ;
  rdfs:comment "OrgaoDeGestaoPatrimonial ADMINISTRA Ativo — Relação explicitamente modelada."@pt-BR .

rec:afeta a owl:ObjectProperty ;
  rdfs:label "AFETA"@pt-BR ;
  rdfs:domain rec:IncidenteDeRestituicao ;
  rdfs:range rec:Ativo ;
  rdfs:comment "IncidenteDeRestituicao AFETA Ativo — Consolida objeto patrimonial do incidente."@pt-BR ;
  rdfs:subPropertyOf rec:incideSobreAtivo .

rec:analisa a owl:ObjectProperty ;
  rdfs:label "ANALISA"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:ParecerJuridico rec:UnidadeDeAssessoriaJuridica ) ] ;
  rdfs:range rec:DecretoDePerdimento ;
  rdfs:comment "ParecerJuridico ANALISA DecretoDePerdimento"@pt-BR ;
  rdfs:comment "UnidadeDeAssessoriaJuridica ANALISA DecretoDePerdimento — Consolida análise jurídica do perdimento."@pt-BR ;
  skos:changeNote "AJ-254 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura ParecerJurídico (objetoDoParecer, dataDeEmissao, conclusao) emitido pela assessoria jurídica, que analisa o decreto de perdimento e em que a autoridade decisória se baseia (constricao-perdimento-e-destinacao-de-ativos-entidades.md). O ASD confirma, com lastro humano, a assessoria jurídica em perdimento e destinação como usuária que \"subsidia decisões sobre destinação\" — o parecer é esse subsídio. A classe não entrou na DKD; aqui entra como Documento."@pt-BR .

rec:analisa_UnidadeDeAssessoriaJuridica a owl:ObjectProperty ;
  rdfs:label "ANALISA (UnidadeDeAssessoriaJuridica)"@pt-BR ;
  rdfs:subPropertyOf rec:analisa ;
  rdfs:domain rec:UnidadeDeAssessoriaJuridica ;
  rdfs:range rec:DecretoDePerdimento ;
  rdfs:comment "Especialização de analisa para o par UnidadeDeAssessoriaJuridica ANALISA DecretoDePerdimento: o verbo é sobrecarregado na DKD e este par tem correspondência externa própria (02-alinhamento-relacoes.md)."@pt-BR .

rec:anexa a owl:ObjectProperty ;
  rdfs:label "ANEXA"@pt-BR ;
  rdfs:domain rec:PecaProcessual ;
  rdfs:range rec:DocumentoComprobatorio ;
  rdfs:comment "PecaProcessual ANEXA DocumentoComprobatorio"@pt-BR ;
  skos:changeNote "AJ-149 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC tramitação captura DocumentoComprobatório (certidões e documentos juntados: registro de imóveis, trânsito, societários, contratos, declarações retificadas, recibos, notas fiscais) com emissor, data de juntada, bem comprovado e alegação que sustenta; a DKD ficou só com Documento genérico."@pt-BR .

rec:anotadaEm a owl:ObjectProperty ;
  rdfs:label "ANOTADA_EM"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:MedidaDeConstricao rec:RestricaoOuOnusSobreBem ) ] ;
  rdfs:range rec:AtoRegistral ;
  rdfs:comment "MedidaDeConstricao ANOTADA_EM AtoRegistral"@pt-BR ;
  rdfs:comment "RestricaoOuOnusSobreBem ANOTADA_EM AtoRegistral"@pt-BR ;
  skos:changeNote "AJ-314 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: \"MedidaDeConstrição —ANOTADA_EM→ AverbaçãoDeIndisponibilidade\", \"AverbaçãoDeIndisponibilidade —ANOTA→ MedidaDeConstrição\" e \"MatrículaImobiliária —CONTÉM→ AverbaçãoDeIndisponibilidade\" (constricao-perdimento-e-destinacao-de-ativos-entidades.md). A averbação é um ato registral (AtoRegistral: \"ato de registro, transmissão ou averbação relacionado a bem\"), já contido pela matrícula; faltava a relação da medida com o ato que a anota. RegistroPublicoDeBem.restricaoJudicialAnotada continua como texto de recuo."@pt-BR ;
  skos:changeNote "AJ-447 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: \"MatrículaImobiliária —CONTÉM→ AverbaçãoDeÔnus\" (registro-e-titularidade-de-bens-entidades.md) e onusAverbado como campo da matrícula (constricao-perdimento-e-destinacao). O ônus não tinha ligação com a fonte registral em que foi encontrado. Mesmo verbo e destino do AJ-314 (MedidaDeConstricao ANOTADA_EM AtoRegistral): a averbação é um AtoRegistral, que a matrícula já CONTÉM — o caminho ônus → ato → matrícula → imóvel fica fechado, e a data do ato permite medir o atraso de averbação que a DKC relata como limitação da fonte."@pt-BR .

rec:aplicaSeA a owl:ObjectProperty ;
  rdfs:label "APLICA_SE_A"@pt-BR ;
  rdfs:domain rec:RequisitoFormal ;
  rdfs:range rec:DocumentoDoPedido ;
  rdfs:comment "RequisitoFormal APLICA_SE_A DocumentoDoPedido"@pt-BR ;
  skos:changeNote "AJ-445 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC pedidos: \"ExigênciaFormalDeJurisdição —APLICA_SE_A→ DocumentoInstrutório\"; marco: \"RequisitoFormal —É_VERIFICADO_EM→ FormulárioDeInstrumento\". O requisito formal recai sobre o documento que instrui o pedido — e DocumentoDoPedido já tem os atributos verificáveis correspondentes (possuiTraducao, apostilamentoOuLegalizacao, formatoDeData, citacaoDeBaseLegal), que ASD R29 pede. Faltava a relação que liga a exigência ao documento verificado."@pt-BR .

rec:aponta a owl:ObjectProperty ;
  rdfs:label "APONTA"@pt-BR ;
  rdfs:domain rec:IndicacaoDeBeneficiarioFinal ;
  rdfs:range rec:Pessoa ;
  rdfs:comment "IndicacaoDeBeneficiarioFinal APONTA Pessoa — Relação explicitamente modelada."@pt-BR .

rec:apuradoEm a owl:ObjectProperty ;
  rdfs:label "APURADO_EM"@pt-BR ;
  rdfs:domain rec:FatoCriminoso ;
  rdfs:range rec:ProcessoJudicial ;
  rdfs:comment "FatoCriminoso APURADO_EM ProcessoJudicial"@pt-BR ;
  skos:changeNote "AJ-300 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: \"FatoDelituoso —APURADO_EM→ ProcessoJudicial\" (constricao-perdimento-e-destinacao-de-ativos-entidades.md). A definição da classe (AJ-84) dizia \"vínculo com processo: [requer pesquisa adicional]\", mas a DKC já o tinha. Fecha a cadeia que ASD R67 pede como critério de sucesso — do condenado (ParticipacaoEmProcesso.papel) ao processo, ao fato e ao ativo."@pt-BR .

rec:associa a owl:ObjectProperty ;
  rdfs:label "ASSOCIA"@pt-BR ;
  rdfs:domain rec:RegistroDeIdentificacaoDeCliente ;
  rdfs:range rec:Criptoativo ;
  rdfs:comment "RegistroDeIdentificacaoDeCliente ASSOCIA Criptoativo"@pt-BR ;
  skos:changeNote "AJ-182 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC movimentação: RegistroDeIdentificaçãoDeCliente (KYC) custodiado pelo prestador, que IDENTIFICA PessoaFísica e VINCULA Criptoativo — é o único elo entre a carteira e a pessoa; ASD R45. Campos próprios: [requer pesquisa adicional]."@pt-BR .

rec:avalia a owl:ObjectProperty ;
  rdfs:label "AVALIA"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:AnaliseDeCompatibilidadeEconomica rec:AvaliacaoPatrimonial ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( rec:Pessoa rec:Ativo ) ] ;
  rdfs:comment "AnaliseDeCompatibilidadeEconomica AVALIA Pessoa"@pt-BR ;
  rdfs:comment "AvaliacaoPatrimonial AVALIA Ativo — Relação explicitamente modelada."@pt-BR ;
  skos:changeNote "AJ-225 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A análise de compatibilidade é de uma pessoa (renda × patrimônio do alvo ou do entorno — DKC: \"interposta pessoa/entorno com renda incompatível\"; ASD R38), mas a classe não se ligava a Pessoa alguma: só a ativos, declaração e extrato."@pt-BR .

rec:avaliadaPor a owl:ObjectProperty ;
  rdfs:label "AVALIADA_POR"@pt-BR ;
  rdfs:domain rec:Alegacao ;
  rdfs:range rec:AnaliseDeCompatibilidadeEconomica ;
  rdfs:comment "Alegacao AVALIADA_POR AnaliseDeCompatibilidadeEconomica"@pt-BR ;
  skos:changeNote "AJ-129 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Relação adicionada à mão na revisão da DKD apontava para AvaliacaoPatrimonial (valor do bem). A DKC diz que a alegação é avaliada pela \"compatibilidade entre renda/patrimônio declarados e aquisição\" (TesteDeCompatibilidadePatrimonial AVALIA AlegaçãoDeOrigemLícita; Receita Federal como insumo \"para avaliar incompatibilidade e boa-fé\") — isto é AnaliseDeCompatibilidadeEconomica. Sobe para o gênero Alegacao."@pt-BR .

rec:beneficia a owl:ObjectProperty ;
  rdfs:label "BENEFICIA"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:Contrato rec:Destinacao rec:RestricaoOuOnusSobreBem ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( rec:Pessoa rec:EnteDestinatario ) ] ;
  rdfs:comment "Contrato BENEFICIA Pessoa — FIBO has beneficiary"@pt-BR ;
  rdfs:comment "Destinacao BENEFICIA EnteDestinatario — Relação explicitamente modelada."@pt-BR ;
  rdfs:comment "RestricaoOuOnusSobreBem BENEFICIA Pessoa — Substitui beneficiario — referencia Pessoa, já modelada. Reaproveita BENEFICIA já usado em Destinacao->EnteDestinatario."@pt-BR ;
  rec:proveniencia "inclui par(es) adicionado(s) manualmente na revisão humana da DKD"@pt-BR .

rec:beneficia_Contrato a owl:ObjectProperty ;
  rdfs:label "BENEFICIA (Contrato)"@pt-BR ;
  rdfs:subPropertyOf rec:beneficia ;
  rdfs:domain rec:Contrato ;
  rdfs:range rec:Pessoa ;
  rdfs:comment "Especialização de beneficia para o par Contrato BENEFICIA Pessoa: o verbo é sobrecarregado na DKD e este par tem correspondência externa própria (02-alinhamento-relacoes.md)."@pt-BR .

rec:beneficia_Destinacao a owl:ObjectProperty ;
  rdfs:label "BENEFICIA (Destinacao)"@pt-BR ;
  rdfs:subPropertyOf rec:beneficia ;
  rdfs:domain rec:Destinacao ;
  rdfs:range rec:EnteDestinatario ;
  rdfs:comment "Especialização de beneficia para o par Destinacao BENEFICIA EnteDestinatario: o verbo é sobrecarregado na DKD e este par tem correspondência externa própria (02-alinhamento-relacoes.md)."@pt-BR .

rec:beneficia_RestricaoOuOnusSobreBem a owl:ObjectProperty ;
  rdfs:label "BENEFICIA (RestricaoOuOnusSobreBem)"@pt-BR ;
  rdfs:subPropertyOf rec:beneficia ;
  rdfs:domain rec:RestricaoOuOnusSobreBem ;
  rdfs:range rec:Pessoa ;
  rdfs:comment "Especialização de beneficia para o par RestricaoOuOnusSobreBem BENEFICIA Pessoa: o verbo é sobrecarregado na DKD e este par tem correspondência externa própria (02-alinhamento-relacoes.md)."@pt-BR .

rec:compostoPor a owl:ObjectProperty ;
  rdfs:label "COMPOSTO_POR"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:DossieDeBuscaPatrimonial rec:ExtratoDeMovimentacaoFinanceira ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( rec:ConsultaAFonte rec:LancamentoFinanceiro ) ] ;
  rdfs:comment "DossieDeBuscaPatrimonial COMPOSTO_POR ConsultaAFonte"@pt-BR ;
  rdfs:comment "ExtratoDeMovimentacaoFinanceira COMPOSTO_POR LancamentoFinanceiro — Relação explicitamente modelada."@pt-BR ;
  skos:changeNote "AJ-462 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: DKC: ConsultaAFonte / ConsultaAFonteDeDados / RegistroDeConsultaAFonte aparece em cinco categorias (identificação de pessoas, constrição, movimentação financeira, registro e titularidade, valoração) com os mesmos campos — base consultada, data da consulta, data de corte, chave utilizada, resultado (inclusive negativo), via de obtenção — e as relações \"ConsultaAFonte —DIRIGIDA_A→ SistemaOuBaseDeDados\", \"—REALIZADA_POR→ ÓrgãoDeBuscaPatrimonial\", \"—TEM_ALVO→ Pessoa\", \"—PRODUZ→ AsserçãoDeTitularidade / ValorEconômicoDeAtivo / DocumentoFonte\", \"—ATRIBUI→ StatusProbatório\" e \"DossiêPatrimonial —COMPOSTO_POR→ ConsultaAFonte\". A DKD descartou a classe, e com isso SistemaDeInformacao ficou sem uso analítico: nada dizia de que base, em que data e com que chave veio uma informação. É o que o ASD pede em R50 (procedência: base consultada, data da consulta), R51 (resultado como \"foto\" datada, não sobrescrita) e R52 (negativa de consulta registrada, para que ausência de resultado não seja lida como ausência de patrimônio) [R50–R52: lastro apenas sintético — requer validação humana]; a DKC marca a negativa e a data de corte como \"inexistente hoje\". O ORR já previa prov:Activity para \"a cadeia de proveniência das diligências que compõem o dossiê\"."@pt-BR .

rec:compostoPor_ExtratoDeMovimentacaoFinanceira a owl:ObjectProperty ;
  rdfs:label "COMPOSTO_POR (ExtratoDeMovimentacaoFinanceira)"@pt-BR ;
  rdfs:subPropertyOf rec:compostoPor ;
  rdfs:domain rec:ExtratoDeMovimentacaoFinanceira ;
  rdfs:range rec:LancamentoFinanceiro ;
  rdfs:comment "Especialização de compostoPor para o par ExtratoDeMovimentacaoFinanceira COMPOSTO_POR LancamentoFinanceiro: o verbo é sobrecarregado na DKD e este par tem correspondência externa própria (02-alinhamento-relacoes.md)."@pt-BR .

rec:comprova a owl:ObjectProperty ;
  rdfs:label "COMPROVA"@pt-BR ;
  rdfs:domain rec:DocumentoComprobatorio ;
  rdfs:range rec:Ativo ;
  rdfs:comment "DocumentoComprobatorio COMPROVA Ativo"@pt-BR ;
  skos:changeNote "AJ-147 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC tramitação captura DocumentoComprobatório (certidões e documentos juntados: registro de imóveis, trânsito, societários, contratos, declarações retificadas, recibos, notas fiscais) com emissor, data de juntada, bem comprovado e alegação que sustenta; a DKD ficou só com Documento genérico."@pt-BR .

rec:comprovadaPor a owl:ObjectProperty ;
  rdfs:label "COMPROVADA_POR"@pt-BR ;
  rdfs:domain rec:RelacaoReificada ;
  rdfs:range rec:Documento ;
  rdfs:comment "RelacaoReificada COMPROVADA_POR Documento"@pt-BR ;
  skos:changeNote "AJ-183 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC constrição lista \"atoSocietárioDeReferência\" na participação societária; o ato societário registrado é um dos documentos comprobatórios capturados (\"documentos societários\")."@pt-BR ;
  skos:changeNote "AJ-424 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC registra, para o vínculo, \"proveniência — documento/base de origem\" e \"EXTRAÍDO_DE DocumentoFonte\" (identificacao-de-pessoas-e-estruturas-societarias-entidades.md); AssercaoDeTitularidade e ParticipacaoSocietaria já tinham COMPROVADA_POR (RegistroPublicoDeBem / DocumentoComprobatorio), e VinculoDeParentesco \"COMPROVADO_POR RegistroDeRegistroCivil\". É conteúdo do gênero: toda afirmação reificada tem o documento que a comprova. Sobe como COMPROVADA_POR Documento (gênero documental, que cobre registro público e documento comprobatório), com o alinhamento prov:hadPrimarySource que já existia; os pares específicos e o texto proveniencia ficam herdados. ASD R50: procedência de toda informação (base, processo, peça)."@pt-BR .

rec:concedidoPor a owl:ObjectProperty ;
  rdfs:label "CONCEDIDO_POR"@pt-BR ;
  rdfs:domain rec:Exequatur ;
  rdfs:range rec:OrgaoJudicial ;
  rdfs:comment "Exequatur CONCEDIDO_POR OrgaoJudicial — Consolida órgão judicial concedente."@pt-BR .

rec:condiciona a owl:ObjectProperty ;
  rdfs:label "CONDICIONA"@pt-BR ;
  rdfs:domain rec:RequisitoDeAdmissibilidade ;
  rdfs:range rec:PedidoDeCooperacaoJuridicaInternacional ;
  rdfs:comment "RequisitoDeAdmissibilidade CONDICIONA PedidoDeCooperacaoJuridicaInternacional"@pt-BR ;
  skos:changeNote "AJ-382 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC marco normativo: \"RequisitoDeAdmissibilidade: denominação (ex.: dupla incriminação), definição (conduta deve ser crime em ambos os Estados), efeitoDoNãoAtendimento (travamento, devolução/saneamento); CONDICIONA Pedido; Instrumento DEFINE RequisitoDeAdmissibilidade\". ASD R31: dupla incriminação e demais pressupostos de admissibilidade como condição avaliável do pedido. Distinto de RequisitoFormal (tradução, apostilamento): é pressuposto de mérito. Gênero comum com RequisitoFormal fica para a revisão deste."@pt-BR .

rec:conflitaCom a owl:ObjectProperty ;
  rdfs:label "CONFLITA_COM"@pt-BR ;
  rdfs:domain rec:NomeEVarianteDeGrafia ;
  rdfs:range rec:NomeEVarianteDeGrafia ;
  rdfs:comment "NomeEVarianteDeGrafia CONFLITA_COM NomeEVarianteDeGrafia"@pt-BR ;
  skos:changeNote "AJ-283 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: \"NomeEVarianteDeGrafia —CONFLITA_COM→ NomeEVarianteDeGrafia\" — homônimos e grafias divergentes que disputam a mesma identidade. A DKD manteve o indicadorDeAmbiguidade, mas não a relação que diz com quem a grafia é ambígua. ASD B40 (divergência de grafia gera registros duplicados) e R53 (entity resolution com grau de certeza)."@pt-BR .

rec:congrega a owl:ObjectProperty ;
  rdfs:label "CONGREGA"@pt-BR ;
  rdfs:domain rec:RedeDeCooperacaoInternacional ;
  rdfs:range rec:AtorInstitucional ;
  rdfs:comment "RedeDeCooperacaoInternacional CONGREGA AtorInstitucional"@pt-BR ;
  skos:changeNote "AJ-118 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: CARIN, RRAG e ENCLA (ASD R46) congregam também órgãos de acusação, judiciais e policiais; o destino generaliza de AutoridadeCentral e UnidadeDeInteligenciaFinanceira para AtorInstitucional, um par no lugar de dois, mantendo ORG hasMember."@pt-BR .

