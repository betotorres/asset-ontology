@prefix rec: <https://www.latitude.unb.br/ontologia/recuperacao-ativos#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://www.latitude.unb.br/ontologia/recuperacao-ativos> a owl:Ontology ;
  dcterms:title "Ontologia do domínio recuperacao-ativos"@pt-BR ;
  dcterms:description "Núcleo da ontologia construída pelo processo TORRES et al. (2024): classes, propriedades e hierarquia próprias, com lastro na DKD. Os mapeamentos para ontologias externas estão no módulo de alinhamento, que importa este arquivo."@pt-BR ;
  dcterms:created "2026-10-06" ;
  dcterms:language "pt-BR" ;
  owl:versionInfo "0.2.0-oco" .

# --- Propriedades de anotação próprias
rec:proveniencia a owl:AnnotationProperty ; rdfs:label "proveniência"@pt-BR ; rdfs:comment "Origem do elemento no processo: categorias da DKC de onde foi consolidado, ou marcação de adição manual na revisão humana."@pt-BR .

# --- Classes (125, da DKD)
rec:Aeronave a owl:Class ;
  rdfs:label "Aeronave"@pt-BR ;
  rdfs:comment "Especialização de ativo para aeronaves."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, registro-e-titularidade-de-bens"@pt-BR ;
  rdfs:subClassOf rec:BemMovel .

rec:Agente a owl:Class ;
  rdfs:label "Agente"@pt-BR ;
  rdfs:comment "Pessoa, órgão, organização ou unidade que atua no domínio da recuperação de ativos, participando de titularidades, vínculos, processos, pedidos ou do fluxo de produção, custódia, decisão ou consumo de informação."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-12 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-12 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): AtorInstitucional é tipado como prov:Agent e Pessoa está alinhada a PROV-O Agent e FOAF Agent. InstituicaoFinanceira já herda de ambas, o que mostra que pertencem a uma mesma categoria de agente."@pt-BR .

rec:Alegacao a owl:Class ;
  rdfs:label "Alegacao"@pt-BR ;
  rdfs:comment "Alegação deduzida por pessoa no processo e sujeita a avaliação e julgamento — por exemplo, boa-fé de terceiro sobre o ativo ou origem lícita do patrimônio."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-120 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-120 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC capturou duas alegações com a mesma estrutura — AlegaçãoDeTerceiroDeBoaFé (constrição, carteira, tramitação) e AlegaçãoDeOrigemLícita (movimentação financeira: \"patrimônio anterior ao período da conduta\", documentos de lastro, rastro bancário) — e só a primeira virou classe na DKD. O gênero comum (FIBO claim) recebe o que é das duas: teor, quem deduz, avaliação pela análise de compatibilidade, ativo a que se refere, documentos que a sustentam e peça que a veicula."@pt-BR .

rec:AlegacaoDeOrigemLicita a owl:Class ;
  rdfs:label "AlegacaoDeOrigemLicita"@pt-BR ;
  rdfs:comment "Alegação de que o patrimônio tem origem lícita ou é anterior ao período da conduta ilícita, sustentada por documentos de lastro (recibos, notas fiscais) e pela existência de rastro bancário correspondente."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-122 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:Alegacao ;
  skos:changeNote "AJ-122 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC capturou duas alegações com a mesma estrutura — AlegaçãoDeTerceiroDeBoaFé (constrição, carteira, tramitação) e AlegaçãoDeOrigemLícita (movimentação financeira: \"patrimônio anterior ao período da conduta\", documentos de lastro, rastro bancário) — e só a primeira virou classe na DKD. O gênero comum (FIBO claim) recebe o que é das duas: teor, quem deduz, avaliação pela análise de compatibilidade, ativo a que se refere, documentos que a sustentam e peça que a veicula."@pt-BR .

rec:AlegacaoDeTerceiroDeBoaFe a owl:Class ;
  rdfs:label "AlegacaoDeTerceiroDeBoaFe"@pt-BR ;
  rdfs:comment "Alegação de terceiro que sustenta boa-fé em relação ao ativo ou à medida."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, tramitacao-processual-e-decisoes-sobre-bens"@pt-BR ;
  rdfs:subClassOf rec:Alegacao ;
  skos:changeNote "AJ-121 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC capturou duas alegações com a mesma estrutura — AlegaçãoDeTerceiroDeBoaFé (constrição, carteira, tramitação) e AlegaçãoDeOrigemLícita (movimentação financeira: \"patrimônio anterior ao período da conduta\", documentos de lastro, rastro bancário) — e só a primeira virou classe na DKD. O gênero comum (FIBO claim) recebe o que é das duas: teor, quem deduz, avaliação pela análise de compatibilidade, ativo a que se refere, documentos que a sustentam e peça que a veicula."@pt-BR ;
  skos:changeNote "AJ-126 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Alegação é deduzida, não requerida; o verbo REQUERIDA_POR servia também a MedidaDeConstricao com outro sentido. A DKC usa DEDUZIDO_POR / APRESENTADA_POR. Sobe para o gênero Alegacao."@pt-BR ;
  skos:changeNote "AJ-128 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Relação adicionada à mão na revisão da DKD apontava para AvaliacaoPatrimonial (valor do bem). A DKC diz que a alegação é avaliada pela \"compatibilidade entre renda/patrimônio declarados e aquisição\" (TesteDeCompatibilidadePatrimonial AVALIA AlegaçãoDeOrigemLícita; Receita Federal como insumo \"para avaliar incompatibilidade e boa-fé\") — isto é AnaliseDeCompatibilidadeEconomica. Sobe para o gênero Alegacao."@pt-BR ;
  skos:changeNote "AJ-130 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Sobe de AlegacaoDeTerceiroDeBoaFe para o gênero Alegacao: a alegação de origem lícita também se refere a ativos. Mesmo alinhamento; continua na superpropriedade incideSobreAtivo."@pt-BR .

rec:AlienacaoAntecipada a owl:Class ;
  rdfs:label "AlienacaoAntecipada"@pt-BR ;
  rdfs:comment "Alienação do ativo antes da conclusão definitiva do fluxo ordinário."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:MedidaJudicialSobreAtivo ;
  skos:changeNote "AJ-187 (2026-10-05, fonte: norma): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Norma: CPP art. 144-A (alienação antecipada \"para preservação do valor dos bens\", por deterioração, depreciação ou dificuldade de manutenção — a própria motivacao da DKD), no capítulo VI, \"Das Medidas Assecuratórias\". Estrutura idêntica à das demais medidas: decisão judicial, fundamento legal, ativo."@pt-BR ;
  skos:changeNote "AJ-348 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero (AJ-184) é \"efeito jurídico … que recai sobre um ativo\", e as três filhas diziam isso cada uma por si: AlienacaoAntecipada INCIDE_SOBRE Ativo, DecretoDePerdimento RECAI_SOBRE Ativo, MedidaDeConstricao RECAI_SOBRE Ativo (DKC constricao: RECAI_SOBRE / INCIDE_SOBRE). Sobe para o gênero com o mesmo alinhamento (FIBO involves) e as três ficam herdadas; RECAI_SOBRE continua membro da superpropriedade incideSobreAtivo."@pt-BR ;
  skos:changeNote "AJ-352 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero diz \"fundamentado em fundamento legal\", e as três filhas tinham FUNDAMENTA_SE_EM FundamentoLegal cada uma com sua especialização para FIBO is predicated on (DKC: MedidaDeConstrição —FUNDAMENTA_SE_EM→ FundamentoLegal; fundamentoLegal em DecretoDePerdimento e AlienaçãoAntecipada). Sobe para o gênero com o mesmo alinhamento. ASD R16: perdimento sempre vinculado ao marco normativo específico."@pt-BR ;
  skos:changeNote "AJ-359 (2026-10-06, fonte: norma): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero diz \"determinado por decisão judicial\", mas isso estava expresso por seis pares e três verbos: DecisaoJudicial DETERMINA MedidaDeConstricao / DETERMINA DecretoDePerdimento / AUTORIZA AlienacaoAntecipada e as inversas MedidaDeConstricao DETERMINADA_POR, DecretoDePerdimento DECORRE_DE e AlienacaoAntecipada AUTORIZADA_POR. Vira um par no gênero, no sentido da decisão (voz ativa, FIBO mandates, mesmo verbo já usado para Destinacao e ViaProcessual). Norma: CPP art. 144-A, \"o juiz determinará a alienação antecipada\" — determina, não só autoriza; CPP arts. 125–137, medidas por ordem do juiz; CP art. 91, perdimento como efeito da condenação. As inversas saem por duplicarem a mesma informação no outro sentido, como já feito para RESULTA_DE/HABILITA e SUBSIDIA/EXIGE."@pt-BR ;
  skos:changeNote "AJ-504 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: AlienacaoAntecipada.valorApurado (\"[requer pesquisa adicional]\", decimal solto) vira a relação que a DKC já registra: \"AlienaçãoJudicialOuLeilão —GERA→ ValorEconômicoDeAtivo\" (valoração), com tipoDeValor \"de alienação\" (AJ-480). Mesmo verbo de Repatriacao e AvaliacaoPatrimonial PRODUZ ValorEconomicoDeAtivo. CPP art. 144-A: o produto da alienação é depositado em conta vinculada ao juízo — é o valor que substitui o bem."@pt-BR .

rec:AlienacaoFiduciaria a owl:Class ;
  rdfs:label "AlienacaoFiduciaria"@pt-BR ;
  rdfs:comment "Alienação fiduciária em garantia registrada sobre o bem: propriedade resolúvel do credor fiduciário (BENEFICIA Pessoa) até a quitação da dívida garantida, com data do registro."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-309 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:RestricaoOuOnusSobreBem ;
  skos:changeNote "AJ-309 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: \"AverbaçãoDeÔnus —SUBCLASSE_DE→ RestriçãoOuÔnusSobreBem\" (tipoDeÔnus, beneficiárioDoÔnus, dataDaAverbação) e \"AlienaçãoFiduciária —SUBCLASSE_DE→ RestriçãoOuÔnusSobreBem\" (credorFiduciário, dataDoRegistro) (registro-e-titularidade-de-bens-entidades.md); a DKD manteve só o gênero. ASD B21: oneração proposital do bem (alienação fiduciária, hipoteca, ônus averbado) para diluir a aparência de valor disponível. O beneficiário e o credor fiduciário são o BENEFICIA Pessoa herdado."@pt-BR .

rec:AnaliseDeCompatibilidadeEconomica a owl:Class ;
  rdfs:label "AnaliseDeCompatibilidadeEconomica"@pt-BR ;
  rdfs:comment "Avaliação da compatibilidade entre renda, patrimônio, movimentação e lastro alegado."@pt-BR ;
  rec:proveniencia "DKC: movimentacao-financeira-e-capacidade-economica, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:Avaliacao ;
  skos:changeNote "AJ-18 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): As duas definições têm o mesmo gênero, 'Avaliação que…', e ambas são tipadas como prov:Activity relacionadas a Ativo (AVALIA, IDENTIFICA)."@pt-BR ;
  skos:changeNote "AJ-222 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC qualifica o teste de compatibilidade por status probatório, e \"conclusão pericial\" é um dos valores de StatusProbatorio — a avaliação patrimonial (laudo versus estimativa, \"sujeita a contestação\") também precisa dessa qualificação. Sobe de AnaliseDeCompatibilidadeEconomica para o gênero."@pt-BR .

rec:AreaDeExecucaoOperacional a owl:Class ;
  rdfs:label "AreaDeExecucaoOperacional"@pt-BR ;
  rdfs:comment "Área responsável por materializar a destinação decidida para o ativo."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos"@pt-BR ;
  rdfs:subClassOf rec:UnidadeOrganizacional ;
  skos:changeNote "AJ-53 (2026-10-05, fonte: ontologia_externa): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: As unidades internas repetem o mesmo atributo único (atribuicao) e têm o mesmo par mantido no ORR (ORG OrganizationalUnit: \"unidade interna de organização maior\"). Mesmo padrão que justificou BemMovel na DKD."@pt-BR ;
  skos:changeNote "AJ-56 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A classe passa a ser AtorInstitucional por meio de UnidadeOrganizacional; a aresta direta ficou redundante."@pt-BR ;
  skos:changeNote "AJ-59 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: O atributo atribuicao, repetido nas subclasses de UnidadeOrganizacional, passa a ser declarado uma vez na superclasse."@pt-BR .

rec:ArrestoDeBens a owl:Class ;
  rdfs:label "ArrestoDeBens"@pt-BR ;
  rdfs:comment "Medida assecuratória que recai sobre imóvel, até a inscrição da hipoteca legal, ou sobre bens móveis suscetíveis de penhora, quando o responsável não tem imóveis suficientes."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-68 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:MedidaDeConstricao ;
  skos:changeNote "AJ-68 (2026-10-05, fonte: norma): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ASD R15 pede medida assecuratória como gênero com espécies e R9 (lastro humano) pede a desambiguação do sentido patrimonial; a DKD só registra as espécies como texto de tipoDeMedida. Norma: CPP, arts. 136 e 137."@pt-BR .

rec:AssercaoDeTitularidade a owl:Class ;
  rdfs:label "AssercaoDeTitularidade"@pt-BR ;
  rdfs:comment "Afirmação reificada de titularidade de pessoa sobre ativo."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, registro-e-titularidade-de-bens"@pt-BR ;
  rdfs:subClassOf rec:RelacaoReificada ;
  skos:changeNote "AJ-36 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): AssercaoDeTitularidade é 'afirmação reificada de titularidade' e VinculoEntrePessoas é 'relação reificada entre pessoas'. Ambas usam relações de ligação (LIGA; TEM_ORIGEM/TEM_DESTINO), e as alinhadas a FTM Ownership ficam reunidas."@pt-BR ;
  skos:changeNote "AJ-425 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC registra, para o vínculo, \"proveniência — documento/base de origem\" e \"EXTRAÍDO_DE DocumentoFonte\" (identificacao-de-pessoas-e-estruturas-societarias-entidades.md); AssercaoDeTitularidade e ParticipacaoSocietaria já tinham COMPROVADA_POR (RegistroPublicoDeBem / DocumentoComprobatorio), e VinculoDeParentesco \"COMPROVADO_POR RegistroDeRegistroCivil\". É conteúdo do gênero: toda afirmação reificada tem o documento que a comprova. Sobe como COMPROVADA_POR Documento (gênero documental, que cobre registro público e documento comprobatório), com o alinhamento prov:hadPrimarySource que já existia; os pares específicos e o texto proveniencia ficam herdados. ASD R50: procedência de toda informação (base, processo, peça)."@pt-BR ;
  skos:changeNote "AJ-502 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: valorDeclarado era um decimal solto, sem moeda nem data, em AtoRegistral, EscrituraPublica e AssercaoDeTitularidade — justamente o valor que as fontes reconhecem como não confiável e que precisa ser comparado com o venal e o de avaliação (ASD B41; DKC valoração: \"AtoNotarial —DECLARA→ ValorDeclaradoEmTransmissão\", com \"montante; ato de origem; partes; data\"). Passa a TEM_VALOR ValorEconomicoDeAtivo (tipoDeValor \"declarado\"), no gênero AtoNotarialOuRegistral para o ato e em AssercaoDeTitularidade para a titularidade conhecida sem o ato — mesmo tratamento de Contrato, Divida, LancamentoFinanceiro e SubRogacaoDeAtivo."@pt-BR .

rec:Ativo a owl:Class ;
  rdfs:label "Ativo"@pt-BR ;
  rdfs:comment "Bem ou ativo patrimonial sujeito a identificação, titularidade, valoração, constrição, perdimento ou destinação."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, marco-normativo-e-instrumentos-juridicos-aplicaveis, pedidos-de-cooperacao-entre-jurisdicoes, registro-e-titularidade-de-bens, tramitacao-processual-e-decisoes-sobre-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  skos:changeNote "AJ-157 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Resposta humana do ASD (B6) lista \"ativo ↔ jurisdição estrangeira\" entre os vínculos mais relevantes; a DKC captura \"jurisdição/país da conta\". Vira relação com a classe Jurisdição, como já feito para AtorInstitucional; o texto livre jurisdicaoOuLocalizacao sai (a localização física do imóvel já é TEM_ENDERECO)."@pt-BR ;
  skos:changeNote "AJ-158 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: POSSUI é verbo vago e usado com outro sentido em PedidoDeCooperacao POSSUI Correspondencia; o par Ativo→AvaliacaoPatrimonial, alinhado a FIBO \"is evaluated by\", passa a se chamar AVALIADO_POR."@pt-BR ;
  skos:changeNote "AJ-487 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: Ativo AVALIADO_POR AvaliacaoPatrimonial e AvaliacaoPatrimonial AVALIA Ativo são a mesma relação nos dois sentidos. Fica o sentido da atividade (DKC constrição: \"AvaliaçãoPatrimonial —AVALIA→ Ativo\"; FIBO evaluates), como em RESULTA_DE/HABILITA, SUBSIDIA/EXIGE e REQUER/REQUERIDA_POR."@pt-BR ;
  skos:changeNote "AJ-489 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: Ativo SOB_GESTÃO_DE OrgaoDeGestaoPatrimonial e OrgaoDeGestaoPatrimonial ADMINISTRA Ativo são a mesma relação nos dois sentidos. Fica a voz ativa (FIBO holds)."@pt-BR .

rec:AtivoDePropriedadeIntelectual a owl:Class ;
  rdfs:label "AtivoDePropriedadeIntelectual"@pt-BR ;
  rdfs:comment "Especialização de ativo para direitos de propriedade intelectual."@pt-BR ;
  rec:proveniencia "DKC: registro-e-titularidade-de-bens"@pt-BR ;
  rdfs:subClassOf rec:Ativo .

rec:AtivoFinanceiro a owl:Class ;
  rdfs:label "AtivoFinanceiro"@pt-BR ;
  rdfs:comment "Especialização de ativo para recursos ou instrumentos financeiros."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos"@pt-BR ;
  rdfs:subClassOf rec:Ativo .

rec:AtoNotarial a owl:Class ;
  rdfs:label "AtoNotarial"@pt-BR ;
  rdfs:comment "Ato notarial relacionado a pessoas, representação, titularidade ou transmissão de bens."@pt-BR ;
  rec:proveniencia "DKC: identificacao-de-pessoas-e-estruturas-societarias, registro-e-titularidade-de-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:AtoNotarialOuRegistral ;
  skos:changeNote "AJ-46 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Substitui AtoJuridico (AJ-9 a AJ-11 e AJ-27, desfeitos): mesma evidência do AJ-9 (dataDoAto, TEM_PARTE → Pessoa e AtoRegistral INSTRUMENTALIZADO_POR AtoNotarial), com nome restrito. \"Ato jurídico\" no direito civil abrange também contrato e decisão judicial, que ficam fora: o contrato é o negócio e estes atos são o instrumento que o formaliza. A Lei 8.935/1994 trata serviços notariais e de registro em conjunto."@pt-BR ;
  skos:changeNote "AJ-197 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: dataDoAto e TEM_PARTE → Pessoa existiam, idênticos, em AtoNotarial e AtoRegistral — foi essa repetição que justificou criar o gênero (AJ-45); sobem para AtoNotarialOuRegistral com o mesmo alinhamento."@pt-BR ;
  skos:changeNote "AJ-200 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: dataDoAto e TEM_PARTE → Pessoa existiam, idênticos, em AtoNotarial e AtoRegistral — foi essa repetição que justificou criar o gênero (AJ-45); sobem para AtoNotarialOuRegistral com o mesmo alinhamento."@pt-BR ;
  skos:changeNote "AJ-203 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: tipoDeAto (AtoNotarial: escritura, procuração) e naturezaDoAto (AtoRegistral: transmissão, registro, averbação) são o mesmo dado com dois nomes; a DKC usa \"naturezaDoAto\" nas duas fichas. Unificado no gênero, com a regra de Ativo.tipoDeAtivo: usar só quando não houver subclasse específica."@pt-BR ;
  skos:changeNote "AJ-206 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Se a consulta devolve o teor ou só a existência do ato é propriedade da fonte consultada (CENSEC), não do ato — já coberta por SistemaDeInformacao.camposEstruturadosDisponiveis e grauDeEstruturacao."@pt-BR .

rec:AtoNotarialOuRegistral a owl:Class ;
  rdfs:label "AtoNotarialOuRegistral"@pt-BR ;
  rdfs:comment "Ato notarial ou de registro que formaliza ou dá publicidade a ato ou negócio jurídico relativo a pessoas, representação, titularidade ou transmissão de bens."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-45 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-45 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Substitui AtoJuridico (AJ-9 a AJ-11 e AJ-27, desfeitos): mesma evidência do AJ-9 (dataDoAto, TEM_PARTE → Pessoa e AtoRegistral INSTRUMENTALIZADO_POR AtoNotarial), com nome restrito. \"Ato jurídico\" no direito civil abrange também contrato e decisão judicial, que ficam fora: o contrato é o negócio e estes atos são o instrumento que o formaliza. A Lei 8.935/1994 trata serviços notariais e de registro em conjunto."@pt-BR .

rec:AtoRegistral a owl:Class ;
  rdfs:label "AtoRegistral"@pt-BR ;
  rdfs:comment "Ato de registro, transmissão ou averbação relacionado a bem."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, registro-e-titularidade-de-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:AtoNotarialOuRegistral ;
  skos:changeNote "AJ-47 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Substitui AtoJuridico (AJ-9 a AJ-11 e AJ-27, desfeitos): mesma evidência do AJ-9 (dataDoAto, TEM_PARTE → Pessoa e AtoRegistral INSTRUMENTALIZADO_POR AtoNotarial), com nome restrito. \"Ato jurídico\" no direito civil abrange também contrato e decisão judicial, que ficam fora: o contrato é o negócio e estes atos são o instrumento que o formaliza. A Lei 8.935/1994 trata serviços notariais e de registro em conjunto."@pt-BR ;
  skos:changeNote "AJ-198 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: dataDoAto e TEM_PARTE → Pessoa existiam, idênticos, em AtoNotarial e AtoRegistral — foi essa repetição que justificou criar o gênero (AJ-45); sobem para AtoNotarialOuRegistral com o mesmo alinhamento."@pt-BR ;
  skos:changeNote "AJ-201 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: dataDoAto e TEM_PARTE → Pessoa existiam, idênticos, em AtoNotarial e AtoRegistral — foi essa repetição que justificou criar o gênero (AJ-45); sobem para AtoNotarialOuRegistral com o mesmo alinhamento."@pt-BR ;
  skos:changeNote "AJ-204 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: tipoDeAto (AtoNotarial: escritura, procuração) e naturezaDoAto (AtoRegistral: transmissão, registro, averbação) são o mesmo dado com dois nomes; a DKC usa \"naturezaDoAto\" nas duas fichas. Unificado no gênero, com a regra de Ativo.tipoDeAtivo: usar só quando não houver subclasse específica."@pt-BR ;
  skos:changeNote "AJ-500 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: valorDeclarado era um decimal solto, sem moeda nem data, em AtoRegistral, EscrituraPublica e AssercaoDeTitularidade — justamente o valor que as fontes reconhecem como não confiável e que precisa ser comparado com o venal e o de avaliação (ASD B41; DKC valoração: \"AtoNotarial —DECLARA→ ValorDeclaradoEmTransmissão\", com \"montante; ato de origem; partes; data\"). Passa a TEM_VALOR ValorEconomicoDeAtivo (tipoDeValor \"declarado\"), no gênero AtoNotarialOuRegistral para o ato e em AssercaoDeTitularidade para a titularidade conhecida sem o ato — mesmo tratamento de Contrato, Divida, LancamentoFinanceiro e SubRogacaoDeAtivo."@pt-BR .

rec:AtorInstitucional a owl:Class ;
  rdfs:label "AtorInstitucional"@pt-BR ;
  rdfs:comment "Órgão, organização ou unidade que atua na produção, custódia, decisão ou consumo de informação."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, identificacao-de-pessoas-e-estruturas-societarias, tramitacao-processual-e-decisoes-sobre-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:Agente ;
  skos:changeNote "AJ-14 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): AtorInstitucional é tipado como prov:Agent e Pessoa está alinhada a PROV-O Agent e FOAF Agent. InstituicaoFinanceira já herda de ambas, o que mostra que pertencem a uma mesma categoria de agente."@pt-BR ;
  skos:changeNote "AJ-94 (2026-10-05, fonte: modelagem): Não entendi para que serve"@pt-BR ;
  skos:changeNote "AJ-105 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Recriado só para documentar: o atributo compete com a taxonomia de subclasses e passa a valer apenas quando não houver subclasse específica — mesma regra dada a Ativo.tipoDeAtivo na DKD."@pt-BR ;
  skos:changeNote "AJ-115 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Todo órgão pertence a uma jurisdição: a relação sobe de AutoridadeCentral e OrgaoJudicial para AtorInstitucional (mesmo alinhamento FIBO), e o atributo de texto jurisdicao fica redundante."@pt-BR .

rec:AutoridadeCentral a owl:Class ;
  rdfs:label "AutoridadeCentral"@pt-BR ;
  rdfs:comment "Autoridade central nacional ou estrangeira responsável pela tramitação ou intermediação da cooperação."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, marco-normativo-e-instrumentos-juridicos-aplicaveis, movimentacao-financeira-e-capacidade-economica, pedidos-de-cooperacao-entre-jurisdicoes, registro-e-titularidade-de-bens, tramitacao-processual-e-decisoes-sobre-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:AtorInstitucional ;
  skos:changeNote "AJ-1 (2026-10-05, fonte: modelagem): sugestão da IA (claude-sonnet-5 (anthropic)): Definição e atributos (tipoDeInstituicao, papelNoPedido) descrevem um órgão que atua na tramitação da cooperação, mesmo papel genérico de AtorInstitucional já usado para TabelionatoDeNotas e unidades afins."@pt-BR ;
  skos:changeNote "AJ-95 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Duplica AtorInstitucional.tipoDeAtor, herdado desde que a classe passou a ser subclasse de AtorInstitucional."@pt-BR ;
  skos:changeNote "AJ-102 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Requerente/requerida/intermediadora é papel por pedido — a mesma autoridade é requerente num pedido e requerida noutro —, então não pode ser atributo da autoridade. ASD R24 pede os papéis de autoridade requisitante e requerida como papéis distintos; viram duas relações do pedido para a autoridade central."@pt-BR ;
  skos:changeNote "AJ-113 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Todo órgão pertence a uma jurisdição: a relação sobe de AutoridadeCentral e OrgaoJudicial para AtorInstitucional (mesmo alinhamento FIBO), e o atributo de texto jurisdicao fica redundante."@pt-BR ;
  skos:changeNote "AJ-490 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: AutoridadeCentral TRAMITA PedidoDeCooperacaoJuridicaInternacional repete, sem o papel, o que TEM_AUTORIDADE_REQUERENTE e TEM_AUTORIDADE_REQUERIDA dizem com ele: toda autoridade central que tramita um pedido o faz como requerente ou como requerida. Para ASD R56 (tempo de resposta por país) o papel é indispensável; a relação sem papel só permite a consulta errada."@pt-BR .

rec:AutoridadeDecisoriaSobreDestinacao a owl:Class ;
  rdfs:label "AutoridadeDecisoriaSobreDestinacao"@pt-BR ;
  rdfs:comment "Instância administrativa ou colegiada responsável por decidir destinação de ativos."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho"@pt-BR ;
  rdfs:subClassOf rec:AtorInstitucional .

rec:Avaliacao a owl:Class ;
  rdfs:label "Avaliacao"@pt-BR ;
  rdfs:comment "Atividade que examina ativos, patrimônio ou movimentação financeira para atribuir valor ou verificar compatibilidade, produzindo um resultado que subsidia o fluxo de recuperação de ativos."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-16 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-16 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): As duas definições têm o mesmo gênero, 'Avaliação que…', e ambas são tipadas como prov:Activity relacionadas a Ativo (AVALIA, IDENTIFICA)."@pt-BR .

rec:AvaliacaoPatrimonial a owl:Class ;
  rdfs:label "AvaliacaoPatrimonial"@pt-BR ;
  rdfs:comment "Avaliação que atribui valor a ativo em determinada data, moeda, tipo e fonte."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:Avaliacao ;
  skos:changeNote "AJ-17 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): As duas definições têm o mesmo gênero, 'Avaliação que…', e ambas são tipadas como prov:Activity relacionadas a Ativo (AVALIA, IDENTIFICA)."@pt-BR ;
  skos:changeNote "AJ-227 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: O valor do atributo (\"controle de reavaliação inexistente nas fontes atuais\") descreve uma lacuna da fonte, não um dado da avaliação; a desatualização se obtém de ValorEconomicoDeAtivo.dataDeReferencia."@pt-BR ;
  skos:changeNote "AJ-244 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: AvaliacaoPatrimonial SUBSIDIA Destinacao é a inversa de Destinacao EXIGE AvaliacaoPatrimonial, que tem lastro mais forte: relação literal da DKC, atributo DKC dependeDeAvaliacaoPrevia e alinhamentos FIBO is predicated on + prov:used. Fica uma só."@pt-BR ;
  skos:changeNote "AJ-245 (2026-10-06, fonte: norma): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A alienação antecipada depende da avaliação por força de lei: CPP art. 144-A, § 2º — \"os bens deverão ser vendidos pelo valor fixado na avaliação judicial\". SUBSIDIA (manual, closeMatch prov:used) dizia o mesmo do lado da avaliação; passa ao verbo EXIGE já usado por Destinacao, com os mesmos alinhamentos, e SUBSIDIA deixa de existir."@pt-BR .

rec:AverbacaoDeOnus a owl:Class ;
  rdfs:label "AverbacaoDeOnus"@pt-BR ;
  rdfs:comment "Ônus real averbado na matrícula ou no registro do bem — hipoteca convencional, penhor, usufruto, servidão e afins —, com tipo, data da averbação e beneficiário (BENEFICIA Pessoa). Atraso de averbação é limitação de qualidade da fonte, não atributo do ônus."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-306 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:RestricaoOuOnusSobreBem ;
  skos:changeNote "AJ-306 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: \"AverbaçãoDeÔnus —SUBCLASSE_DE→ RestriçãoOuÔnusSobreBem\" (tipoDeÔnus, beneficiárioDoÔnus, dataDaAverbação) e \"AlienaçãoFiduciária —SUBCLASSE_DE→ RestriçãoOuÔnusSobreBem\" (credorFiduciário, dataDoRegistro) (registro-e-titularidade-de-bens-entidades.md); a DKD manteve só o gênero. ASD B21: oneração proposital do bem (alienação fiduciária, hipoteca, ônus averbado) para diluir a aparência de valor disponível. O beneficiário e o credor fiduciário são o BENEFICIA Pessoa herdado."@pt-BR .

rec:BaseDeCooperacaoPorReciprocidade a owl:Class ;
  rdfs:label "BaseDeCooperacaoPorReciprocidade"@pt-BR ;
  rdfs:comment "Base de cooperação por promessa de reciprocidade, usada na ausência de tratado e tramitada pela via diplomática, com ou sem nota verbal. Forma de formalização e jurisdições que operam sob o regime: [requer pesquisa adicional]."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-295 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:InstrumentoJuridicoDeCooperacao ;
  skos:changeNote "AJ-295 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: \"InstrumentoJurídicoDeCooperação —ESPECIALIZA_SE_EM→ ConvençãoMultilateral / TratadoBilateralDeAssistênciaJurídicaMútua / BaseDeCooperaçãoPorReciprocidade\", cada uma com atributos próprios (marco-normativo-e-instrumentos-juridicos-aplicaveis-entidades.md). ASD R46 nomeia UNCAC, Palermo, OEA e MLATs; R25 põe o instrumento como determinante da via. O atributo tipoDeInstrumento passa a valer só quando não houver subclasse específica — mesma regra de Ativo.tipoDeAtivo e AtorInstitucional.tipoDeAtor."@pt-BR .

rec:BemDeAltoValorAgregado a owl:Class ;
  rdfs:label "BemDeAltoValorAgregado"@pt-BR ;
  rdfs:comment "Bem de alto valor agregado usado como reserva de valor, como joias e obras de arte. Atributos próprios: [requer pesquisa adicional]."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-83 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:Ativo ;
  skos:changeNote "AJ-83 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ASD R1 e R36 (lastro humano: \"bens de alto valor agregado\", joias e obras de arte no escopo). Não cabem em BemMovel, definido na DKD como bem \"registrável\". Sem metadado de sistema: atributos [requer pesquisa adicional]."@pt-BR .

rec:BemImovel a owl:Class ;
  rdfs:label "BemImovel"@pt-BR ;
  rdfs:comment "Especialização de ativo para bens imóveis e seus elementos cadastrais e registrais."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, registro-e-titularidade-de-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:Ativo ;
  skos:changeNote "AJ-476 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: BemImovel.valorCadastral (decimal solto, sem moeda nem data) duplica Ativo TEM_VALOR ValorEconomicoDeAtivo com tipoDeValor \"venal ou cadastral\" — e não permite o histórico que ASD R12 pede. Mesmo tratamento já dado a valorEstimado (pedido), valorBloqueado (resposta), valorAssociado (medida) e valorRepatriado."@pt-BR ;
  skos:changeNote "AJ-488 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: BemImovel DESCRITO_EM MatriculaImobiliaria e MatriculaImobiliaria DESCREVE BemImovel são a mesma relação nos dois sentidos — e Ativo REGISTRADO_EM RegistroPublicoDeBem, herdada, já dá o sentido bem → registro. Fica o sentido do documento, igual a DossieDeBuscaPatrimonial DESCREVE Ativo."@pt-BR .

rec:BemMovel a owl:Class ;
  rdfs:label "BemMovel"@pt-BR ;
  rdfs:comment "Bem físico móvel e registrável (em contraste com BemImovel) — categoria consolidada na revisão a partir da recorrência do mesmo padrão em Veículo, Aeronave e Embarcação: todos têm registro público e histórico de transferência de titularidade. Distinção de bens móveis/imóveis é conhecimento jurídico comum (Código Civil), usada aqui para evitar repetir a mesma relação em cada subclasse."@pt-BR ;
  rec:proveniencia "adicionado manualmente na revisão humana da DKD"@pt-BR ;
  rdfs:subClassOf rec:Ativo ;
  skos:changeNote "AJ-173 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Relação adicionada à mão na revisão da DKD. A titularidade anterior já é modelada por AssercaoDeTitularidade (TITULAR_ANTERIOR, dataDaTransmissao, LIGA Ativo); o atalho sem data cria dois lugares para o mesmo dado na DSMI."@pt-BR .

rec:BloqueioDeAtivos a owl:Class ;
  rdfs:label "BloqueioDeAtivos"@pt-BR ;
  rdfs:comment "Proibição temporária de transferir, converter, dispor ou movimentar bens, ou sua custódia ou controle temporário, por decisão de tribunal ou de outra autoridade competente."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-69 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:MedidaDeConstricao ;
  skos:changeNote "AJ-69 (2026-10-05, fonte: norma): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ASD R15 pede medida assecuratória como gênero com espécies e R9 (lastro humano) pede a desambiguação do sentido patrimonial; a DKD só registra as espécies como texto de tipoDeMedida. Norma: Convenção de Palermo, art. 2, alínea \"f\" (Decreto 5.015/2004)."@pt-BR .

rec:CodigoPostal a owl:Class ;
  rdfs:label "CodigoPostal"@pt-BR ;
  rdfs:comment "[adicionado na revisão humana, sem lastro em DKC] Código postal associado a um endereço. Nenhuma categoria da DKC do domínio recuperacao-ativos capturou código postal, CEP, ZIP ou UF — a classe existe por decisão do revisor, não por evidência de captura. Estrutura livre por país (CEP no Brasil, ZIP nos EUA, postcode no Reino Unido etc.), portanto sem formato fixo."@pt-BR ;
  rec:proveniencia "adicionado manualmente na revisão humana da DKD"@pt-BR .

rec:ConsultaAFonte a owl:Class ;
  rdfs:label "ConsultaAFonte"@pt-BR ;
  rdfs:comment "Diligência de consulta a um sistema, base ou fonte de dados, registrada com data da consulta, data de corte do resultado, chave utilizada, via de obtenção e resultado — inclusive o negativo —, de modo que cada informação entregue tenha procedência e que a ausência de resultado fique registrada como tal."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-449 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-449 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: DKC: ConsultaAFonte / ConsultaAFonteDeDados / RegistroDeConsultaAFonte aparece em cinco categorias (identificação de pessoas, constrição, movimentação financeira, registro e titularidade, valoração) com os mesmos campos — base consultada, data da consulta, data de corte, chave utilizada, resultado (inclusive negativo), via de obtenção — e as relações \"ConsultaAFonte —DIRIGIDA_A→ SistemaOuBaseDeDados\", \"—REALIZADA_POR→ ÓrgãoDeBuscaPatrimonial\", \"—TEM_ALVO→ Pessoa\", \"—PRODUZ→ AsserçãoDeTitularidade / ValorEconômicoDeAtivo / DocumentoFonte\", \"—ATRIBUI→ StatusProbatório\" e \"DossiêPatrimonial —COMPOSTO_POR→ ConsultaAFonte\". A DKD descartou a classe, e com isso SistemaDeInformacao ficou sem uso analítico: nada dizia de que base, em que data e com que chave veio uma informação. É o que o ASD pede em R50 (procedência: base consultada, data da consulta), R51 (resultado como \"foto\" datada, não sobrescrita) e R52 (negativa de consulta registrada, para que ausência de resultado não seja lida como ausência de patrimônio) [R50–R52: lastro apenas sintético — requer validação humana]; a DKC marca a negativa e a data de corte como \"inexistente hoje\". O ORR já previa prov:Activity para \"a cadeia de proveniência das diligências que compõem o dossiê\"."@pt-BR .

rec:ContaBancaria a owl:Class ;
  rdfs:label "ContaBancaria"@pt-BR ;
  rdfs:comment "Conta financeira associada a titular e instituição custodiante."@pt-BR ;
  rec:proveniencia "DKC: movimentacao-financeira-e-capacidade-economica"@pt-BR ;
  rdfs:subClassOf rec:AtivoFinanceiro .

rec:Contrato a owl:Class ;
  rdfs:label "Contrato"@pt-BR ;
  rdfs:comment "[adicionado no EOA — iteração à DKD a partir de lacuna externa mantida no ORR] Acordo voluntário e juridicamente vinculante entre partes competentes, com contraprestação, objeto, datas e jurisdição aplicável; contratos simulados são veículo típico de ocultação. Origem: FIBO contract (has contract party, has beneficiary, has execution date, has effective date, has governing jurisdiction, is evidenced by) e FollowTheMoney Contract (title; amount e currency herdados de Asset) — o Contract do FTM é contrato de licitação pública, caso particular deste conceito."@pt-BR ;
  rec:proveniencia "adicionado manualmente na revisão humana da DKD"@pt-BR ;
  skos:changeNote "AJ-239 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: O lastro declarado (\"FTM Contract.contractId\") não existe: o Contract do FollowTheMoney (v4.11.0) é contrato de licitação pública e tem procedureNumber e noticeId, não contractId; FIBO contract não define identificador; a DKC não captura número de contrato — o que captura é \"contrato particular com data retroagida\" e \"contrato de gaveta\", que por definição não têm identificador registral. Sem lastro, sai; reversível por desfazer."@pt-BR .

rec:ConvencaoMultilateral a owl:Class ;
  rdfs:label "ConvencaoMultilateral"@pt-BR ;
  rdfs:comment "Instrumento multilateral de cooperação jurídica (ex.: convenções das Nações Unidas contra a corrupção e contra o crime organizado transnacional, convenção interamericana contra a corrupção, convenção sobre legalização de documentos), caracterizado pelo tema; organismo depositário: [requer pesquisa adicional]."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-292 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:InstrumentoJuridicoDeCooperacao ;
  skos:changeNote "AJ-292 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: \"InstrumentoJurídicoDeCooperação —ESPECIALIZA_SE_EM→ ConvençãoMultilateral / TratadoBilateralDeAssistênciaJurídicaMútua / BaseDeCooperaçãoPorReciprocidade\", cada uma com atributos próprios (marco-normativo-e-instrumentos-juridicos-aplicaveis-entidades.md). ASD R46 nomeia UNCAC, Palermo, OEA e MLATs; R25 põe o instrumento como determinante da via. O atributo tipoDeInstrumento passa a valer só quando não houver subclasse específica — mesma regra de Ativo.tipoDeAtivo e AtorInstitucional.tipoDeAtor."@pt-BR .

rec:Correspondencia a owl:Class ;
  rdfs:label "Correspondencia"@pt-BR ;
  rdfs:comment "Comunicação do fluxo, como e-mail, ofício ou nota verbal."@pt-BR ;
  rec:proveniencia "DKC: gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, pedidos-de-cooperacao-entre-jurisdicoes, tramitacao-processual-e-decisoes-sobre-bens"@pt-BR ;
  rdfs:subClassOf rec:Documento ;
  skos:changeNote "AJ-33 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): Todas são tipadas como prov:Entity e definidas como declaração, extrato, documento, dossiê, comunicação ou registro, ou seja, aquilo que fica escrito. Há alinhamentos de apoio: FTM Document, FTM Message e FIBO account statement."@pt-BR .

rec:Criptoativo a owl:Class ;
  rdfs:label "Criptoativo"@pt-BR ;
  rdfs:comment "Ativo virtual observado como reserva de valor e objeto de investigação patrimonial."@pt-BR ;
  rec:proveniencia "DKC: movimentacao-financeira-e-capacidade-economica"@pt-BR ;
  rdfs:subClassOf rec:Ativo ;
  skos:changeNote "AJ-176 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: O valor do atributo (\"reserva de valor e ativo de baixo rastro documental\") é a definição da classe, não um dado — mesmo caso de UnidadeDeInteligenciaFinanceira.papel."@pt-BR .

rec:DecisaoJudicial a owl:Class ;
  rdfs:label "DecisaoJudicial"@pt-BR ;
  rdfs:comment "Pronunciamento judicial que determina, confirma ou fundamenta efeitos sobre pessoas e ativos."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, marco-normativo-e-instrumentos-juridicos-aplicaveis, pedidos-de-cooperacao-entre-jurisdicoes, tramitacao-processual-e-decisoes-sobre-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:PecaProcessual ;
  skos:changeNote "AJ-141 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC tramitação, literal: \"DecisãoJudicial (especialização de PeçaProcessual)\"."@pt-BR ;
  skos:changeNote "AJ-356 (2026-10-06, fonte: norma): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero diz \"determinado por decisão judicial\", mas isso estava expresso por seis pares e três verbos: DecisaoJudicial DETERMINA MedidaDeConstricao / DETERMINA DecretoDePerdimento / AUTORIZA AlienacaoAntecipada e as inversas MedidaDeConstricao DETERMINADA_POR, DecretoDePerdimento DECORRE_DE e AlienacaoAntecipada AUTORIZADA_POR. Vira um par no gênero, no sentido da decisão (voz ativa, FIBO mandates, mesmo verbo já usado para Destinacao e ViaProcessual). Norma: CPP art. 144-A, \"o juiz determinará a alienação antecipada\" — determina, não só autoriza; CPP arts. 125–137, medidas por ordem do juiz; CP art. 91, perdimento como efeito da condenação. As inversas saem por duplicarem a mesma informação no outro sentido, como já feito para RESULTA_DE/HABILITA e SUBSIDIA/EXIGE."@pt-BR ;
  skos:changeNote "AJ-357 (2026-10-06, fonte: norma): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero diz \"determinado por decisão judicial\", mas isso estava expresso por seis pares e três verbos: DecisaoJudicial DETERMINA MedidaDeConstricao / DETERMINA DecretoDePerdimento / AUTORIZA AlienacaoAntecipada e as inversas MedidaDeConstricao DETERMINADA_POR, DecretoDePerdimento DECORRE_DE e AlienacaoAntecipada AUTORIZADA_POR. Vira um par no gênero, no sentido da decisão (voz ativa, FIBO mandates, mesmo verbo já usado para Destinacao e ViaProcessual). Norma: CPP art. 144-A, \"o juiz determinará a alienação antecipada\" — determina, não só autoriza; CPP arts. 125–137, medidas por ordem do juiz; CP art. 91, perdimento como efeito da condenação. As inversas saem por duplicarem a mesma informação no outro sentido, como já feito para RESULTA_DE/HABILITA e SUBSIDIA/EXIGE."@pt-BR ;
  skos:changeNote "AJ-358 (2026-10-06, fonte: norma): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero diz \"determinado por decisão judicial\", mas isso estava expresso por seis pares e três verbos: DecisaoJudicial DETERMINA MedidaDeConstricao / DETERMINA DecretoDePerdimento / AUTORIZA AlienacaoAntecipada e as inversas MedidaDeConstricao DETERMINADA_POR, DecretoDePerdimento DECORRE_DE e AlienacaoAntecipada AUTORIZADA_POR. Vira um par no gênero, no sentido da decisão (voz ativa, FIBO mandates, mesmo verbo já usado para Destinacao e ViaProcessual). Norma: CPP art. 144-A, \"o juiz determinará a alienação antecipada\" — determina, não só autoriza; CPP arts. 125–137, medidas por ordem do juiz; CP art. 91, perdimento como efeito da condenação. As inversas saem por duplicarem a mesma informação no outro sentido, como já feito para RESULTA_DE/HABILITA e SUBSIDIA/EXIGE."@pt-BR ;
  skos:changeNote "AJ-505 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: DecisaoJudicial.transitoEmJulgado era um texto para duas coisas (\"indicador e data de trânsito\"). Separa-se em booleano e data, para que a consulta gerencial que a DKC de gestão de carteira descreve (casos por estágio; \"trânsito em julgado\"; \"gap temporal entre perdimento declarado e destinação\") seja possível, e para sustentar StatusProbatorio.estagioProbatorio = \"decisão transitada em julgado\" (AJ-467)."@pt-BR .

rec:DeclaracaoFiscalDeRendaEPatrimonio a owl:Class ;
  rdfs:label "DeclaracaoFiscalDeRendaEPatrimonio"@pt-BR ;
  rdfs:comment "Declaração fiscal que registra renda, patrimônio, exercício e eventuais retificações."@pt-BR ;
  rec:proveniencia "DKC: identificacao-de-pessoas-e-estruturas-societarias, movimentacao-financeira-e-capacidade-economica, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:Documento ;
  skos:changeNote "AJ-29 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): Todas são tipadas como prov:Entity e definidas como declaração, extrato, documento, dossiê, comunicação ou registro, ou seja, aquilo que fica escrito. Há alinhamentos de apoio: FTM Document, FTM Message e FIBO account statement."@pt-BR .

rec:DecretoDePerdimento a owl:Class ;
  rdfs:label "DecretoDePerdimento"@pt-BR ;
  rdfs:comment "Perdimento decretado sobre ativo, incluindo seus marcos temporais e fundamento."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, tramitacao-processual-e-decisoes-sobre-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:MedidaJudicialSobreAtivo ;
  skos:changeNote "AJ-186 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Recriada (AJ-23 a AJ-25 desfeitos) com a definição ampliada para receber AlienacaoAntecipada, que tem exatamente o padrão da classe — AUTORIZADA_POR DecisaoJudicial, FUNDAMENTA_SE_EM FundamentoLegal, INCIDE_SOBRE Ativo — e está no mesmo capítulo do CPP (\"Das Medidas Assecuratórias\", art. 144-A)."@pt-BR ;
  skos:changeNote "AJ-349 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero (AJ-184) é \"efeito jurídico … que recai sobre um ativo\", e as três filhas diziam isso cada uma por si: AlienacaoAntecipada INCIDE_SOBRE Ativo, DecretoDePerdimento RECAI_SOBRE Ativo, MedidaDeConstricao RECAI_SOBRE Ativo (DKC constricao: RECAI_SOBRE / INCIDE_SOBRE). Sobe para o gênero com o mesmo alinhamento (FIBO involves) e as três ficam herdadas; RECAI_SOBRE continua membro da superpropriedade incideSobreAtivo."@pt-BR ;
  skos:changeNote "AJ-353 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero diz \"fundamentado em fundamento legal\", e as três filhas tinham FUNDAMENTA_SE_EM FundamentoLegal cada uma com sua especialização para FIBO is predicated on (DKC: MedidaDeConstrição —FUNDAMENTA_SE_EM→ FundamentoLegal; fundamentoLegal em DecretoDePerdimento e AlienaçãoAntecipada). Sobe para o gênero com o mesmo alinhamento. ASD R16: perdimento sempre vinculado ao marco normativo específico."@pt-BR ;
  skos:changeNote "AJ-360 (2026-10-06, fonte: norma): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero diz \"determinado por decisão judicial\", mas isso estava expresso por seis pares e três verbos: DecisaoJudicial DETERMINA MedidaDeConstricao / DETERMINA DecretoDePerdimento / AUTORIZA AlienacaoAntecipada e as inversas MedidaDeConstricao DETERMINADA_POR, DecretoDePerdimento DECORRE_DE e AlienacaoAntecipada AUTORIZADA_POR. Vira um par no gênero, no sentido da decisão (voz ativa, FIBO mandates, mesmo verbo já usado para Destinacao e ViaProcessual). Norma: CPP art. 144-A, \"o juiz determinará a alienação antecipada\" — determina, não só autoriza; CPP arts. 125–137, medidas por ordem do juiz; CP art. 91, perdimento como efeito da condenação. As inversas saem por duplicarem a mesma informação no outro sentido, como já feito para RESULTA_DE/HABILITA e SUBSIDIA/EXIGE."@pt-BR .

rec:Destinacao a owl:Class ;
  rdfs:label "Destinacao"@pt-BR ;
  rdfs:comment "Processo de destinação de ativo após consolidação do perdimento."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  skos:changeNote "AJ-190 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC constrição, literal: \"Repatriação —MODALIDADE_DE→ Destinação\"; Destinacao.modalidade inclui \"partilha\" e EnteDestinatario.tipoDeDestinatario inclui \"ente estrangeiro em partilha internacional\" (ASD R22). Subclasse no lugar da relação MATERIALIZA_SE_EM."@pt-BR ;
  skos:changeNote "AJ-247 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação. A lista \"fundo, vítimas, erário, partilha, leilão\" mistura o tipo do destinatário (fundo, vítimas, erário — já em EnteDestinatario.tipoDeDestinatario, via BENEFICIA) com a modalidade (partilha, leilão); e \"partilha internacional\" é agora a subclasse Repatriacao."@pt-BR .

rec:DispositivoNormativo a owl:Class ;
  rdfs:label "DispositivoNormativo"@pt-BR ;
  rdfs:comment "Dispositivo de norma ou instrumento jurídico que regula ou fundamenta medida."@pt-BR ;
  rec:proveniencia "DKC: marco-normativo-e-instrumentos-juridicos-aplicaveis"@pt-BR ;
  rdfs:subClassOf rec:ElementoNormativo ;
  skos:changeNote "AJ-39 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): As definições trazem gêneros normativos: 'dispositivo de norma', 'referência normativa' e 'instrumento normativo'. Há também a relação É_COMPOSTO_POR de InstrumentoJuridicoDeCooperacao para DispositivoNormativo."@pt-BR ;
  skos:changeNote "AJ-512 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: O atributo DispositivoNormativo.referencia e a relação ProcessoJudicial REFERENCIA Ativo geravam o mesmo IRI (rec:referencia), declarado como DatatypeProperty e como ObjectProperty — punning ilegal no OWL 2 DL, apontado pelo Protégé ao carregar a ontologia (\"Illegal redeclarations of entities\"), que descarta uma das duas. O atributo volta ao nome que a DKC lhe dá: \"referênciaDoArtigoOuParágrafo\" (marco-normativo-e-instrumentos-juridicos-aplicaveis-entidades.md). O validador passa a recusar a colisão (regra E12)."@pt-BR .

rec:Divida a owl:Class ;
  rdfs:label "Divida"@pt-BR ;
  rdfs:comment "[adicionado no EOA — iteração à DKD a partir de lacuna externa mantida no ORR] Obrigação financeira de um devedor perante um credor, com montante, moeda e período (início e término ou quitação). No domínio aparece como dívida declarada à administração tributária, na declaração de renda e patrimônio, e como passivo considerado na análise de compatibilidade econômica. Origem: FollowTheMoney Debt (debtor, creditor; amount e currency herdados de Value; startDate e endDate herdados de Interval)."@pt-BR ;
  rec:proveniencia "adicionado manualmente na revisão humana da DKD"@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-263 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:RelacaoReificada ;
  skos:changeNote "AJ-262 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: O lastro declarado (\"FTM Debt.interestRate\") não existe: o Debt do FollowTheMoney (v4.11.0) tem só debtor e creditor próprios, mais amount/currency (Value) e startDate/endDate (Interval) herdados — conferido nos três YAML. A DKC captura \"dívidas\" apenas como grupo de campos da declaração de renda, sem taxa. Sem lastro, sai; reversível por desfazer."@pt-BR ;
  skos:changeNote "AJ-263 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição citava \"taxa de juros\" e \"FTM Debt (…interestRate…)\", campos inexistentes, e misturava dois sentidos (\"o crédito que fundamenta a recuperação\" é o valor perseguido pelo Estado, não uma dívida entre partes). Passa a dizer o que a classe cobre no domínio: dívida declarada à administração tributária (DKC: \"bens e direitos, rendimentos, dívidas\" na declaração de renda e patrimônio) e passivo considerado na análise de compatibilidade econômica (ASD R38)."@pt-BR ;
  skos:changeNote "AJ-264 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Divida é um vínculo credor–devedor entre pessoas, com datas de início e fim — exatamente o padrão de RelacaoReificada (AJ-258), que já recebeu SucessaoDeEntidade; no FollowTheMoney, Debt e Succession são ambos Interval. Herda QUALIFICADO_POR StatusProbatorio, útil para dívida declarada mas não comprovada."@pt-BR ;
  skos:changeNote "AJ-412 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero (AJ-258) diz \"com identidade própria, datas e qualificação probatória\", mas as datas estavam repetidas nas filhas com o mesmo nome e tipo — dataDeInicio/dataDeFim em Divida, ParticipacaoEmProcesso, SancaoIndividual e VinculoEntrePessoas (DKC: \"dataDeInícioVigência / dataDeFimVigência\", identificacao-de-pessoas-e-estruturas-societarias-entidades.md) — e com outro nome em ParticipacaoSocietaria (dataDeEntrada/dataDeSaida, \"período de entrada/saída\"). Sobem para o gênero; FTM Ownership, Debt, Sanction, Succession e CourtCaseParty são todos Interval com startDate/endDate."@pt-BR ;
  skos:changeNote "AJ-413 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero (AJ-258) diz \"com identidade própria, datas e qualificação probatória\", mas as datas estavam repetidas nas filhas com o mesmo nome e tipo — dataDeInicio/dataDeFim em Divida, ParticipacaoEmProcesso, SancaoIndividual e VinculoEntrePessoas (DKC: \"dataDeInícioVigência / dataDeFimVigência\", identificacao-de-pessoas-e-estruturas-societarias-entidades.md) — e com outro nome em ParticipacaoSocietaria (dataDeEntrada/dataDeSaida, \"período de entrada/saída\"). Sobem para o gênero; FTM Ownership, Debt, Sanction, Succession e CourtCaseParty são todos Interval com startDate/endDate."@pt-BR .

rec:Documento a owl:Class ;
  rdfs:label "Documento"@pt-BR ;
  rdfs:comment "Registro escrito ou documental (prov:Entity) que consigna informações do domínio, como dados patrimoniais, financeiros, registrais ou de tramitação, caracterizado por tipo, data ou período e origem."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-28 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-28 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): Todas são tipadas como prov:Entity e definidas como declaração, extrato, documento, dossiê, comunicação ou registro, ou seja, aquilo que fica escrito. Há alinhamentos de apoio: FTM Document, FTM Message e FIBO account statement."@pt-BR .

rec:DocumentoComprobatorio a owl:Class ;
  rdfs:label "DocumentoComprobatorio"@pt-BR ;
  rdfs:comment "Certidão ou documento juntado aos autos para comprovar fato sobre bem ou pessoa: certidão de registro de imóveis ou de órgão de trânsito, documento societário, contrato, declaração de renda retificada, recibo, nota fiscal. Metadados próprios de cada tipo: [requer pesquisa adicional]."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-143 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:Documento ;
  skos:changeNote "AJ-143 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC tramitação captura DocumentoComprobatório (certidões e documentos juntados: registro de imóveis, trânsito, societários, contratos, declarações retificadas, recibos, notas fiscais) com emissor, data de juntada, bem comprovado e alegação que sustenta; a DKD ficou só com Documento genérico."@pt-BR ;
  skos:changeNote "AJ-269 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Todo documento tem quem o emite — é o prov:wasAttributedTo (Entity → Agent) aplicado ao gênero. Três filhas já diziam isso cada uma a seu modo: DocumentoComprobatorio EMITIDO_POR AtorInstitucional (AJ-146, FIBO is issued by), ParecerJuridico EMITIDO_POR UnidadeDeAssessoriaJuridica (AJ-253) e PecaProcessual PRODUZIDA_POR Agente (AJ-138, prov:wasAttributedTo). A relação sobe para Documento → Agente com os dois alinhamentos e as três ficam herdadas; como o verbo é um só, os alcances específicos já se perdiam na união. DKC: \"órgão/serventia emissora\" do documento juntado (tramitacao-processual-e-decisoes-sobre-bens.md)."@pt-BR .

rec:DocumentoDoPedido a owl:Class ;
  rdfs:label "DocumentoDoPedido"@pt-BR ;
  rdfs:comment "Documento que instrui ou integra pedido de cooperação."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, pedidos-de-cooperacao-entre-jurisdicoes"@pt-BR ;
  rdfs:subClassOf rec:Documento ;
  skos:changeNote "AJ-31 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): Todas são tipadas como prov:Entity e definidas como declaração, extrato, documento, dossiê, comunicação ou registro, ou seja, aquilo que fica escrito. Há alinhamentos de apoio: FTM Document, FTM Message e FIBO account statement."@pt-BR .

rec:DossieDeBuscaPatrimonial a owl:Class ;
  rdfs:label "DossieDeBuscaPatrimonial"@pt-BR ;
  rdfs:comment "Dossiê que consolida alvo, consultas, ativos localizados, confiança, proveniência e pendências."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, identificacao-de-pessoas-e-estruturas-societarias, pedidos-de-cooperacao-entre-jurisdicoes, registro-e-titularidade-de-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:Documento ;
  skos:changeNote "AJ-32 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): Todas são tipadas como prov:Entity e definidas como declaração, extrato, documento, dossiê, comunicação ou registro, ou seja, aquilo que fica escrito. Há alinhamentos de apoio: FTM Document, FTM Message e FIBO account statement."@pt-BR ;
  skos:changeNote "AJ-491 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: DossieDeBuscaPatrimonial.grauDeConfianca (\"confirmado, provável ou hipótese\") dava um grau único ao dossiê inteiro, mas a confiança é de cada achado: ASD R49 pede o grau \"a cada vínculo e a cada afirmação\", e o perfil do analista no ASD entrega o dossiê \"com o que foi localizado, grau de confiança e pendências\" — por item. Os itens já o têm: Ativo, RelacaoReificada, Indicio, ValorEconomicoDeAtivo e ConsultaAFonte QUALIFICADO_POR StatusProbatorio. Era o último grauDeConfianca em texto."@pt-BR .

rec:ElementoDeIdentificacaoDePessoa a owl:Class ;
  rdfs:label "ElementoDeIdentificacaoDePessoa"@pt-BR ;
  rdfs:comment "Dado associado a uma pessoa que serve para designá-la, distingui-la ou relacioná-la entre fontes e jurisdições, com indicação de ambiguidade ou duplicidade."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-42 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-42 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): Pessoa se liga a ambas por IDENTIFICADA_POR e DESIGNADA_POR. As duas definições tratam de distinguir pessoas e têm atributos de ambiguidade ou duplicidade (indicadorDeAmbiguidade, indicadorDeDuplicidadeDocumental)."@pt-BR .

rec:ElementoNormativo a owl:Class ;
  rdfs:label "ElementoNormativo"@pt-BR ;
  rdfs:comment "Norma, dispositivo ou instrumento jurídico que regula ou fundamenta medidas, decisões, perdimento ou cooperação, identificado por referência normativa ou denominação."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-38 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-38 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): As definições trazem gêneros normativos: 'dispositivo de norma', 'referência normativa' e 'instrumento normativo'. Há também a relação É_COMPOSTO_POR de InstrumentoJuridicoDeCooperacao para DispositivoNormativo."@pt-BR .

rec:Embarcacao a owl:Class ;
  rdfs:label "Embarcação"@pt-BR ;
  rdfs:comment "Especialização de ativo para embarcações."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, registro-e-titularidade-de-bens"@pt-BR ;
  rdfs:subClassOf rec:BemMovel .

rec:Endereco a owl:Class ;
  rdfs:label "Endereco"@pt-BR ;
  rdfs:comment "Endereço físico associado a um bem, pessoa física ou pessoa jurídica. Promovido a classe própria por decisão da revisão humana: a DKC capturou endereço como campo de texto livre duplicado independentemente em BemImovel, PessoaFísica e PessoaJurídica — mesma estrutura de dado repetida em três classes sem relação entre si."@pt-BR ;
  rec:proveniencia "adicionado manualmente na revisão humana da DKD"@pt-BR ;
  skos:changeNote "AJ-232 (2026-10-06, fonte: metadado): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação. A descrição ainda dizia que o campo ficava \"dentro de CodigoPostal\", o que deixou de valer com o AJ-63. Lastro DKC: BemImóvel \"município / UF\" e MatrículaImobiliária \"município\" (registro-e-titularidade-de-bens-entidades.md)."@pt-BR ;
  skos:changeNote "AJ-234 (2026-10-06, fonte: metadado): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação. A descrição afirmava \"nenhuma captura no domínio corresponde a unidade federativa\", mas a DKC registra \"município / UF\" em BemImóvel e \"município / UF / jurisdição\" em OrganizaçãoCustodianteDeRegistro (registro-e-titularidade-de-bens-entidades.md) — o campo tem lastro em metadado e a marca [sem lastro em DKC] estava errada."@pt-BR ;
  skos:changeNote "AJ-236 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: País de endereço como texto livre duplicava a classe Jurisdição (\"país ou ordenamento envolvido no ativo, na pessoa, na fonte ou na cooperação\", DKC), que já é o destino de Ativo LOCALIZADO_EM e PessoaJurídica CONSTITUÍDA_EM. O atributo sem lastro sai e entra a relação Endereco LOCALIZADO_EM Jurisdição, pelo mesmo verbo usado em Ativo; FIBO PhysicalAddress tem o país por hasCountry (Country), não como texto. ASD B11, B12 e B39 consultam ativos e endereços por jurisdição."@pt-BR .

rec:EnteDestinatario a owl:Class ;
  rdfs:label "EnteDestinatario"@pt-BR ;
  rdfs:comment "Pessoa, fundo, ente público ou estrangeiro beneficiário da destinação."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos"@pt-BR ;
  rdfs:subClassOf rec:Agente ;
  skos:changeNote "AJ-196 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: EnteDestinatario (\"pessoa, fundo, ente público ou estrangeiro\") é um papel exercido por agentes; sob Agente, a vítima (Pessoa) e o erário (AtorInstitucional) podem ser tipados também como destinatários sem duplicar indivíduos."@pt-BR .

rec:EscrituraPublica a owl:Class ;
  rdfs:label "EscrituraPublica"@pt-BR ;
  rdfs:comment "Escritura pública lavrada em tabelionato de notas que formaliza negócio sobre bem ou direito (compra e venda, doação, permuta, integralização), com o valor declarado pelas partes."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-208 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:AtoNotarial ;
  skos:changeNote "AJ-208 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC registro-e-titularidade, literal: \"EscrituraPública (subclasse de AtoNotarial): valorDeclarado, indícioDeSubdeclaraçãoDeValor\"; resposta humana do ASD (C2) aponta a \"subdeclaração de valor na escritura\" como distorção típica."@pt-BR ;
  skos:changeNote "AJ-501 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: valorDeclarado era um decimal solto, sem moeda nem data, em AtoRegistral, EscrituraPublica e AssercaoDeTitularidade — justamente o valor que as fontes reconhecem como não confiável e que precisa ser comparado com o venal e o de avaliação (ASD B41; DKC valoração: \"AtoNotarial —DECLARA→ ValorDeclaradoEmTransmissão\", com \"montante; ato de origem; partes; data\"). Passa a TEM_VALOR ValorEconomicoDeAtivo (tipoDeValor \"declarado\"), no gênero AtoNotarialOuRegistral para o ato e em AssercaoDeTitularidade para a titularidade conhecida sem o ato — mesmo tratamento de Contrato, Divida, LancamentoFinanceiro e SubRogacaoDeAtivo."@pt-BR .

rec:EventoDeTramitacao a owl:Class ;
  rdfs:label "EventoDeTramitacao"@pt-BR ;
  rdfs:comment "Marco ou mudança de estado na tramitação de um pedido de cooperação ou de um processo judicial — formulação, envio, devolução para saneamento, complementação, reclassificação de via, recebimento de resposta, bloqueio confirmado, repatriação; juntada de documento, prolação de decisão, concessão de exequatur —, com tipo, data e estado resultante; a sequência de eventos forma o histórico (não um valor único). Responsável pelo lançamento e defasagem entre fato e registro: [requer pesquisa adicional]."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-409 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-367 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura o evento de tramitação em quatro categorias — \"EventoDeAndamento: estado do pedido no momento; data/hora; sequência de estados ao longo do tempo (histórico, não valor único)\" (pedidos), \"EventoDeTramitação: tipoDeEvento (envio, saneamento, reclassificação de via, resposta), dataDoEvento\" (marco normativo), \"EventoDeTramitação (marco/mudança de estado) … OCORRE_EM Pedido, É_PRATICADO_POR órgão, É_REGISTRADO_EM SistemaDeInformação\" (tramitação) e EventoDeReclassificaçãoDeVia/EventoDeRetrabalho (gestão) — e a DKD manteve só faseDoFluxo e status como valor único no pedido. ASD R27 pede os marcos visíveis (pedido formulado, saneamento, complementação, resposta, bloqueio confirmado, repatriação) e R59 a linha do tempo. Evento concreto, com dado por trás — não o gênero abstrato Evento, que ficou descartado."@pt-BR ;
  skos:changeNote "AJ-409 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC tramitação: \"ProcessoJudicial —REGISTRA_EVENTO→ EventoDeTramitação\", com tipos próprios do processo (juntada de documento, prolação de decisão, concessão de exequatur). EventoDeTramitacao (AJ-367) nasceu para o pedido; a definição passa a cobrir também o processo, e POSSUI é o mesmo verbo do pedido. ASD R20 (histórico de decisões sobre o ativo ao longo do processo) e R59 (linha do tempo)."@pt-BR .

rec:Exequatur a owl:Class ;
  rdfs:label "Exequatur"@pt-BR ;
  rdfs:comment "Ato ou autorização judicial que habilita cumprimento de carta rogatória."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, marco-normativo-e-instrumentos-juridicos-aplicaveis"@pt-BR ;
  rdfs:subClassOf rec:DecisaoJudicial ;
  skos:changeNote "AJ-26 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): Exequatur é definido como 'ato ou autorização judicial, concedido por um órgão judicial', o que corresponde a um pronunciamento judicial (gênero de DecisaoJudicial). Ambos são tipados como prov:Entity."@pt-BR ;
  skos:changeNote "AJ-485 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: Exequatur.sentidoDoFluxo (\"pedido ativo ou passivo\", DKC: sentidoDoFluxo do AtoDeExequatur) repete PedidoDeCooperacaoJuridicaInternacional.sentidoDoFluxo; com Exequatur HABILITA Pedido, o sentido é o do pedido habilitado. Dois campos para o mesmo fato podem divergir."@pt-BR .

rec:ExtratoDeMovimentacaoFinanceira a owl:Class ;
  rdfs:label "ExtratoDeMovimentacaoFinanceira"@pt-BR ;
  rdfs:comment "Conjunto de lançamentos de movimentação financeira obtido sob condições específicas de acesso."@pt-BR ;
  rec:proveniencia "DKC: movimentacao-financeira-e-capacidade-economica"@pt-BR ;
  rdfs:subClassOf rec:Documento ;
  skos:changeNote "AJ-30 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): Todas são tipadas como prov:Entity e definidas como declaração, extrato, documento, dossiê, comunicação ou registro, ou seja, aquilo que fica escrito. Há alinhamentos de apoio: FTM Document, FTM Message e FIBO account statement."@pt-BR ;
  skos:changeNote "AJ-278 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ExtratoDeMovimentacaoFinanceira.formatoDeEntrega (\"formato de entrega [requer pesquisa adicional]\") duplica Documento.formato (AJ-154: PDF nato-digital, formulário escaneado, imagem, tabela, texto livre), herdado desde o AJ-30. RelatorioDeInteligenciaFinanceira.formaDeEntrega fica, porque inclui o canal de entrega, não só o formato."@pt-BR .

rec:FatoCriminoso a owl:Class ;
  rdfs:label "FatoCriminoso"@pt-BR ;
  rdfs:comment "Fato criminoso, apurado ou objeto de condenação, a que um ativo se vincula por nexo causal. Atributos próprios e vínculo com processo e pessoas: [requer pesquisa adicional]."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-84 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-84 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ASD R11 (vínculo entre o ativo e a condenação/fato criminoso, hoje só o texto de Ativo.nexoCausal) e R13 (tipificação penal no escopo), ambos com lastro humano. O ASD registra divergência com os perfis sintéticos, que deixariam a tipificação fora; pela hierarquia de evidência do método prevalece a resposta humana, pendente de validação por especialistas. Sem metadado de sistema: atributos [requer pesquisa adicional]."@pt-BR .

rec:FundamentoLegal a owl:Class ;
  rdfs:label "FundamentoLegal"@pt-BR ;
  rdfs:comment "Referência normativa usada para fundamentar medida, perdimento ou decisão."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, marco-normativo-e-instrumentos-juridicos-aplicaveis"@pt-BR ;
  rdfs:subClassOf rec:ElementoNormativo ;
  skos:changeNote "AJ-40 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): As definições trazem gêneros normativos: 'dispositivo de norma', 'referência normativa' e 'instrumento normativo'. Há também a relação É_COMPOSTO_POR de InstrumentoJuridicoDeCooperacao para DispositivoNormativo."@pt-BR .

rec:HipotecaLegal a owl:Class ;
  rdfs:label "HipotecaLegal"@pt-BR ;
  rdfs:comment "Medida assecuratória que grava imóveis do indiciado, requerida pelo ofendido, havendo certeza da infração e indícios suficientes da autoria."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-67 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:MedidaDeConstricao ;
  skos:changeNote "AJ-67 (2026-10-05, fonte: norma): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ASD R15 pede medida assecuratória como gênero com espécies e R9 (lastro humano) pede a desambiguação do sentido patrimonial; a DKD só registra as espécies como texto de tipoDeMedida. Norma: CPP, arts. 134 e 135."@pt-BR .

rec:IdentificadorDePessoa a owl:Class ;
  rdfs:label "IdentificadorDePessoa"@pt-BR ;
  rdfs:comment "Identificador utilizado para distinguir ou relacionar pessoas entre fontes e jurisdições."@pt-BR ;
  rec:proveniencia "DKC: identificacao-de-pessoas-e-estruturas-societarias"@pt-BR ;
  rdfs:subClassOf rec:ElementoDeIdentificacaoDePessoa ;
  skos:changeNote "AJ-43 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): Pessoa se liga a ambas por IDENTIFICADA_POR e DESIGNADA_POR. As duas definições tratam de distinguir pessoas e têm atributos de ambiguidade ou duplicidade (indicadorDeAmbiguidade, indicadorDeDuplicidadeDocumental)."@pt-BR ;
  skos:changeNote "AJ-279 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC registra a relação literal \"IdentificadorDePessoa —EMITIDO_POR→ OrganizaçãoInstitucional\" (identificacao-de-pessoas-e-estruturas-societarias-entidades.md) e, ao lado, o atributo de texto organizaçãoEmissora — a DKD ficou só com o texto. Quem emite CPF/CNPJ, NIRE ou identificador estrangeiro é um ator institucional já modelado; o verbo EMITIDO_POR e o alinhamento FIBO is issued by são os mesmos de Documento. FTM Identification.authority cobre o mesmo dado."@pt-BR ;
  skos:changeNote "AJ-281 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC registra a relação literal \"IdentificadorDePessoa —VÁLIDO_EM→ Jurisdição\" e, ao lado, o texto jurisdiçãoDeEmissão; a DKD ficou só com o texto, que duplica a classe Jurisdição. FTM Identification.country cobre o mesmo dado. ASD R53: amarração de identidade \"por documento\" entre jurisdições."@pt-BR .

rec:IncidenteDeRestituicao a owl:Class ;
  rdfs:label "IncidenteDeRestituicao"@pt-BR ;
  rdfs:comment "Incidente em que terceiro ou interessado questiona a constrição ou reivindica ativo."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, tramitacao-processual-e-decisoes-sobre-bens"@pt-BR .

rec:IndicacaoDeBeneficiarioFinal a owl:Class ;
  rdfs:label "IndicacaoDeBeneficiarioFinal"@pt-BR ;
  rdfs:comment "Indicação de pessoa considerada beneficiário final ou titular de fato de pessoa jurídica."@pt-BR ;
  rec:proveniencia "DKC: identificacao-de-pessoas-e-estruturas-societarias"@pt-BR ;
  rdfs:subClassOf rec:VinculoEntrePessoas ;
  skos:changeNote "AJ-423 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: grauDeConfianca (\"confirmado, provável ou hipótese\") duplica QUALIFICADO_POR StatusProbatorio, herdado do gênero, cujo grauDeCerteza tem os mesmos valores — a própria DKC lista grauDeConfiança e statusProbatório lado a lado como a mesma lacuna (identificacao-de-pessoas-e-estruturas-societarias-entidades.md). Era a unificação anotada desde a revisão de Ativo (AJ-156+)."@pt-BR ;
  skos:changeNote "AJ-428 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: IndicacaoDeBeneficiarioFinal REFERE_SE_A PessoaJuridica duplica TEM_ORIGEM Pessoa, herdado de VinculoEntrePessoas (a origem do vínculo é a pessoa jurídica; o destino, o beneficiário — APONTA fica, porque carrega o alinhamento FTM Control.controller). Mesmo desenho de InterposicaoDePessoa (AJ-74)."@pt-BR .

rec:Indicio a owl:Class ;
  rdfs:label "Indicio"@pt-BR ;
  rdfs:comment "Sinal ou padrão observado em dados — financeiros, patrimoniais ou registrais — que aponta possível ocultação, incompatibilidade ou interposição e é registrado como sinalização a investigar, nunca como conclusão (ASD R71), com tipo, descrição e qualificação probatória (alegação, indício, conclusão pericial, decisão transitada em julgado)."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-316 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-316 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura dois indícios em categorias distintas: IndícioFinanceiro (\"fenômeno observável no dado de movimentação\", movimentacao-financeira-e-capacidade-economica-entidades.md) e IndícioPatrimonial (descricao, origemDaInformacao, dataDaApuracao; PRODUZ por órgão de investigação, FUNDAMENTA MedidaDeConstrição, REFERE_SE_A Ativo — constricao-perdimento-e-destinacao-de-ativos-entidades.md). A DKD manteve só o financeiro. O ASD, com lastro humano, descreve o analista de busca patrimonial que \"extrai indício patrimonial\" e R71 pede o registro de indícios (padrão de laranja, incompatibilidade patrimonial) \"como sinalização a investigar, nunca como conclusão\". O gênero carrega o que é comum — tipo, descrição e QUALIFICADO_POR StatusProbatorio (ASD R49) — e o par FTM Risk, que descreve \"indicador de risco associado a entidade\", não um indício financeiro em particular."@pt-BR .

rec:IndicioFinanceiro a owl:Class ;
  rdfs:label "IndicioFinanceiro"@pt-BR ;
  rdfs:comment "Fenômeno ou padrão observado em dados de movimentação financeira."@pt-BR ;
  rec:proveniencia "DKC: movimentacao-financeira-e-capacidade-economica"@pt-BR ;
  rdfs:subClassOf rec:Indicio ;
  skos:changeNote "AJ-317 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura dois indícios em categorias distintas: IndícioFinanceiro (\"fenômeno observável no dado de movimentação\", movimentacao-financeira-e-capacidade-economica-entidades.md) e IndícioPatrimonial (descricao, origemDaInformacao, dataDaApuracao; PRODUZ por órgão de investigação, FUNDAMENTA MedidaDeConstrição, REFERE_SE_A Ativo — constricao-perdimento-e-destinacao-de-ativos-entidades.md). A DKD manteve só o financeiro. O ASD, com lastro humano, descreve o analista de busca patrimonial que \"extrai indício patrimonial\" e R71 pede o registro de indícios (padrão de laranja, incompatibilidade patrimonial) \"como sinalização a investigar, nunca como conclusão\". O gênero carrega o que é comum — tipo, descrição e QUALIFICADO_POR StatusProbatorio (ASD R49) — e o par FTM Risk, que descreve \"indicador de risco associado a entidade\", não um indício financeiro em particular."@pt-BR ;
  skos:changeNote "AJ-318 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Sobe para o gênero Indicio: vale igualmente para o indício patrimonial (DKC) e herda para o financeiro."@pt-BR ;
  skos:changeNote "AJ-320 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Sobe para o gênero Indicio: vale igualmente para o indício patrimonial (DKC) e herda para o financeiro."@pt-BR ;
  skos:changeNote "AJ-322 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Sobe para o gênero Indicio: vale igualmente para o indício patrimonial (DKC) e herda para o financeiro."@pt-BR ;
  skos:changeNote "AJ-493 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: IndicioFinanceiro EXTRAÍDO_DE ExtratoDeMovimentacaoFinanceira era a única ligação de um indício com sua fonte; IndicioPatrimonial só tinha o texto origemDaInformacao (\"autos, cadastro, registro público, base estrangeira\"). A relação sobe ao gênero com o gênero do documento — o extrato, a peça dos autos, a matrícula e a certidão são todos Documento — e o mesmo alinhamento (PROV wasDerivedFrom). origemDaInformacao permanece para a fonte que não é documento catalogado. ASD R50: procedência de toda informação (processo, peça)."@pt-BR .

rec:IndicioPatrimonial a owl:Class ;
  rdfs:label "IndicioPatrimonial"@pt-BR ;
  rdfs:comment "Indício apurado na busca patrimonial a partir de cadastros, registros e autos — titularidade incompatível com a renda, padrão de interposta pessoa, oneração proposital, transferência após indício de investigação —, com origem da informação e data da apuração; fundamenta pedido de medida de constrição e refere-se ao ativo em questão."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-324 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:Indicio ;
  skos:changeNote "AJ-324 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: IndícioPatrimonial com descricao, origemDaInformacao e dataDaApuracao; \"ÓrgãoDeInvestigação —PRODUZ→ IndícioPatrimonial\", \"IndícioPatrimonial —FUNDAMENTA→ MedidaDeConstrição\" e \"—REFERE_SE_A→ Ativo\" (constricao-perdimento-e-destinacao-de-ativos-entidades.md). Não há classe de órgão de investigação na ontologia (é tipoDeAtor de AtorInstitucional); quem produz o indício, pelo ASD (lastro humano), é a unidade de busca patrimonial."@pt-BR .

rec:IndisponibilidadeDeBens a owl:Class ;
  rdfs:label "IndisponibilidadeDeBens"@pt-BR ;
  rdfs:comment "Medida que torna indisponíveis os bens do réu para garantir a recomposição do erário ou do acréscimo patrimonial resultante de enriquecimento ilícito."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-70 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:MedidaDeConstricao ;
  skos:changeNote "AJ-70 (2026-10-05, fonte: norma): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ASD R15 pede medida assecuratória como gênero com espécies e R9 (lastro humano) pede a desambiguação do sentido patrimonial; a DKD só registra as espécies como texto de tipoDeMedida. Norma: Lei 8.429/1992, art. 16 (redação da Lei 14.230/2021)."@pt-BR .

rec:InstituicaoFinanceira a owl:Class ;
  rdfs:label "InstituicaoFinanceira"@pt-BR ;
  rdfs:comment "Instituição custodiante de conta ou ativo financeiro e potencial executora de medida."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, movimentacao-financeira-e-capacidade-economica, pedidos-de-cooperacao-entre-jurisdicoes"@pt-BR ;
  rdfs:subClassOf rec:PessoaJuridica .

rec:InstrumentoJuridicoDeCooperacao a owl:Class ;
  rdfs:label "InstrumentoJuridicoDeCooperacao"@pt-BR ;
  rdfs:comment "Instrumento normativo de cooperação, incluindo convenções, tratados e reciprocidade."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, identificacao-de-pessoas-e-estruturas-societarias, marco-normativo-e-instrumentos-juridicos-aplicaveis, pedidos-de-cooperacao-entre-jurisdicoes, tramitacao-processual-e-decisoes-sobre-bens"@pt-BR ;
  rdfs:subClassOf rec:ElementoNormativo ;
  skos:changeNote "AJ-41 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): As definições trazem gêneros normativos: 'dispositivo de norma', 'referência normativa' e 'instrumento normativo'. Há também a relação É_COMPOSTO_POR de InstrumentoJuridicoDeCooperacao para DispositivoNormativo."@pt-BR ;
  skos:changeNote "AJ-297 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: \"InstrumentoJurídicoDeCooperação —ESPECIALIZA_SE_EM→ ConvençãoMultilateral / TratadoBilateralDeAssistênciaJurídicaMútua / BaseDeCooperaçãoPorReciprocidade\", cada uma com atributos próprios (marco-normativo-e-instrumentos-juridicos-aplicaveis-entidades.md). ASD R46 nomeia UNCAC, Palermo, OEA e MLATs; R25 põe o instrumento como determinante da via. O atributo tipoDeInstrumento passa a valer só quando não houver subclasse específica — mesma regra de Ativo.tipoDeAtivo e AtorInstitucional.tipoDeAtor."@pt-BR ;
  skos:changeNote "AJ-439 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: RequisitoFormal (tradução, apostilamento, formato — ASD R29) e RequisitoDeAdmissibilidade (dupla incriminação — ASD R31, AJ-379) são as duas espécies do que um pedido de cooperação precisa satisfazer, e já compartilhavam duas relações: ambos DEFINE por InstrumentoJuridicoDeCooperacao e ambos GERA MotivoDeSaneamentoOuDevolucao quando descumpridos (DKC marco normativo: \"RequisitoFormal —É_EXIGIDO_POR→ Instrumento\", \"RequisitoDeAdmissibilidade … instrumentosEmQueÉExigidoOuDispensado\", \"RequisitoFormal —QUANDO_DESCUMPRIDO_GERA→ Motivo\"). Gênero com conteúdo: as duas relações sobem e os quatro pares viram dois. IMPÕE (Jurisdição) fica em RequisitoFormal — a DKC só o registra para a exigência formal."@pt-BR ;
  skos:changeNote "AJ-440 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: RequisitoFormal (tradução, apostilamento, formato — ASD R29) e RequisitoDeAdmissibilidade (dupla incriminação — ASD R31, AJ-379) são as duas espécies do que um pedido de cooperação precisa satisfazer, e já compartilhavam duas relações: ambos DEFINE por InstrumentoJuridicoDeCooperacao e ambos GERA MotivoDeSaneamentoOuDevolucao quando descumpridos (DKC marco normativo: \"RequisitoFormal —É_EXIGIDO_POR→ Instrumento\", \"RequisitoDeAdmissibilidade … instrumentosEmQueÉExigidoOuDispensado\", \"RequisitoFormal —QUANDO_DESCUMPRIDO_GERA→ Motivo\"). Gênero com conteúdo: as duas relações sobem e os quatro pares viram dois. IMPÕE (Jurisdição) fica em RequisitoFormal — a DKC só o registra para a exigência formal."@pt-BR .

rec:InterposicaoDePessoa a owl:Class ;
  rdfs:label "InterposicaoDePessoa"@pt-BR ;
  rdfs:comment "Vínculo em que uma pessoa física ou jurídica (interposta pessoa, \"laranja\") figura como titular aparente de um ativo para ocultar a titularidade real de outra pessoa. A origem do vínculo é a pessoa ocultada (investigado ou condenado) e o destino é a interposta pessoa; vínculos encadeados representam cadeias de interposição."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-74 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:VinculoEntrePessoas ;
  skos:changeNote "AJ-74 (2026-10-05, fonte: ontologia_externa): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ASD R4 e R5 (lastro humano; resposta B1: \"pessoa usada como proprietário aparente de um ativo para ocultar a real propriedade\"; cadeia condenado ↔ interposta pessoa ↔ … ↔ ativo). O ORR mantém a lacuna externa FIBO \"controlling nominee\" (o \"laranja\" como classe própria). Sem alinhamento: a IRI não está no catálogo. Sem metadado de sistema: atributos próprios [requer pesquisa adicional]."@pt-BR .

rec:Jurisdicao a owl:Class ;
  rdfs:label "Jurisdição"@pt-BR ;
  rdfs:comment "País ou ordenamento envolvido no ativo, na pessoa, na fonte ou na cooperação."@pt-BR ;
  rec:proveniencia "DKC: gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, identificacao-de-pessoas-e-estruturas-societarias, marco-normativo-e-instrumentos-juridicos-aplicaveis, pedidos-de-cooperacao-entre-jurisdicoes"@pt-BR ;
  skos:changeNote "AJ-335 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC gestão de carteira, atributos literais da Jurisdição: \"volume de pedidos em aberto; tempo médio entre envio e resposta; taxa de sucesso\". ASD R56: \"tempo médio de resposta por país e taxa de sucesso por país/tratado\". tempoMedioDeResposta era string, inútil para a consulta gerencial; passa a decimal em dias (unidade é decisão de modelagem — a DKC não a informa). São métricas derivadas dos pedidos, mantidas como atributos porque a DKC as captura assim e o histórico consolidado \"inexistente\" é exatamente a lacuna que o ASD quer suprir."@pt-BR .

rec:LancamentoFinanceiro a owl:Class ;
  rdfs:label "LancamentoFinanceiro"@pt-BR ;
  rdfs:comment "Unidade de movimentação observada em extrato financeiro."@pt-BR ;
  rec:proveniencia "DKC: movimentacao-financeira-e-capacidade-economica"@pt-BR ;
  skos:changeNote "AJ-339 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC registra, além de \"valor e moeda\", a relação literal \"LançamentoFinanceiro —EXPRESSO_EM→ ValorMonetário\" (movimentacao-financeira-e-capacidade-economica-entidades.md), e a ontologia já expressa montantes por TEM_VALOR ValorEconomicoDeAtivo em Contrato, Divida e SubRogacaoDeAtivo (FIBO has monetary amount). Com o par, valor e moeda inline ficam duplicados; ValorEconomicoDeAtivo traz ainda dataDeReferencia, valorConvertido e TaxaDeCambioHistorica — o que ASD R73 pede para valores em jurisdições distintas, caso típico de extrato estrangeiro obtido por cooperação."@pt-BR ;
  skos:changeNote "AJ-340 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC registra, além de \"valor e moeda\", a relação literal \"LançamentoFinanceiro —EXPRESSO_EM→ ValorMonetário\" (movimentacao-financeira-e-capacidade-economica-entidades.md), e a ontologia já expressa montantes por TEM_VALOR ValorEconomicoDeAtivo em Contrato, Divida e SubRogacaoDeAtivo (FIBO has monetary amount). Com o par, valor e moeda inline ficam duplicados; ValorEconomicoDeAtivo traz ainda dataDeReferencia, valorConvertido e TaxaDeCambioHistorica — o que ASD R73 pede para valores em jurisdições distintas, caso típico de extrato estrangeiro obtido por cooperação."@pt-BR .

rec:ListaRestritiva a owl:Class ;
  rdfs:label "ListaRestritiva"@pt-BR ;
  rdfs:comment "Lista de sanções ou restrições emitida por organização nacional ou internacional."@pt-BR ;
  rec:proveniencia "DKC: identificacao-de-pessoas-e-estruturas-societarias, marco-normativo-e-instrumentos-juridicos-aplicaveis"@pt-BR ;
  skos:changeNote "AJ-343 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: \"ListaRestritiva —EMITIDA_POR→ OrganizaçãoInstitucional\" (identificacao-de-pessoas-e-estruturas-societarias-entidades.md); a DKD ficou só com o texto organizaçãoEmissora. Mesmo verbo e alinhamento (FIBO is issued by) de Documento e IdentificadorDePessoa. OPERADO_POR AtorInstitucional, herdado, continua para quem distribui a base; EMITIDO_POR é quem a institui (OFAC, Conselho de Segurança)."@pt-BR .

rec:MatriculaImobiliaria a owl:Class ;
  rdfs:label "MatriculaImobiliaria"@pt-BR ;
  rdfs:comment "Registro matricial que descreve imóvel, titularidade, atos, ônus e averbações."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, registro-e-titularidade-de-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:RegistroPublicoDeBem ;
  skos:changeNote "AJ-219 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Com AtoRegistral TEM_PARTE Pessoa e AtoRegistral PRODUZ AssercaoDeTitularidade (que já tem TITULAR_ANTERIOR e dataDaTransmissao), o atalho na matrícula duplica o mesmo dado sem data — mesmo critério aplicado a BemMovel (AJ-173)."@pt-BR .

rec:MedidaDeConstricao a owl:Class ;
  rdfs:label "MedidaDeConstricao"@pt-BR ;
  rdfs:comment "Medida assecuratória ou constritiva que limita disponibilidade, transferência ou posse de ativo."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, movimentacao-financeira-e-capacidade-economica, tramitacao-processual-e-decisoes-sobre-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:MedidaJudicialSobreAtivo ;
  skos:changeNote "AJ-185 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Recriada (AJ-23 a AJ-25 desfeitos) com a definição ampliada para receber AlienacaoAntecipada, que tem exatamente o padrão da classe — AUTORIZADA_POR DecisaoJudicial, FUNDAMENTA_SE_EM FundamentoLegal, INCIDE_SOBRE Ativo — e está no mesmo capítulo do CPP (\"Das Medidas Assecuratórias\", art. 144-A)."@pt-BR ;
  skos:changeNote "AJ-350 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero (AJ-184) é \"efeito jurídico … que recai sobre um ativo\", e as três filhas diziam isso cada uma por si: AlienacaoAntecipada INCIDE_SOBRE Ativo, DecretoDePerdimento RECAI_SOBRE Ativo, MedidaDeConstricao RECAI_SOBRE Ativo (DKC constricao: RECAI_SOBRE / INCIDE_SOBRE). Sobe para o gênero com o mesmo alinhamento (FIBO involves) e as três ficam herdadas; RECAI_SOBRE continua membro da superpropriedade incideSobreAtivo."@pt-BR ;
  skos:changeNote "AJ-354 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero diz \"fundamentado em fundamento legal\", e as três filhas tinham FUNDAMENTA_SE_EM FundamentoLegal cada uma com sua especialização para FIBO is predicated on (DKC: MedidaDeConstrição —FUNDAMENTA_SE_EM→ FundamentoLegal; fundamentoLegal em DecretoDePerdimento e AlienaçãoAntecipada). Sobe para o gênero com o mesmo alinhamento. ASD R16: perdimento sempre vinculado ao marco normativo específico."@pt-BR ;
  skos:changeNote "AJ-361 (2026-10-06, fonte: norma): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero diz \"determinado por decisão judicial\", mas isso estava expresso por seis pares e três verbos: DecisaoJudicial DETERMINA MedidaDeConstricao / DETERMINA DecretoDePerdimento / AUTORIZA AlienacaoAntecipada e as inversas MedidaDeConstricao DETERMINADA_POR, DecretoDePerdimento DECORRE_DE e AlienacaoAntecipada AUTORIZADA_POR. Vira um par no gênero, no sentido da decisão (voz ativa, FIBO mandates, mesmo verbo já usado para Destinacao e ViaProcessual). Norma: CPP art. 144-A, \"o juiz determinará a alienação antecipada\" — determina, não só autoriza; CPP arts. 125–137, medidas por ordem do juiz; CP art. 91, perdimento como efeito da condenação. As inversas saem por duplicarem a mesma informação no outro sentido, como já feito para RESULTA_DE/HABILITA e SUBSIDIA/EXIGE."@pt-BR ;
  skos:changeNote "AJ-363 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC constricao: \"MedidaDeConstrição —REQUERIDA_POR→ ÓrgãoDeAcusação\" e \"DecretoDePerdimento —REQUERIDO_POR→ ÓrgãoDeAcusação\"; a ontologia tinha só a primeira, mais a inversa OrgaoDeAcusacao REQUER MedidaDeConstricao. Sobe para o gênero (cobre também o decreto e a alienação, que o MP requer) e a inversa sai por duplicar."@pt-BR ;
  skos:changeNote "AJ-365 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação: MedidaDeConstricao tem cinco espécies (AJ-66 a AJ-70), então tipoDeMedida vale só quando não houver subclasse específica — mesma regra de Ativo.tipoDeAtivo, AtorInstitucional.tipoDeAtor e InstrumentoJuridicoDeCooperacao.tipoDeInstrumento."@pt-BR .

rec:MedidaJudicialSobreAtivo a owl:Class ;
  rdfs:label "MedidaJudicialSobreAtivo"@pt-BR ;
  rdfs:comment "Efeito jurídico determinado por decisão judicial e fundamentado em fundamento legal, que recai sobre um ativo: limita sua disponibilidade (constrição), decreta sua perda (perdimento) ou o converte antecipadamente em valor (alienação antecipada)."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-184 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-184 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Recriada (AJ-23 a AJ-25 desfeitos) com a definição ampliada para receber AlienacaoAntecipada, que tem exatamente o padrão da classe — AUTORIZADA_POR DecisaoJudicial, FUNDAMENTA_SE_EM FundamentoLegal, INCIDE_SOBRE Ativo — e está no mesmo capítulo do CPP (\"Das Medidas Assecuratórias\", art. 144-A)."@pt-BR .

rec:MotivoDeSaneamentoOuDevolucao a owl:Class ;
  rdfs:label "MotivoDeSaneamentoOuDevolucao"@pt-BR ;
  rdfs:comment "Motivo pelo qual um pedido de cooperação é devolvido ou mandado sanear — falta de tradução, ausência de apostilamento ou legalização, dupla incriminação não demonstrada, formulário incompleto, individualização insuficiente do bem —, hoje em texto livre de ofício ou e-mail; lista fechada: [requer pesquisa adicional]."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-375 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-375 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC em duas categorias: \"MotivoDeDevoluçãoOuSaneamento: motivo (falta de tradução, ausência de apostilamento, dupla incriminação, formulário incompleto, individualização insuficiente do bem) — sem lista fechada e sem registro estruturado\" (pedidos) e \"MotivoDeSaneamentoOuDevolução … EventoDeTramitação TEM_CAUSA Motivo; RequisitoFormal QUANDO_DESCUMPRIDO_GERA Motivo\" (marco normativo). ASD R28 pede exatamente a lista categorizada."@pt-BR .

rec:NexoCausal a owl:Class ;
  rdfs:label "NexoCausal"@pt-BR ;
  rdfs:comment "Vínculo reificado entre um ativo e o fato criminoso de que ele é instrumento, produto ou proveito, ou a que equivale ou em que foi sub-rogado (Código Penal, art. 91, II e § 1º), com a natureza do nexo, a descrição em texto e a qualificação probatória (confirmado, provável, hipótese)."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-301 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:RelacaoReificada ;
  skos:changeNote "AJ-301 (2026-10-06, fonte: norma): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ASD R11 (lastro humano): \"representar o vínculo entre ativo específico e a condenação/fato criminoso (nexo causal), hoje disperso em texto livre\". A relação direta Ativo TEM_NEXO_COM FatoCriminoso (AJ-86) diz que há nexo, não qual: o Código Penal, art. 91, II, distingue instrumentos do crime (alínea a), produto e proveito (alínea b) e, no § 1º, bens ou valores equivalentes — e a DKC já separa \"GERA_PRODUTO_OU_PROVEITO_EM\" de \"CadeiaDeSubRogação\" (constricao-perdimento-e-destinacao-de-ativos-entidades.md), e qualifica o vínculo com StatusProbatório (confirmado / provável / hipótese). FundamentoLegal.tipoDeOrigemDoBem depende dessa natureza. Vira relação reificada, no padrão de RelacaoReificada (herda QUALIFICADO_POR StatusProbatorio); TEM_NEXO_COM fica como atalho direto."@pt-BR .

rec:NomeEVarianteDeGrafia a owl:Class ;
  rdfs:label "NomeEVarianteDeGrafia"@pt-BR ;
  rdfs:comment "Forma nominal ou variante de grafia associada a uma pessoa."@pt-BR ;
  rec:proveniencia "DKC: identificacao-de-pessoas-e-estruturas-societarias"@pt-BR ;
  rdfs:subClassOf rec:ElementoDeIdentificacaoDePessoa ;
  skos:changeNote "AJ-44 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): Pessoa se liga a ambas por IDENTIFICADA_POR e DESIGNADA_POR. As duas definições tratam de distinguir pessoas e têm atributos de ambiguidade ou duplicidade (indicadorDeAmbiguidade, indicadorDeDuplicidadeDocumental)."@pt-BR .

rec:NormaNacional a owl:Class ;
  rdfs:label "NormaNacional"@pt-BR ;
  rdfs:comment "Legislação interna de um Estado — lei, decreto ou ato normativo — que fundamenta medidas, perdimento ou destinação, tipifica condutas ou promulga instrumento internacional; composta por dispositivos normativos e vigente em uma jurisdição. Número e ano, repositório oficial e legislação estrangeira correspondente: [requer pesquisa adicional]."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-284 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:ElementoNormativo ;
  skos:changeNote "AJ-284 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura NormaNacional (\"legislação interna de um Estado\": númeroEAnoDaLei, denominaçãoPopular, jurisdiçãoDeOrigem, temaNormativo, vigência) com \"É_COMPOSTA_POR DispositivoNormativo\", \"FUNDAMENTA MedidaDeConstriçãoOuPerdimento\" e \"VIGE_EM Jurisdição\" (marco-normativo-e-instrumentos-juridicos-aplicaveis-entidades.md). A DKD não a manteve: hoje um dispositivo de lei interna (CPP art. 125, Lei 8.429 art. 16, Lei 9.613) não tem norma a que pertencer — só o tratado tem (É_COMPOSTO_POR). Os próprios ajustes desta revisão citam essas leis como fonte \"norma\". Lacuna reconhecida pela DKC: \"tipificação penal como domínio conexo × interno [requer validação]\"."@pt-BR .

rec:OrgaoDeAcusacao a owl:Class ;
  rdfs:label "OrgaoDeAcusacao"@pt-BR ;
  rdfs:comment "Órgão responsável por requerer ou acompanhar medidas no fluxo de recuperação de ativos."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, movimentacao-financeira-e-capacidade-economica, tramitacao-processual-e-decisoes-sobre-bens"@pt-BR ;
  rdfs:subClassOf rec:AtorInstitucional ;
  skos:changeNote "AJ-2 (2026-10-05, fonte: modelagem): sugestão da IA (claude-sonnet-5 (anthropic)): É um órgão que requer medidas no fluxo (REQUER → MedidaDeConstricao), com atributos de atribuição e esfera de atuação, mesmo padrão de outros órgãos já classificados como AtorInstitucional."@pt-BR ;
  skos:changeNote "AJ-97 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Duplica AtorInstitucional.jurisdicao (\"jurisdição ou esfera de atuação\"), herdado."@pt-BR ;
  skos:changeNote "AJ-364 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC constricao: \"MedidaDeConstrição —REQUERIDA_POR→ ÓrgãoDeAcusação\" e \"DecretoDePerdimento —REQUERIDO_POR→ ÓrgãoDeAcusação\"; a ontologia tinha só a primeira, mais a inversa OrgaoDeAcusacao REQUER MedidaDeConstricao. Sobe para o gênero (cobre também o decreto e a alienação, que o MP requer) e a inversa sai por duplicar."@pt-BR .

rec:OrgaoDeGestaoPatrimonial a owl:Class ;
  rdfs:label "OrgaoDeGestaoPatrimonial"@pt-BR ;
  rdfs:comment "Órgão responsável pela administração de ativos submetidos à gestão patrimonial."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:AtorInstitucional ;
  skos:changeNote "AJ-3 (2026-10-05, fonte: modelagem): sugestão da IA (claude-sonnet-5 (anthropic)): Definição indica órgão responsável pela administração de ativos, equivalente ao papel de outras unidades já modeladas como AtorInstitucional."@pt-BR ;
  skos:changeNote "AJ-101 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Nome de sistema é SistemaDeInformacao.nomeOficial; o vínculo com o órgão já existe por SistemaDeInformacao OPERADO_POR AtorInstitucional."@pt-BR .

rec:OrgaoDeRegistroPublico a owl:Class ;
  rdfs:label "OrgaoDeRegistroPublico"@pt-BR ;
  rdfs:comment "Organização custodiante de registros públicos relacionados a bens e atos registrais."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, registro-e-titularidade-de-bens"@pt-BR ;
  rdfs:subClassOf rec:AtorInstitucional ;
  skos:changeNote "AJ-4 (2026-10-05, fonte: modelagem): sugestão da IA (claude-sonnet-5 (anthropic)): É organização custodiante de registros, com atributos de abrangência territorial e tipo de órgão, consistente com o papel genérico de AtorInstitucional."@pt-BR ;
  skos:changeNote "AJ-96 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Duplica AtorInstitucional.tipoDeAtor, herdado desde que a classe passou a ser subclasse de AtorInstitucional."@pt-BR ;
  skos:changeNote "AJ-100 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Nível de acesso é propriedade da base, não do órgão: já existe SistemaDeInformacao.nivelDeAcesso, e SistemaDeInformacao OPERADO_POR AtorInstitucional faz o vínculo."@pt-BR .

rec:OrgaoJudicial a owl:Class ;
  rdfs:label "OrgaoJudicial"@pt-BR ;
  rdfs:comment "Órgão judicial que conduz processo, profere decisão ou atua em cumprimento e exequatur."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, marco-normativo-e-instrumentos-juridicos-aplicaveis, movimentacao-financeira-e-capacidade-economica, pedidos-de-cooperacao-entre-jurisdicoes, tramitacao-processual-e-decisoes-sobre-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:AtorInstitucional ;
  skos:changeNote "AJ-5 (2026-10-05, fonte: modelagem): sugestão da IA (claude-sonnet-5 (anthropic)): Definição descreve órgão que conduz processo e profere decisões, atuando institucionalmente no fluxo, mesmo padrão de AreaDeExecucaoOperacional e demais órgãos já ligados a AtorInstitucional."@pt-BR ;
  skos:changeNote "AJ-114 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Todo órgão pertence a uma jurisdição: a relação sobe de AutoridadeCentral e OrgaoJudicial para AtorInstitucional (mesmo alinhamento FIBO), e o atributo de texto jurisdicao fica redundante."@pt-BR .

rec:ParecerJuridico a owl:Class ;
  rdfs:label "ParecerJuridico"@pt-BR ;
  rdfs:comment "Parecer emitido por unidade de assessoria jurídica sobre o enquadramento e o alcance do perdimento de um ativo, que subsidia a decisão de destinação. Registra objeto, data de emissão e conclusão."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-249 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:Documento ;
  skos:changeNote "AJ-249 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura ParecerJurídico (objetoDoParecer, dataDeEmissao, conclusao) emitido pela assessoria jurídica, que analisa o decreto de perdimento e em que a autoridade decisória se baseia (constricao-perdimento-e-destinacao-de-ativos-entidades.md). O ASD confirma, com lastro humano, a assessoria jurídica em perdimento e destinação como usuária que \"subsidia decisões sobre destinação\" — o parecer é esse subsídio. A classe não entrou na DKD; aqui entra como Documento."@pt-BR ;
  skos:changeNote "AJ-270 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Todo documento tem quem o emite — é o prov:wasAttributedTo (Entity → Agent) aplicado ao gênero. Três filhas já diziam isso cada uma a seu modo: DocumentoComprobatorio EMITIDO_POR AtorInstitucional (AJ-146, FIBO is issued by), ParecerJuridico EMITIDO_POR UnidadeDeAssessoriaJuridica (AJ-253) e PecaProcessual PRODUZIDA_POR Agente (AJ-138, prov:wasAttributedTo). A relação sobe para Documento → Agente com os dois alinhamentos e as três ficam herdadas; como o verbo é um só, os alcances específicos já se perdiam na união. DKC: \"órgão/serventia emissora\" do documento juntado (tramitacao-processual-e-decisoes-sobre-bens.md)."@pt-BR .

rec:ParticipacaoEmProcesso a owl:Class ;
  rdfs:label "ParticipacaoEmProcesso"@pt-BR ;
  rdfs:comment "Participação reificada de uma pessoa em processo judicial, com o papel exercido (autor, réu, condenado, terceiro interessado) e o período."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-76 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:RelacaoReificada ;
  skos:changeNote "AJ-76 (2026-10-05, fonte: ontologia_externa): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: O ORR mantém a lacuna externa FTM CourtCaseParty (\"parte em processo com role (autor/réu) e período — relação reificada pessoa–processo\"). ASD R33 e R36 (lastro humano) consultam \"condenados\", mas TEM_PARTE não tem papel e Pessoa.papelNoCaso é global."@pt-BR ;
  skos:changeNote "AJ-261 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: RelacaoReificada (AJ-35) foi definida para \"pessoas entre si ou pessoas a ativos\", mas o padrão que a justifica — relação com identidade própria, datas e qualificação por StatusProbatorio (QUALIFICADO_POR) — é o mesmo de SucessaoDeEntidade (PJ ↔ PJ), SubRogacaoDeAtivo (ativo ↔ ativo) e ParticipacaoEmProcesso (pessoa ↔ processo). A definição passa a cobrir também ativos entre si e pessoas a processos; as três entram como subclasses e herdam QUALIFICADO_POR."@pt-BR ;
  skos:changeNote "AJ-414 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero (AJ-258) diz \"com identidade própria, datas e qualificação probatória\", mas as datas estavam repetidas nas filhas com o mesmo nome e tipo — dataDeInicio/dataDeFim em Divida, ParticipacaoEmProcesso, SancaoIndividual e VinculoEntrePessoas (DKC: \"dataDeInícioVigência / dataDeFimVigência\", identificacao-de-pessoas-e-estruturas-societarias-entidades.md) — e com outro nome em ParticipacaoSocietaria (dataDeEntrada/dataDeSaida, \"período de entrada/saída\"). Sobem para o gênero; FTM Ownership, Debt, Sanction, Succession e CourtCaseParty são todos Interval com startDate/endDate."@pt-BR ;
  skos:changeNote "AJ-415 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero (AJ-258) diz \"com identidade própria, datas e qualificação probatória\", mas as datas estavam repetidas nas filhas com o mesmo nome e tipo — dataDeInicio/dataDeFim em Divida, ParticipacaoEmProcesso, SancaoIndividual e VinculoEntrePessoas (DKC: \"dataDeInícioVigência / dataDeFimVigência\", identificacao-de-pessoas-e-estruturas-societarias-entidades.md) — e com outro nome em ParticipacaoSocietaria (dataDeEntrada/dataDeSaida, \"período de entrada/saída\"). Sobem para o gênero; FTM Ownership, Debt, Sanction, Succession e CourtCaseParty são todos Interval com startDate/endDate."@pt-BR .

rec:ParticipacaoSocietaria a owl:Class ;
  rdfs:label "ParticipacaoSocietaria"@pt-BR ;
  rdfs:comment "Participação ou vínculo societário reificado entre pessoa e sociedade."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, identificacao-de-pessoas-e-estruturas-societarias, registro-e-titularidade-de-bens"@pt-BR ;
  rdfs:subClassOf rec:VinculoEntrePessoas ;
  rdfs:subClassOf rec:Ativo ;
  skos:changeNote "AJ-82 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ASD R1 (lastro humano) lista participações societárias entre os tipos de ativo; sem esta aresta, medida de constrição, perdimento e avaliação não podem recair sobre uma participação. Sem metadado de sistema."@pt-BR ;
  skos:changeNote "AJ-420 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero (AJ-258) diz \"com identidade própria, datas e qualificação probatória\", mas as datas estavam repetidas nas filhas com o mesmo nome e tipo — dataDeInicio/dataDeFim em Divida, ParticipacaoEmProcesso, SancaoIndividual e VinculoEntrePessoas (DKC: \"dataDeInícioVigência / dataDeFimVigência\", identificacao-de-pessoas-e-estruturas-societarias-entidades.md) — e com outro nome em ParticipacaoSocietaria (dataDeEntrada/dataDeSaida, \"período de entrada/saída\"). Sobem para o gênero; FTM Ownership, Debt, Sanction, Succession e CourtCaseParty são todos Interval com startDate/endDate."@pt-BR ;
  skos:changeNote "AJ-421 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero (AJ-258) diz \"com identidade própria, datas e qualificação probatória\", mas as datas estavam repetidas nas filhas com o mesmo nome e tipo — dataDeInicio/dataDeFim em Divida, ParticipacaoEmProcesso, SancaoIndividual e VinculoEntrePessoas (DKC: \"dataDeInícioVigência / dataDeFimVigência\", identificacao-de-pessoas-e-estruturas-societarias-entidades.md) — e com outro nome em ParticipacaoSocietaria (dataDeEntrada/dataDeSaida, \"período de entrada/saída\"). Sobem para o gênero; FTM Ownership, Debt, Sanction, Succession e CourtCaseParty são todos Interval com startDate/endDate."@pt-BR ;
  skos:changeNote "AJ-426 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC registra, para o vínculo, \"proveniência — documento/base de origem\" e \"EXTRAÍDO_DE DocumentoFonte\" (identificacao-de-pessoas-e-estruturas-societarias-entidades.md); AssercaoDeTitularidade e ParticipacaoSocietaria já tinham COMPROVADA_POR (RegistroPublicoDeBem / DocumentoComprobatorio), e VinculoDeParentesco \"COMPROVADO_POR RegistroDeRegistroCivil\". É conteúdo do gênero: toda afirmação reificada tem o documento que a comprova. Sobe como COMPROVADA_POR Documento (gênero documental, que cobre registro público e documento comprobatório), com o alinhamento prov:hadPrimarySource que já existia; os pares específicos e o texto proveniencia ficam herdados. ASD R50: procedência de toda informação (base, processo, peça)."@pt-BR .

rec:PecaProcessual a owl:Class ;
  rdfs:label "PecaProcessual"@pt-BR ;
  rdfs:comment "Peça juntada a processo judicial — denúncia, pedido de medida assecuratória, manifestação, alegações finais, recurso, petição da defesa, despacho, decisão —, com autor, datas de elaboração e de juntada e nível de sigilo."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-132 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:Documento ;
  skos:changeNote "AJ-132 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC tramitação captura PeçaProcessual (tipo, data de elaboração, data de juntada, autor, nível de sigilo) com DecisãoJudicial como sua especialização e relações com processo, incidente e documentos anexos; nada disso chegou à DKD. ASD R20 e R50 pedem o vínculo da decisão e da procedência à \"peça\"."@pt-BR ;
  skos:changeNote "AJ-271 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Todo documento tem quem o emite — é o prov:wasAttributedTo (Entity → Agent) aplicado ao gênero. Três filhas já diziam isso cada uma a seu modo: DocumentoComprobatorio EMITIDO_POR AtorInstitucional (AJ-146, FIBO is issued by), ParecerJuridico EMITIDO_POR UnidadeDeAssessoriaJuridica (AJ-253) e PecaProcessual PRODUZIDA_POR Agente (AJ-138, prov:wasAttributedTo). A relação sobe para Documento → Agente com os dois alinhamentos e as três ficam herdadas; como o verbo é um só, os alcances específicos já se perdiam na união. DKC: \"órgão/serventia emissora\" do documento juntado (tramitacao-processual-e-decisoes-sobre-bens.md)."@pt-BR .

rec:PedidoDeCooperacaoJuridicaInternacional a owl:Class ;
  rdfs:label "PedidoDeCooperacaoJuridicaInternacional"@pt-BR ;
  rdfs:comment "Pedido entre jurisdições para informação ou execução de medida relacionada à recuperação de ativos."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, marco-normativo-e-instrumentos-juridicos-aplicaveis, movimentacao-financeira-e-capacidade-economica, pedidos-de-cooperacao-entre-jurisdicoes, registro-e-titularidade-de-bens, tramitacao-processual-e-decisoes-sobre-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  skos:changeNote "AJ-330 (2026-10-06, fonte: metadado): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Requerente/requerida é papel por pedido — a mesma jurisdição é solicitante num pedido e solicitada noutro —, então não cabe em atributo da jurisdição nem numa relação única. ENVOLVE \"consolidava origem, destino e envolvimento\" e perdia a direção. A DKC registra os dois papéis em três categorias: \"PedidoDeCooperação —ORIGINA_SE_EM→ Jurisdição\" e \"—DIRIGIDO_A→ Jurisdição\" (pedidos-de-cooperacao-entre-jurisdicoes-entidades.md), paisSolicitante/paisSolicitado (constricao) e, como metadado de sistema, os campos \"país solicitante/solicitado\" do SistemaDeTramitaçãoDeCooperação (marco-normativo). ASD R23 distingue pedido ativo e passivo. Mesmo desenho do AJ-104 para a autoridade central; explícito, e não inferido via AutoridadeCentral PERTENCE_A Jurisdição, porque a autoridade nem sempre está identificada."@pt-BR .

rec:Pessoa a owl:Class ;
  rdfs:label "Pessoa"@pt-BR ;
  rdfs:comment "Pessoa física ou jurídica envolvida em titularidades, vínculos, processos, pedidos ou buscas patrimoniais."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, identificacao-de-pessoas-e-estruturas-societarias, pedidos-de-cooperacao-entre-jurisdicoes, registro-e-titularidade-de-bens, tramitacao-processual-e-decisoes-sobre-bens"@pt-BR ;
  rdfs:subClassOf rec:Agente ;
  skos:changeNote "AJ-13 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): AtorInstitucional é tipado como prov:Agent e Pessoa está alinhada a PROV-O Agent e FOAF Agent. InstituicaoFinanceira já herda de ambas, o que mostra que pertencem a uma mesma categoria de agente."@pt-BR ;
  skos:changeNote "AJ-90 (2026-10-05, fonte: modelagem): Coloquei no local errado"@pt-BR ;
  skos:changeNote "AJ-345 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Pessoa QUALIFICADO_POR ListaRestritiva foi o atalho criado quando a lista era a única classe; a DKC já previa a entrada individual (\"DesignaçãoEmListaRestritiva —QUALIFICA→ Pessoa\", identificacao-de-pessoas-e-estruturas-societarias-entidades.md), que hoje é SancaoIndividual (SANCIONA Pessoa, CONSTA_EM ListaRestritiva, com datas, programa e status). O atalho duplica esse caminho e deixa QUALIFICADO_POR com dois sentidos; passa a valer só para StatusProbatorio."@pt-BR .

rec:PessoaFisica a owl:Class ;
  rdfs:label "PessoaFísica"@pt-BR ;
  rdfs:comment "Especialização de pessoa para pessoa natural."@pt-BR ;
  rec:proveniencia "DKC: identificacao-de-pessoas-e-estruturas-societarias, movimentacao-financeira-e-capacidade-economica, registro-e-titularidade-de-bens"@pt-BR ;
  rdfs:subClassOf rec:Pessoa ;
  skos:changeNote "AJ-494 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação. cpf e cnpj coexistem com IdentificadorDePessoa (tipoDeIdentificador = cadastro fiscal) e pareciam duplicata. Decisão: ficam, como atalho do identificador fiscal nacional — a DKC os descreve como \"chave primária de consulta\" das bases, e é por essa coluna que os dados reais chegam e que a resolução de identidade é feita (ASD R53). IdentificadorDePessoa fica para todos os demais (estrangeiro, registro mercantil, passaporte) e para o que precisa de emissor ou de sinalização de duplicidade. A descrição passa a dizer isso."@pt-BR .

rec:PessoaJuridica a owl:Class ;
  rdfs:label "PessoaJurídica"@pt-BR ;
  rdfs:comment "Especialização de pessoa para organizações com personalidade jurídica."@pt-BR ;
  rec:proveniencia "DKC: identificacao-de-pessoas-e-estruturas-societarias, movimentacao-financeira-e-capacidade-economica, registro-e-titularidade-de-bens"@pt-BR ;
  rdfs:subClassOf rec:Pessoa ;
  skos:changeNote "AJ-496 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação. cpf e cnpj coexistem com IdentificadorDePessoa (tipoDeIdentificador = cadastro fiscal) e pareciam duplicata. Decisão: ficam, como atalho do identificador fiscal nacional — a DKC os descreve como \"chave primária de consulta\" das bases, e é por essa coluna que os dados reais chegam e que a resolução de identidade é feita (ASD R53). IdentificadorDePessoa fica para todos os demais (estrangeiro, registro mercantil, passaporte) e para o que precisa de emissor ou de sinalização de duplicidade. A descrição passa a dizer isso."@pt-BR .

rec:PrazoDeResposta a owl:Class ;
  rdfs:label "PrazoDeResposta"@pt-BR ;
  rdfs:comment "Prazo associado ao atendimento, resposta ou andamento de pedido."@pt-BR ;
  rec:proveniencia "DKC: gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, pedidos-de-cooperacao-entre-jurisdicoes, tramitacao-processual-e-decisoes-sobre-bens"@pt-BR ;
  skos:changeNote "AJ-393 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: campoNoSistemaFormal (\"existência de campo próprio [requer pesquisa adicional]\") descreve a fonte, não o prazo: é a observação da DKC de que o controle de prazos vive em planilha paralela, sem campo no sistema de tramitação (pedidos-de-cooperacao-entre-jurisdicoes-entidades.md: ControleParaleloDePrazos). Esse fato pertence a SistemaDeInformacao.camposEstruturadosDisponiveis, não a cada prazo."@pt-BR ;
  skos:changeNote "AJ-394 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: tempoDecorrido era string, inútil para \"casos parados há mais de X tempo\" (ASD R56); passa a decimal em dias, como Jurisdição.tempoMedioDeResposta. DKC: \"tempo parado por caso\" (pedidos-de-cooperacao-entre-jurisdicoes-entidades.md)."@pt-BR ;
  skos:changeNote "AJ-398 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: origemDoPrazo (\"tratado, regra interna ou acordo\") nomeia em texto o elemento normativo que fixa o prazo. DKC: \"InstrumentoJurídicoInternacional —ESTABELECE→ PrazoDeRespostaPrevisto\" (pedidos-de-cooperacao-entre-jurisdicoes-entidades.md); regra interna é NormaNacional. A relação vai ao gênero ElementoNormativo, com o alinhamento já usado em FUNDAMENTA_SE_EM; o texto fica como recuo para acordo informal ou origem não identificada."@pt-BR .

rec:PrestadorDeServicosDeAtivosVirtuais a owl:Class ;
  rdfs:label "PrestadorDeServicosDeAtivosVirtuais"@pt-BR ;
  rdfs:comment "Pessoa jurídica que presta serviços de ativos virtuais (exchange de criptomoedas nacional ou internacional), custodiante de carteiras e do registro de identificação de clientes (KYC)."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-177 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:PessoaJuridica ;
  skos:changeNote "AJ-177 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC movimentação captura PrestadorDeServiçosDeAtivosVirtuais (exchange nacional ou internacional: denominação, jurisdição) como custodiante do registro KYC e acessado por cooperação; ASD R45 pede o consumo de dados KYC de exchanges. Denominação e jurisdição já vêm de PessoaJurídica."@pt-BR .

rec:ProcessoJudicial a owl:Class ;
  rdfs:label "ProcessoJudicial"@pt-BR ;
  rdfs:comment "Processo em que se registram partes, decisões, medidas, incidentes e referências a ativos."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, registro-e-titularidade-de-bens, tramitacao-processual-e-decisoes-sobre-bens"@pt-BR ;
  skos:changeNote "AJ-153 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Redundante desde o AJ-141 (DecisaoJudicial ⊂ PecaProcessual): ProcessoJudicial CONTÉM PecaProcessual já cobre a decisão. Mesmo alinhamento PROV-O hadMember no par genérico."@pt-BR ;
  skos:changeNote "AJ-400 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: identificadorNacionalDeReuOuBem (\"identificador transversal ausente\") registra uma lacuna de dado da DKC (\"ausente (lacuna apontada)\"), não um atributo do processo: o identificador do réu é IdentificadorDePessoa e o do bem é Ativo.identificadorDoAtivo (ASD R2). Como atributo do processo não tem o que receber."@pt-BR ;
  skos:changeNote "AJ-401 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: juizoOuVara (\"juízo ou vara de tramitação\") duplica É_CONDUZIDO_POR OrgaoJudicial (FTM CourtCase.court), que já traz comarcaOuSecao, instancia e esferaECompetencia. Mesmo tratamento dado a organizacaoEmissora, jurisdicaoDeEmissao e pais: texto vira relação."@pt-BR ;
  skos:changeNote "AJ-402 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC tramitação: \"situação de trânsito em julgado (existência e data)\" — dois fatos num só texto. Passa a dataDoTransitoEmJulgado (dateTime): a existência é a presença da data. O nome é o da DKC em DecretoDePerdimento (dataDoTransitoEmJulgado). DecisaoJudicial.transitoEmJulgado fica para a revisão daquela classe."@pt-BR ;
  skos:changeNote "AJ-510 (2026-10-06, fonte: metadado): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação com metadado real: o campo estava \"[requer pesquisa adicional]\". No DataJud (CNJ) todo processo traz classe (código e nome) e assuntos (lista de código e nome), ambos das Tabelas Processuais Unificadas do CNJ. A lacuna de estrutura está resolvida; o atributo continua um texto único — separar classe de assuntos é decisão para o DSMI, com a amostra."@pt-BR .

rec:ProcuracaoPublica a owl:Class ;
  rdfs:label "ProcuracaoPublica"@pt-BR ;
  rdfs:comment "Procuração lavrada em tabelionato de notas pela qual o outorgante confere poderes ao outorgado para atos sobre pessoa, sociedade ou bens. Poderes conferidos e prazo: [requer pesquisa adicional]."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-211 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:AtoNotarial ;
  skos:changeNote "AJ-211 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC registro-e-titularidade, literal: \"ProcuraçãoPública (subclasse de AtoNotarial): outorgante / outorgado\"; R39 (procurações, CENSEC) tem lastro humano. Preenche a lacuna externa FTM Representation / FIBO legal agent mantida no ORR."@pt-BR .

rec:RedeDeCooperacaoInternacional a owl:Class ;
  rdfs:label "RedeDeCooperacaoInternacional"@pt-BR ;
  rdfs:comment "Rede internacional ou interinstitucional usada como canal complementar de cooperação."@pt-BR ;
  rec:proveniencia "DKC: gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, marco-normativo-e-instrumentos-juridicos-aplicaveis, pedidos-de-cooperacao-entre-jurisdicoes"@pt-BR ;
  rdfs:subClassOf rec:AtorInstitucional ;
  skos:changeNote "AJ-15 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): A rede congrega autoridades centrais e unidades de inteligência financeira e está alinhada a ORG OrganizationalCollaboration, que é um tipo de organização. AtorInstitucional também está alinhado a ORG Organization."@pt-BR ;
  skos:changeNote "AJ-98 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Duplica AtorInstitucional.denominacao, herdado desde o AJ-15."@pt-BR ;
  skos:changeNote "AJ-116 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: CARIN, RRAG e ENCLA (ASD R46) congregam também órgãos de acusação, judiciais e policiais; o destino generaliza de AutoridadeCentral e UnidadeDeInteligenciaFinanceira para AtorInstitucional, um par no lugar de dois, mantendo ORG hasMember."@pt-BR ;
  skos:changeNote "AJ-117 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: CARIN, RRAG e ENCLA (ASD R46) congregam também órgãos de acusação, judiciais e policiais; o destino generaliza de AutoridadeCentral e UnidadeDeInteligenciaFinanceira para AtorInstitucional, um par no lugar de dois, mantendo ORG hasMember."@pt-BR .

rec:RegistroDeIdentificacaoDeCliente a owl:Class ;
  rdfs:label "RegistroDeIdentificacaoDeCliente"@pt-BR ;
  rdfs:comment "Registro de identificação de cliente (KYC) mantido por prestador de serviços de ativos virtuais, que liga a pessoa identificada às carteiras e criptoativos que ela movimenta. Campos próprios: [requer pesquisa adicional]."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-179 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:Documento ;
  skos:changeNote "AJ-179 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC movimentação: RegistroDeIdentificaçãoDeCliente (KYC) custodiado pelo prestador, que IDENTIFICA PessoaFísica e VINCULA Criptoativo — é o único elo entre a carteira e a pessoa; ASD R45. Campos próprios: [requer pesquisa adicional]."@pt-BR .

rec:RegistroPublicoDeBem a owl:Class ;
  rdfs:label "RegistroPublicoDeBem"@pt-BR ;
  rdfs:comment "Registro público que identifica ou referencia bem e seus elementos registrais."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, registro-e-titularidade-de-bens"@pt-BR ;
  rdfs:subClassOf rec:Documento ;
  skos:changeNote "AJ-34 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): Todas são tipadas como prov:Entity e definidas como declaração, extrato, documento, dossiê, comunicação ou registro, ou seja, aquilo que fica escrito. Há alinhamentos de apoio: FTM Document, FTM Message e FIBO account statement."@pt-BR ;
  skos:changeNote "AJ-160 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Inverso redundante de Ativo REGISTRADO_EM RegistroPublicoDeBem, sem alinhamento próprio; REFERE_SE_A já é o verbo mais sobrecarregado da ontologia."@pt-BR .

rec:RelacaoReificada a owl:Class ;
  rdfs:label "RelacaoReificada"@pt-BR ;
  rdfs:comment "Afirmação ou relação reificada — com identidade própria, datas e qualificação probatória — que liga pessoas entre si, pessoas a ativos, pessoas a processos ou ativos entre si, caracterizada por tipo do vínculo, da titularidade, do evento ou do papel e grau de confiança ou comprovação."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-258 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-35 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): AssercaoDeTitularidade é 'afirmação reificada de titularidade' e VinculoEntrePessoas é 'relação reificada entre pessoas'. Ambas usam relações de ligação (LIGA; TEM_ORIGEM/TEM_DESTINO), e as alinhadas a FTM Ownership ficam reunidas."@pt-BR ;
  skos:changeNote "AJ-258 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: RelacaoReificada (AJ-35) foi definida para \"pessoas entre si ou pessoas a ativos\", mas o padrão que a justifica — relação com identidade própria, datas e qualificação por StatusProbatorio (QUALIFICADO_POR) — é o mesmo de SucessaoDeEntidade (PJ ↔ PJ), SubRogacaoDeAtivo (ativo ↔ ativo) e ParticipacaoEmProcesso (pessoa ↔ processo). A definição passa a cobrir também ativos entre si e pessoas a processos; as três entram como subclasses e herdam QUALIFICADO_POR."@pt-BR .

rec:RelatorioDeInteligenciaFinanceira a owl:Class ;
  rdfs:label "RelatorioDeInteligenciaFinanceira"@pt-BR ;
  rdfs:comment "Relatório de inteligência financeira (RIF) produzido por unidade de inteligência financeira a partir de comunicações e dados de movimentação, veiculado ao processo como peça ou anexo. Demais atributos: [requer pesquisa adicional]."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-109 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:Documento ;
  skos:changeNote "AJ-109 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura a UnidadeDeInteligenciaFinanceira como \"produtora de relatório de inteligência financeira\" e o RIF como peça anexada ao processo, mas o relatório não tinha classe. formaDeEntrega (\"forma de entrega do produto\") é do relatório, não da unidade."@pt-BR .

rec:Repatriacao a owl:Class ;
  rdfs:label "Repatriacao"@pt-BR ;
  rdfs:comment "Retorno de ativo ou valor de outra jurisdição como resultado do fluxo de recuperação."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos"@pt-BR ;
  rdfs:subClassOf rec:Destinacao ;
  skos:changeNote "AJ-189 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC constrição, literal: \"Repatriação —MODALIDADE_DE→ Destinação\"; Destinacao.modalidade inclui \"partilha\" e EnteDestinatario.tipoDeDestinatario inclui \"ente estrangeiro em partilha internacional\" (ASD R22). Subclasse no lugar da relação MATERIALIZA_SE_EM."@pt-BR ;
  skos:changeNote "AJ-191 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Com Repatriacao ⊂ Destinacao, dataDeRetorno duplica dataDeEfetivacao, herdado."@pt-BR ;
  skos:changeNote "AJ-192 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: paisDeOrigem era texto livre; a classe Jurisdição existe e já recebe LOCALIZADO_EM (Ativo) e PERTENCE_A (AtorInstitucional). Mesmo tratamento."@pt-BR ;
  skos:changeNote "AJ-242 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Com Repatriacao ⊂ Destinacao (AJ-189), TRANSFERE Ativo duplica Destinacao DESTINA Ativo, herdado. A DKC tinha as duas porque Repatriação era classe à parte (MODALIDADE_DE)."@pt-BR ;
  skos:changeNote "AJ-243 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Com Repatriacao ⊂ Destinacao, RESULTA_DE DecretoDePerdimento (FIBO is caused by) é a inversa exata de DecretoDePerdimento HABILITA Destinacao (FIBO causes), herdada. Mesma informação nos dois sentidos."@pt-BR .

rec:RequisitoDeAdmissibilidade a owl:Class ;
  rdfs:label "RequisitoDeAdmissibilidade"@pt-BR ;
  rdfs:comment "Pressuposto de admissibilidade do pedido de cooperação, avaliável antes do mérito — por exemplo, dupla incriminação (a conduta deve ser crime em ambos os Estados) —, com o efeito do não atendimento (travamento, devolução ou saneamento). Instrumentos em que é exigido ou dispensado e registro estruturado da verificação: [requer pesquisa adicional]."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-379 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:RequisitoDeCooperacao ;
  skos:changeNote "AJ-379 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC marco normativo: \"RequisitoDeAdmissibilidade: denominação (ex.: dupla incriminação), definição (conduta deve ser crime em ambos os Estados), efeitoDoNãoAtendimento (travamento, devolução/saneamento); CONDICIONA Pedido; Instrumento DEFINE RequisitoDeAdmissibilidade\". ASD R31: dupla incriminação e demais pressupostos de admissibilidade como condição avaliável do pedido. Distinto de RequisitoFormal (tradução, apostilamento): é pressuposto de mérito. Gênero comum com RequisitoFormal fica para a revisão deste."@pt-BR ;
  skos:changeNote "AJ-437 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: RequisitoFormal (tradução, apostilamento, formato — ASD R29) e RequisitoDeAdmissibilidade (dupla incriminação — ASD R31, AJ-379) são as duas espécies do que um pedido de cooperação precisa satisfazer, e já compartilhavam duas relações: ambos DEFINE por InstrumentoJuridicoDeCooperacao e ambos GERA MotivoDeSaneamentoOuDevolucao quando descumpridos (DKC marco normativo: \"RequisitoFormal —É_EXIGIDO_POR→ Instrumento\", \"RequisitoDeAdmissibilidade … instrumentosEmQueÉExigidoOuDispensado\", \"RequisitoFormal —QUANDO_DESCUMPRIDO_GERA→ Motivo\"). Gênero com conteúdo: as duas relações sobem e os quatro pares viram dois. IMPÕE (Jurisdição) fica em RequisitoFormal — a DKC só o registra para a exigência formal."@pt-BR ;
  skos:changeNote "AJ-443 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: RequisitoFormal (tradução, apostilamento, formato — ASD R29) e RequisitoDeAdmissibilidade (dupla incriminação — ASD R31, AJ-379) são as duas espécies do que um pedido de cooperação precisa satisfazer, e já compartilhavam duas relações: ambos DEFINE por InstrumentoJuridicoDeCooperacao e ambos GERA MotivoDeSaneamentoOuDevolucao quando descumpridos (DKC marco normativo: \"RequisitoFormal —É_EXIGIDO_POR→ Instrumento\", \"RequisitoDeAdmissibilidade … instrumentosEmQueÉExigidoOuDispensado\", \"RequisitoFormal —QUANDO_DESCUMPRIDO_GERA→ Motivo\"). Gênero com conteúdo: as duas relações sobem e os quatro pares viram dois. IMPÕE (Jurisdição) fica em RequisitoFormal — a DKC só o registra para a exigência formal."@pt-BR .

rec:RequisitoDeCooperacao a owl:Class ;
  rdfs:label "RequisitoDeCooperacao"@pt-BR ;
  rdfs:comment "Exigência que um pedido de cooperação jurídica internacional deve satisfazer para ser recebido e cumprido — formal, sobre os documentos que o instruem, ou de admissibilidade, sobre o mérito —, definida por instrumento de cooperação ou imposta pela jurisdição requerida; descumprida, gera motivo de saneamento ou devolução."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-435 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-435 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: RequisitoFormal (tradução, apostilamento, formato — ASD R29) e RequisitoDeAdmissibilidade (dupla incriminação — ASD R31, AJ-379) são as duas espécies do que um pedido de cooperação precisa satisfazer, e já compartilhavam duas relações: ambos DEFINE por InstrumentoJuridicoDeCooperacao e ambos GERA MotivoDeSaneamentoOuDevolucao quando descumpridos (DKC marco normativo: \"RequisitoFormal —É_EXIGIDO_POR→ Instrumento\", \"RequisitoDeAdmissibilidade … instrumentosEmQueÉExigidoOuDispensado\", \"RequisitoFormal —QUANDO_DESCUMPRIDO_GERA→ Motivo\"). Gênero com conteúdo: as duas relações sobem e os quatro pares viram dois. IMPÕE (Jurisdição) fica em RequisitoFormal — a DKC só o registra para a exigência formal."@pt-BR .

rec:RequisitoFormal a owl:Class ;
  rdfs:label "RequisitoFormal"@pt-BR ;
  rdfs:comment "Exigência formal imposta por jurisdição ou instrumento de cooperação."@pt-BR ;
  rec:proveniencia "DKC: gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, marco-normativo-e-instrumentos-juridicos-aplicaveis, pedidos-de-cooperacao-entre-jurisdicoes"@pt-BR ;
  rdfs:subClassOf rec:RequisitoDeCooperacao ;
  skos:changeNote "AJ-436 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: RequisitoFormal (tradução, apostilamento, formato — ASD R29) e RequisitoDeAdmissibilidade (dupla incriminação — ASD R31, AJ-379) são as duas espécies do que um pedido de cooperação precisa satisfazer, e já compartilhavam duas relações: ambos DEFINE por InstrumentoJuridicoDeCooperacao e ambos GERA MotivoDeSaneamentoOuDevolucao quando descumpridos (DKC marco normativo: \"RequisitoFormal —É_EXIGIDO_POR→ Instrumento\", \"RequisitoDeAdmissibilidade … instrumentosEmQueÉExigidoOuDispensado\", \"RequisitoFormal —QUANDO_DESCUMPRIDO_GERA→ Motivo\"). Gênero com conteúdo: as duas relações sobem e os quatro pares viram dois. IMPÕE (Jurisdição) fica em RequisitoFormal — a DKC só o registra para a exigência formal."@pt-BR ;
  skos:changeNote "AJ-442 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: RequisitoFormal (tradução, apostilamento, formato — ASD R29) e RequisitoDeAdmissibilidade (dupla incriminação — ASD R31, AJ-379) são as duas espécies do que um pedido de cooperação precisa satisfazer, e já compartilhavam duas relações: ambos DEFINE por InstrumentoJuridicoDeCooperacao e ambos GERA MotivoDeSaneamentoOuDevolucao quando descumpridos (DKC marco normativo: \"RequisitoFormal —É_EXIGIDO_POR→ Instrumento\", \"RequisitoDeAdmissibilidade … instrumentosEmQueÉExigidoOuDispensado\", \"RequisitoFormal —QUANDO_DESCUMPRIDO_GERA→ Motivo\"). Gênero com conteúdo: as duas relações sobem e os quatro pares viram dois. IMPÕE (Jurisdição) fica em RequisitoFormal — a DKC só o registra para a exigência formal."@pt-BR ;
  skos:changeNote "AJ-444 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: origemDaExigencia (\"instrumento ou norma da jurisdição\") nomeia em texto o que IMPÕE (Jurisdição) e DEFINE (Instrumento) já dizem como relação — duplicata anotada desde a revisão de ElementoNormativo."@pt-BR .

rec:RespostaDeCooperacao a owl:Class ;
  rdfs:label "RespostaDeCooperacao"@pt-BR ;
  rdfs:comment "Resposta recebida de autoridade ou jurisdição em decorrência de pedido de cooperação."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, pedidos-de-cooperacao-entre-jurisdicoes, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:Correspondencia ;
  skos:changeNote "AJ-273 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A resposta de cooperação é uma comunicação recebida: a DKC a registra \"REGISTRADA_EM CaixaDeEmailInstitucional\" e \"EMITIDA_POR AutoridadeCentral (requerida no exterior)\", e Correspondencia é \"comunicação do fluxo, como e-mail, ofício ou nota verbal\", com ENVIADA_POR / DIRIGIDA_A AutoridadeCentral (FTM Message.sender/recipients). Os atributos coincidem — dataDeRecebimento, conteúdo —, sinal de que é espécie, não irmã. Herda remetente, destinatário, conteúdo, tipo e datas."@pt-BR ;
  skos:changeNote "AJ-274 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Com RespostaDeCooperacao ⊂ Correspondencia, dataDeRecebimento é herdado (mesmo nome e tipo)."@pt-BR ;
  skos:changeNote "AJ-275 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Com RespostaDeCooperacao ⊂ Correspondencia, conteudoSubstantivo duplica o conteudo herdado (\"conteúdo textual da comunicação\"). Marco visível, terminologia de origem e referência estrangeira continuam como atributos próprios."@pt-BR ;
  skos:changeNote "AJ-276 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Jurisdição respondente como texto duplica a classe Jurisdição; vira a relação PROVENIENTE_DE já usada em Repatriacao. Explícita, e não inferida via ENVIADA_POR AutoridadeCentral PERTENCE_A Jurisdição, porque a resposta muitas vezes chega sem a autoridade identificada (DKC: fluxo \"caixa preta\"). ASD R56 pede tempo médio de resposta por país."@pt-BR .

rec:RestricaoOuOnusSobreBem a owl:Class ;
  rdfs:label "RestricaoOuOnusSobreBem"@pt-BR ;
  rdfs:comment "Ônus real, gravame ou restrição administrativa que incide sobre um ativo e limita sua disponibilidade ou o valor livre que ele representa — hipoteca, penhor, usufruto, alienação fiduciária, restrição de órgão de trânsito —, em favor de um beneficiário quando houver, com tipo, data inicial e situação. Não abrange as medidas decretadas pelo juízo no caso (MedidaDeConstricao)."@pt-BR ;
  rec:proveniencia "DKC: registro-e-titularidade-de-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-446 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-312 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação. A lista da DKC (\"ônus, indisponibilidade, constrição judicial, restrição administrativa\") foi capturada antes de existir MedidaDeConstricao com suas espécies (AJ-66 a AJ-70, AJ-185): indisponibilidade e constrição judicial são medidas, não ônus — o que fica aqui é o ônus real e a restrição administrativa, e o atributo vale só quando não houver subclasse específica."@pt-BR ;
  skos:changeNote "AJ-446 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: A definição da DKD (\"restrição, ônus ou gravame que incide sobre ativo\") ficou mais larga que a classe: desde AJ-312 a indisponibilidade e a constrição judicial decretadas no caso são MedidaDeConstricao, e as espécies daqui são AverbacaoDeOnus e AlienacaoFiduciaria (AJ-306, AJ-309). A definição passa a dizer o que a classe é hoje — o ônus real, o gravame e a restrição administrativa que o analista encontra no registro do bem (DKC registro-e-titularidade: tipoDeRestrição, AverbaçãoDeÔnus, AlienaçãoFiduciária; Veículo OBJETO_DE RestriçãoOuÔnusSobreBem; aeronave \"ônus/gravames\"; embarcação \"hipotecaOuÔnus\") — e a fronteira com a medida. DECORRE_DE ProcessoJudicial permanece para o gravame de origem judicial alheio ao caso (ex.: penhora de terceiro averbada na matrícula), de que só se conhece o número do processo."@pt-BR .

rec:SancaoIndividual a owl:Class ;
  rdfs:label "SancaoIndividual"@pt-BR ;
  rdfs:comment "[adicionado no EOA — iteração à DKD a partir de lacuna externa mantida no ORR] Registro de sanção ou restrição imposta a uma pessoa por uma autoridade, sob um programa, com motivo, datas e status; é a entrada individual de uma ListaRestritiva, que até aqui só existia como lista. Origem: FollowTheMoney Sanction (entity, authority, program, reason, startDate, endDate, status)."@pt-BR ;
  rec:proveniencia "adicionado manualmente na revisão humana da DKD"@pt-BR ;
  rdfs:subClassOf rec:RelacaoReificada ;
  skos:changeNote "AJ-346 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: SancaoIndividual liga uma pessoa a uma lista com datas de início e fim, programa e status — o padrão de RelacaoReificada (AJ-258); no FollowTheMoney, Sanction é Interval como Debt e Succession. Herda QUALIFICADO_POR StatusProbatorio, que é exatamente o \"resultadoDoCruzamento — correspondência confirmada, provável, descartada\" da DKC (identificacao-de-pessoas-e-estruturas-societarias-entidades.md): a designação é da lista, a amarração à nossa Pessoa é probabilística."@pt-BR ;
  skos:changeNote "AJ-416 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero (AJ-258) diz \"com identidade própria, datas e qualificação probatória\", mas as datas estavam repetidas nas filhas com o mesmo nome e tipo — dataDeInicio/dataDeFim em Divida, ParticipacaoEmProcesso, SancaoIndividual e VinculoEntrePessoas (DKC: \"dataDeInícioVigência / dataDeFimVigência\", identificacao-de-pessoas-e-estruturas-societarias-entidades.md) — e com outro nome em ParticipacaoSocietaria (dataDeEntrada/dataDeSaida, \"período de entrada/saída\"). Sobem para o gênero; FTM Ownership, Debt, Sanction, Succession e CourtCaseParty são todos Interval com startDate/endDate."@pt-BR ;
  skos:changeNote "AJ-417 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero (AJ-258) diz \"com identidade própria, datas e qualificação probatória\", mas as datas estavam repetidas nas filhas com o mesmo nome e tipo — dataDeInicio/dataDeFim em Divida, ParticipacaoEmProcesso, SancaoIndividual e VinculoEntrePessoas (DKC: \"dataDeInícioVigência / dataDeFimVigência\", identificacao-de-pessoas-e-estruturas-societarias-entidades.md) — e com outro nome em ParticipacaoSocietaria (dataDeEntrada/dataDeSaida, \"período de entrada/saída\"). Sobem para o gênero; FTM Ownership, Debt, Sanction, Succession e CourtCaseParty são todos Interval com startDate/endDate."@pt-BR .

rec:SequestroDeBens a owl:Class ;
  rdfs:label "SequestroDeBens"@pt-BR ;
  rdfs:comment "Medida assecuratória que recai sobre bens adquiridos com os proventos da infração, ainda que já transferidos a terceiro. Sentido patrimonial: não se confunde com sequestro de pessoa."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-66 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:MedidaDeConstricao ;
  skos:changeNote "AJ-66 (2026-10-05, fonte: norma): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ASD R15 pede medida assecuratória como gênero com espécies e R9 (lastro humano) pede a desambiguação do sentido patrimonial; a DKD só registra as espécies como texto de tipoDeMedida. Norma: CPP, arts. 125 a 133."@pt-BR .

rec:SistemaDeInformacao a owl:Class ;
  rdfs:label "SistemaDeInformacao"@pt-BR ;
  rdfs:comment "Fonte de dados do domínio — sistema, base, cadastro, central, planilha, caixa de correio ou repositório — que armazena, organiza ou fornece dados, descrita por nome oficial, tipo de artefato, grau de estruturação, forma de acesso, cobertura e periodicidade de atualização, e mantida por um ator institucional. É o alvo das consultas (ConsultaAFonte) e o lugar onde pedidos, processos e atos ficam registrados."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, identificacao-de-pessoas-e-estruturas-societarias, movimentacao-financeira-e-capacidade-economica, registro-e-titularidade-de-bens, tramitacao-processual-e-decisoes-sobre-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-515 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-464 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: A definição da DKD não deixava ver que a classe é o catálogo de fontes de dados, e não só software: a DKC a descreve como \"classe genérica para sistema corporativo, planilha paralela, caixa de e-mail institucional, pasta de dossiê, repositório de tratados\" (gestão de carteira) e lista em tipoDeBase \"cadastro fiscal, registro público mercantil, central de atos notariais, base de inteligência financeira, sistema de processo eletrônico, registro societário estrangeiro, lista restritiva, planilha/dossiê de trabalho\" (identificação). A nova redação explicita esse alcance — que é o que justifica ListaRestritiva como espécie (AJ-341) — e o papel da classe: ser o alvo de ConsultaAFonte e de REGISTRADO_EM."@pt-BR ;
  skos:changeNote "AJ-515 (2026-10-06, fonte: especialista): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: Com ListaRestritiva fora da subárvore, a definição deixa de citar \"lista\" entre as fontes que a classe cobre."@pt-BR .

rec:StatusProbatorio a owl:Class ;
  rdfs:label "StatusProbatorio"@pt-BR ;
  rdfs:comment "Qualificação atribuída a uma afirmação — vínculo, titularidade, indício, ativo localizado, resultado de consulta ou de avaliação — em duas dimensões: o grau de certeza do analista (confirmado, provável, hipótese, descartada) e o estágio probatório no processo (alegação, indício, conclusão pericial, decisão transitada em julgado), com data de atribuição, justificativa e o documento que a fundamenta."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, movimentacao-financeira-e-capacidade-economica"@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-472 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-465 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura duas escalas diferentes sob o mesmo nome, e a DKD as fundiu num atributo só (\"confirmado, provável, hipótese ou estágio probatório equivalente\"). Constrição: \"valor — confirmado / provável / hipótese\" — o quanto o analista confia na afirmação. Movimentação financeira: \"grau de certeza (alegação, indício, conclusão pericial, decisão transitada em julgado)\" — em que ponto do processo a afirmação está. O ASD R49 pede as duas como coisas distintas: \"grau de confiança e de status probatório (alegação, indício, conclusão pericial, decisão transitada em julgado)\" [lastro apenas sintético — requer validação humana]. Uma titularidade pode ser \"confirmada\" pelo analista e ainda ser só \"alegação\" nos autos. grauDeCerteza fica com a primeira escala e estagioProbatorio recebe a segunda."@pt-BR ;
  skos:changeNote "AJ-468 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: hipoteseDescartada (booleano) duplicava a escala: descartada é um valor do grau de certeza, ao lado de confirmado, provável e hipótese — e a razão do descarte já tem lugar em justificativa. Dois campos permitiam o estado contraditório \"confirmado\" com hipoteseDescartada verdadeiro. ASD R52 (registrar a hipótese verificada e afastada) continua atendido pelo valor \"descartada\"."@pt-BR ;
  skos:changeNote "AJ-469 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: DKC movimentação: \"data de atribuição\"; a DKC de constrição a chama de dataDeCorte. Desde AJ-451 dataDeCorte tem sentido preciso — a data de referência do resultado de uma consulta (ConsultaAFonte, DossieDeBuscaPatrimonial). No status, o que se registra é quando a qualificação foi atribuída; com nome próprio os dois não se confundem."@pt-BR ;
  skos:changeNote "AJ-472 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura duas escalas diferentes sob o mesmo nome, e a DKD as fundiu num atributo só (\"confirmado, provável, hipótese ou estágio probatório equivalente\"). Constrição: \"valor — confirmado / provável / hipótese\" — o quanto o analista confia na afirmação. Movimentação financeira: \"grau de certeza (alegação, indício, conclusão pericial, decisão transitada em julgado)\" — em que ponto do processo a afirmação está. O ASD R49 pede as duas como coisas distintas: \"grau de confiança e de status probatório (alegação, indício, conclusão pericial, decisão transitada em julgado)\" [lastro apenas sintético — requer validação humana]. Uma titularidade pode ser \"confirmada\" pelo analista e ainda ser só \"alegação\" nos autos. grauDeCerteza fica com a primeira escala e estagioProbatorio recebe a segunda."@pt-BR .

rec:SubRogacaoDeAtivo a owl:Class ;
  rdfs:label "SubRogacaoDeAtivo"@pt-BR ;
  rdfs:comment "Conversão reificada de um ativo em outro na cadeia de sub-rogação (bem originário → conversões sucessivas → forma atual), com data e valor da conversão. Origem é o bem convertido; destino, o bem resultante."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-161 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:RelacaoReificada ;
  skos:changeNote "AJ-161 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC tramitação: \"posição na cadeia de sub-rogação (bem originário → conversões → bem atual)\" e relação Bem SUB_ROGA Bem; DKC constrição registra \"cadeia de sub-rogação\" como campo ausente nos controles; ASD R17/R18 pedem a cadeia com data e valor de cada conversão. Reificada para carregar data e valor."@pt-BR ;
  skos:changeNote "AJ-260 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: RelacaoReificada (AJ-35) foi definida para \"pessoas entre si ou pessoas a ativos\", mas o padrão que a justifica — relação com identidade própria, datas e qualificação por StatusProbatorio (QUALIFICADO_POR) — é o mesmo de SucessaoDeEntidade (PJ ↔ PJ), SubRogacaoDeAtivo (ativo ↔ ativo) e ParticipacaoEmProcesso (pessoa ↔ processo). A definição passa a cobrir também ativos entre si e pessoas a processos; as três entram como subclasses e herdam QUALIFICADO_POR."@pt-BR .

rec:SucessaoDeEntidade a owl:Class ;
  rdfs:label "SucessaoDeEntidade"@pt-BR ;
  rdfs:comment "[adicionado no EOA — iteração à DKD a partir de lacuna externa mantida no ORR] Evento de fusão, cisão, incorporação ou reestruturação que liga uma ou mais pessoas jurídicas originais às resultantes; permite seguir a cadeia de empresas sucessoras. Origem: FollowTheMoney Succession (predecessor, successor, startDate, endDate) e W3C ORG ChangeEvent (originalOrganization, resultingOrganization)."@pt-BR ;
  rec:proveniencia "adicionado manualmente na revisão humana da DKD"@pt-BR ;
  rdfs:subClassOf rec:RelacaoReificada ;
  skos:changeNote "AJ-259 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: RelacaoReificada (AJ-35) foi definida para \"pessoas entre si ou pessoas a ativos\", mas o padrão que a justifica — relação com identidade própria, datas e qualificação por StatusProbatorio (QUALIFICADO_POR) — é o mesmo de SucessaoDeEntidade (PJ ↔ PJ), SubRogacaoDeAtivo (ativo ↔ ativo) e ParticipacaoEmProcesso (pessoa ↔ processo). A definição passa a cobrir também ativos entre si e pessoas a processos; as três entram como subclasses e herdam QUALIFICADO_POR."@pt-BR .

rec:TabelionatoDeNotas a owl:Class ;
  rdfs:label "TabelionatoDeNotas"@pt-BR ;
  rdfs:comment "Serventia extrajudicial responsavel por lavrar atos notariais (escrituras, procuracoes e afins)."@pt-BR ;
  rec:proveniencia "adicionado manualmente na revisão humana da DKD"@pt-BR ;
  rdfs:subClassOf rec:AtorInstitucional .

rec:TaxaDeCambioHistorica a owl:Class ;
  rdfs:label "TaxaDeCambioHistorica"@pt-BR ;
  rdfs:comment "Taxa de câmbio aplicável à conversão de valores em determinada data."@pt-BR ;
  rec:proveniencia "DKC: movimentacao-financeira-e-capacidade-economica, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  skos:changeNote "AJ-474 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: DKC valoração: \"TaxaDeCâmbioHistórica —FORNECIDA_POR→ ProvedorDeTaxasDeCâmbioOficiais\", provedor descrito por \"moedas cobertas, forma de integração e nível de acesso\"; DKC movimentação: \"base externa desejada, inexistente no pipeline\", \"É_TIPO_DE FonteDeDadosFinanceiros\". A DKD reduziu isso ao texto fonteOficial (\"fonte oficial a adotar [requer pesquisa adicional]\"). O provedor é uma fonte de dados — exatamente SistemaDeInformacao, que já tem nivelDeAcesso, existenciaDeIntegracao, periodicidadeDeAtualizacao e OPERADO_POR AtorInstitucional. A relação substitui o texto: a fonte da taxa passa a ser catalogada uma vez e pode ser alvo de ConsultaAFonte. Qual fonte oficial adotar continua [requer pesquisa adicional] — a lacuna agora é de instância, não de estrutura. ASD R73 (taxa de câmbio histórica vinculada à data do documento) [lastro apenas sintético — requer validação humana]."@pt-BR .

rec:TipoPenal a owl:Class ;
  rdfs:label "TipoPenal"@pt-BR ;
  rdfs:comment "Figura típica prevista em lei penal, brasileira ou estrangeira, em que um fato criminoso se enquadra. Atributos próprios: [requer pesquisa adicional]."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-85 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:ElementoNormativo ;
  skos:changeNote "AJ-85 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ASD R11 (vínculo entre o ativo e a condenação/fato criminoso, hoje só o texto de Ativo.nexoCausal) e R13 (tipificação penal no escopo), ambos com lastro humano. O ASD registra divergência com os perfis sintéticos, que deixariam a tipificação fora; pela hierarquia de evidência do método prevalece a resposta humana, pendente de validação por especialistas. Sem metadado de sistema: atributos [requer pesquisa adicional]."@pt-BR ;
  skos:changeNote "AJ-257 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição de ElementoNormativo (\"norma, dispositivo ou instrumento jurídico que regula ou fundamenta medidas, decisões, perdimento ou cooperação\") já contém o tipo penal — figura prevista em lei penal (AJ-85) — que ficou na raiz por omissão ao ser criado. Gênero com três espécies e conteúdo próprio, não gaveta."@pt-BR .

rec:TratadoBilateralDeAssistenciaJuridicaMutua a owl:Class ;
  rdfs:label "TratadoBilateralDeAssistenciaJuridicaMutua"@pt-BR ;
  rdfs:comment "Tratado bilateral de assistência jurídica mútua (MLAT) entre o Brasil e outra jurisdição, com prazo, formato e requisitos próprios; a jurisdição contraparte é dada por VINCULA. Lista completa por país: [requer pesquisa adicional]."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-294 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:InstrumentoJuridicoDeCooperacao ;
  skos:changeNote "AJ-294 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: \"InstrumentoJurídicoDeCooperação —ESPECIALIZA_SE_EM→ ConvençãoMultilateral / TratadoBilateralDeAssistênciaJurídicaMútua / BaseDeCooperaçãoPorReciprocidade\", cada uma com atributos próprios (marco-normativo-e-instrumentos-juridicos-aplicaveis-entidades.md). ASD R46 nomeia UNCAC, Palermo, OEA e MLATs; R25 põe o instrumento como determinante da via. O atributo tipoDeInstrumento passa a valer só quando não houver subclasse específica — mesma regra de Ativo.tipoDeAtivo e AtorInstitucional.tipoDeAtor."@pt-BR .

rec:UnidadeDeAssessoriaJuridica a owl:Class ;
  rdfs:label "UnidadeDeAssessoriaJuridica"@pt-BR ;
  rdfs:comment "Unidade especializada em análise jurídica de perdimento, destinação ou cooperação."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, marco-normativo-e-instrumentos-juridicos-aplicaveis, pedidos-de-cooperacao-entre-jurisdicoes, tramitacao-processual-e-decisoes-sobre-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:UnidadeOrganizacional ;
  skos:changeNote "AJ-54 (2026-10-05, fonte: ontologia_externa): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: As unidades internas repetem o mesmo atributo único (atribuicao) e têm o mesmo par mantido no ORR (ORG OrganizationalUnit: \"unidade interna de organização maior\"). Mesmo padrão que justificou BemMovel na DKD."@pt-BR ;
  skos:changeNote "AJ-57 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A classe passa a ser AtorInstitucional por meio de UnidadeOrganizacional; a aresta direta ficou redundante."@pt-BR ;
  skos:changeNote "AJ-60 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: O atributo atribuicao, repetido nas subclasses de UnidadeOrganizacional, passa a ser declarado uma vez na superclasse."@pt-BR .

rec:UnidadeDeBuscaPatrimonial a owl:Class ;
  rdfs:label "UnidadeDeBuscaPatrimonial"@pt-BR ;
  rdfs:comment "Unidade responsável pela localização, individualização e consolidação de informações patrimoniais."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, movimentacao-financeira-e-capacidade-economica, pedidos-de-cooperacao-entre-jurisdicoes, tramitacao-processual-e-decisoes-sobre-bens, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rdfs:subClassOf rec:UnidadeOrganizacional ;
  skos:changeNote "AJ-55 (2026-10-05, fonte: ontologia_externa): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: As unidades internas repetem o mesmo atributo único (atribuicao) e têm o mesmo par mantido no ORR (ORG OrganizationalUnit: \"unidade interna de organização maior\"). Mesmo padrão que justificou BemMovel na DKD."@pt-BR ;
  skos:changeNote "AJ-58 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A classe passa a ser AtorInstitucional por meio de UnidadeOrganizacional; a aresta direta ficou redundante."@pt-BR ;
  skos:changeNote "AJ-61 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: O atributo atribuicao, repetido nas subclasses de UnidadeOrganizacional, passa a ser declarado uma vez na superclasse."@pt-BR .

rec:UnidadeDeInteligenciaFinanceira a owl:Class ;
  rdfs:label "UnidadeDeInteligenciaFinanceira"@pt-BR ;
  rdfs:comment "Unidade responsável pela produção ou intercâmbio de inteligência financeira."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, gestao-de-carteira-e-desempenho-do-fluxo-de-trabalho, marco-normativo-e-instrumentos-juridicos-aplicaveis, movimentacao-financeira-e-capacidade-economica, pedidos-de-cooperacao-entre-jurisdicoes, tramitacao-processual-e-decisoes-sobre-bens"@pt-BR ;
  rdfs:subClassOf rec:AtorInstitucional ;
  skos:changeNote "AJ-99 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: O valor do atributo é a própria definição da classe (\"produção e intercâmbio de inteligência financeira\"), não um dado."@pt-BR .

rec:UnidadeOrganizacional a owl:Class ;
  rdfs:label "UnidadeOrganizacional"@pt-BR ;
  rdfs:comment "Unidade interna de um órgão ou organização maior, sem personalidade jurídica própria, com atribuição específica no fluxo de recuperação de ativos."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-52 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:AtorInstitucional ;
  skos:changeNote "AJ-52 (2026-10-05, fonte: ontologia_externa): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: As unidades internas repetem o mesmo atributo único (atribuicao) e têm o mesmo par mantido no ORR (ORG OrganizationalUnit: \"unidade interna de organização maior\"). Mesmo padrão que justificou BemMovel na DKD."@pt-BR .

rec:ValorEconomicoDeAtivo a owl:Class ;
  rdfs:label "ValorEconomicoDeAtivo"@pt-BR ;
  rdfs:comment "Valor monetário atribuído a algo do domínio — ativo, contrato, dívida, lançamento, sub-rogação, dano a recuperar, bloqueio, repatriação —, com quantia, moeda, natureza do valor (tipoDeValor) e data de referência, e, quando em moeda estrangeira, valor convertido pela taxa de câmbio da data. Um mesmo ativo pode ter vários valores, de naturezas e datas distintas."@pt-BR ;
  rec:proveniencia "DKC: movimentacao-financeira-e-capacidade-economica, valoracao-e-expressao-economica-dos-ativos"@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-481 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-477 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: grauDeConfianca (\"confirmado, provável, hipótese\", DKC valoração) é a mesma escala de StatusProbatorio.grauDeCerteza, guardada aqui como texto solto, sem data nem justificativa. A DKC já previa a relação: \"ValorEconômicoDeAtivo —QUALIFICADO_POR→ IndicadorDeConfiabilidade\" (rótulo, motivo: \"divergência de valor, moeda ausente, conversão cambial em datas distintas\"), que é o papel de StatusProbatorio (grauDeCerteza + justificativa). Mesmo tratamento dado a Ativo (grauDeConfianca → QUALIFICADO_POR). ASD R49."@pt-BR ;
  skos:changeNote "AJ-479 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação: a lista de tipoDeValor estava menor que a da DKC e que o uso atual da classe. DKC valoração: \"venal/cadastral, declarado, estimado, de avaliação, do dano/a recuperar, bloqueado, de alienação\"; DKC constrição: \"atualizado, valor de face\"; e Repatriacao PRODUZ ValorEconomicoDeAtivo (repatriado). A DKC também as lista como sete subclasses, mas todas com os mesmos campos (montante, data) — sem conteúdo próprio, ficam como valores do atributo."@pt-BR ;
  skos:changeNote "AJ-481 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: A definição (\"expressão monetária associada a ativo, medida, dano, bloqueio ou avaliação\") já não dizia o que a classe é hoje: o valor monetário de qualquer coisa do domínio — ativo, contrato, dívida, lançamento, sub-rogação, dano fixado em decisão, bloqueio, repatriação (TEM_VALOR / DETERMINA / PRODUZ / INDICA). A nova redação explicita esse alcance e os campos que tornam o valor comparável (moeda, data de referência, conversão), que é o problema que ASD R73 e B41 descrevem."@pt-BR .

rec:ValorMobiliario a owl:Class ;
  rdfs:label "ValorMobiliario"@pt-BR ;
  rdfs:comment "[adicionado no EOA — iteração à DKD a partir de lacuna externa mantida no ORR] Ativo financeiro na forma de instrumento negociável emitido por um emissor (ações, títulos), identificado por ISIN e ticker. Origem: FollowTheMoney Security (issuer, type, isin, ticker, currency) e FIBO security (financial instrument that can be bought or sold)."@pt-BR ;
  rec:proveniencia "adicionado manualmente na revisão humana da DKD"@pt-BR ;
  rdfs:subClassOf rec:AtivoFinanceiro .

rec:Veiculo a owl:Class ;
  rdfs:label "Veículo"@pt-BR ;
  rdfs:comment "Especialização de ativo para veículos automotores."@pt-BR ;
  rec:proveniencia "DKC: constricao-perdimento-e-destinacao-de-ativos, registro-e-titularidade-de-bens"@pt-BR ;
  rdfs:subClassOf rec:BemMovel ;
  skos:changeNote "AJ-174 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Relação adicionada à mão na revisão da DKD, sem lastro: a DKC de Veículo captura placa, RENAVAM, chassi, proprietário formal, histórico e restrição — nenhum endereço. Endereço é do proprietário (Pessoa TEM_ENDERECO)."@pt-BR .

rec:ViaProcessual a owl:Class ;
  rdfs:label "ViaProcessual"@pt-BR ;
  rdfs:comment "Tipo de via jurídica ou administrativa pela qual um pedido de cooperação tramita — auxílio direto, carta rogatória, via diplomática ou rede de cooperação —, com critério de cabimento e exigência ou não de exequatur; é determinada pelo instrumento jurídico aplicável e utilizada pelo pedido. A reclassificação da via durante o trâmite é registrada como evento de tramitação."@pt-BR ;
  rec:proveniencia "DKC: marco-normativo-e-instrumentos-juridicos-aplicaveis, pedidos-de-cooperacao-entre-jurisdicoes"@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-486 (04-ajustes-manuais.md)"@pt-BR ;
  skos:changeNote "AJ-374 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ViaProcessual.registroDeReclassificacao (\"reclassificação de via não registrada como evento próprio\") descrevia a ausência de um evento; com EventoDeTramitacao (tipoDeEvento inclui reclassificação de via, DKC gestão: EventoDeReclassificaçãoDeVia) o evento existe e o atributo perde objeto."@pt-BR ;
  skos:changeNote "AJ-483 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: ViaProcessual é um catálogo de tipos de via (auxílio direto, carta rogatória, via diplomática, rede), e Exequatur é uma decisão concreta (⊂ DecisaoJudicial, com data, objeto e órgão concedente). \"ViaProcessual EXIGE Exequatur\" ligava um tipo a uma decisão específica — não há qual exequatur apontar a partir de \"carta rogatória\" em geral. A DKC do marco normativo registra a informação nos dois níveis: como atributo do tipo, \"exigênciaDeExequatur (booleano)\", e como relação; a DKD ficou só com a relação. Passa a valer o atributo, que é o que o tipo de via pode dizer; o exequatur concreto liga-se ao pedido (ajuste seguinte). ASD R25: distinguir auxílio direto e carta rogatória [lastro apenas sintético — requer validação humana]."@pt-BR ;
  skos:changeNote "AJ-486 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: A definição não dizia que a classe é um tipo, e não a tramitação de um pedido — o que levou à relação EXIGE Exequatur. Explicita o papel: tipo de via, com critério de cabimento e exigência de exequatur, determinado pelo instrumento aplicável (InstrumentoJuridicoDeCooperacao DETERMINA) e utilizado pelo pedido (UTILIZA); a troca de via no meio do trâmite (ASD B33) é um EventoDeTramitacao."@pt-BR .

rec:VinculoDeParentesco a owl:Class ;
  rdfs:label "VinculoDeParentesco"@pt-BR ;
  rdfs:comment "Vínculo de parentesco entre pessoas naturais — cônjuge, ex-cônjuge, companheiro, ascendente, descendente, colateral, por consanguinidade ou afinidade —, com tipo, grau e regime de bens quando houver; comprovado por registro civil. Parentesco por afinidade: não declarado nas bases (lacuna da DKC)."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-429 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:VinculoEntrePessoas ;
  skos:changeNote "AJ-429 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: \"VínculoDeParentesco (especialização de VínculoEntrePessoas): tipoDeParentesco — cônjuge, ex-cônjuge, parente em diferentes graus; grauDeParentesco — ex.: primeiro grau; parentescoPorAfinidade — não declarado nas bases\" (identificacao-de-pessoas-e-estruturas-societarias-entidades.md). A DKD manteve só o gênero, com regimeDeBens (\"aplicável a vínculos de parentesco\") pendurado nele. Das quatro espécies de tipoDeVinculo, parentesco era a única sem classe — e é a do núcleo da tese (isMotherOf, isFatherOf, isSpouseOf) e do ASD R37 (interpostas pessoas por parentesco), R34 e B26. FTM Family (person, relative, relationship) é o par exato; o narrowMatch que VinculoEntrePessoas tinha com Family passa a esta classe."@pt-BR .

rec:VinculoDeRepresentacao a owl:Class ;
  rdfs:label "VinculoDeRepresentacao"@pt-BR ;
  rdfs:comment "Vínculo reificado em que uma pessoa representa outra (representante legal de sociedade, procurador), inclusive quando a representação encobre controle de fato. Origem é o representado; destino, o representante."@pt-BR ;
  rec:proveniencia "criada pelo ajuste manual estrutural AJ-214 (04-ajustes-manuais.md)"@pt-BR ;
  rdfs:subClassOf rec:VinculoEntrePessoas ;
  skos:changeNote "AJ-214 (2026-10-06, fonte: ontologia_externa): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC identificação de pessoas: \"VínculoDeRepresentação (especialização de VínculoEntrePessoas): tipoDeRepresentação (representante legal, procurador), indicadorDeControleDeFato (ex.: empresa controlada por procuração), INSTRUMENTADO_POR AtoNotarial\". Lacuna externa FTM Representation mantida no ORR, IRI confirmada."@pt-BR .

rec:VinculoEntrePessoas a owl:Class ;
  rdfs:label "VinculoEntrePessoas"@pt-BR ;
  rdfs:comment "Relação reificada entre pessoas com natureza, temporalidade, proveniência e confiança."@pt-BR ;
  rec:proveniencia "DKC: identificacao-de-pessoas-e-estruturas-societarias, pedidos-de-cooperacao-entre-jurisdicoes"@pt-BR ;
  rdfs:subClassOf rec:RelacaoReificada ;
  skos:changeNote "AJ-37 (2026-10-05, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic)): AssercaoDeTitularidade é 'afirmação reificada de titularidade' e VinculoEntrePessoas é 'relação reificada entre pessoas'. Ambas usam relações de ligação (LIGA; TEM_ORIGEM/TEM_DESTINO), e as alinhadas a FTM Ownership ficam reunidas."@pt-BR ;
  skos:changeNote "AJ-418 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero (AJ-258) diz \"com identidade própria, datas e qualificação probatória\", mas as datas estavam repetidas nas filhas com o mesmo nome e tipo — dataDeInicio/dataDeFim em Divida, ParticipacaoEmProcesso, SancaoIndividual e VinculoEntrePessoas (DKC: \"dataDeInícioVigência / dataDeFimVigência\", identificacao-de-pessoas-e-estruturas-societarias-entidades.md) — e com outro nome em ParticipacaoSocietaria (dataDeEntrada/dataDeSaida, \"período de entrada/saída\"). Sobem para o gênero; FTM Ownership, Debt, Sanction, Succession e CourtCaseParty são todos Interval com startDate/endDate."@pt-BR ;
  skos:changeNote "AJ-419 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição do gênero (AJ-258) diz \"com identidade própria, datas e qualificação probatória\", mas as datas estavam repetidas nas filhas com o mesmo nome e tipo — dataDeInicio/dataDeFim em Divida, ParticipacaoEmProcesso, SancaoIndividual e VinculoEntrePessoas (DKC: \"dataDeInícioVigência / dataDeFimVigência\", identificacao-de-pessoas-e-estruturas-societarias-entidades.md) — e com outro nome em ParticipacaoSocietaria (dataDeEntrada/dataDeSaida, \"período de entrada/saída\"). Sobem para o gênero; FTM Ownership, Debt, Sanction, Succession e CourtCaseParty são todos Interval com startDate/endDate."@pt-BR ;
  skos:changeNote "AJ-422 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: grauDeConfianca (\"confirmado, provável ou hipótese\") duplica QUALIFICADO_POR StatusProbatorio, herdado do gênero, cujo grauDeCerteza tem os mesmos valores — a própria DKC lista grauDeConfiança e statusProbatório lado a lado como a mesma lacuna (identificacao-de-pessoas-e-estruturas-societarias-entidades.md). Era a unificação anotada desde a revisão de Ativo (AJ-156+)."@pt-BR ;
  skos:changeNote "AJ-427 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC registra, para o vínculo, \"proveniência — documento/base de origem\" e \"EXTRAÍDO_DE DocumentoFonte\" (identificacao-de-pessoas-e-estruturas-societarias-entidades.md); AssercaoDeTitularidade e ParticipacaoSocietaria já tinham COMPROVADA_POR (RegistroPublicoDeBem / DocumentoComprobatorio), e VinculoDeParentesco \"COMPROVADO_POR RegistroDeRegistroCivil\". É conteúdo do gênero: toda afirmação reificada tem o documento que a comprova. Sobe como COMPROVADA_POR Documento (gênero documental, que cobre registro público e documento comprobatório), com o alinhamento prov:hadPrimarySource que já existia; os pares específicos e o texto proveniencia ficam herdados. ASD R50: procedência de toda informação (base, processo, peça)."@pt-BR ;
  skos:changeNote "AJ-433 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação: com ParticipacaoSocietaria, IndicacaoDeBeneficiarioFinal, VinculoDeRepresentacao, InterposicaoDePessoa e VinculoDeParentesco, tipoDeVinculo vale só quando não houver subclasse específica — mesma regra de tipoDeAtivo, tipoDeAtor, tipoDeInstrumento e tipoDeMedida."@pt-BR .

# --- Data properties (por nome de atributo da DKD; domínio = união das classes que o usam)
rec:abrangenciaTerritorial a owl:DatatypeProperty ;
  rdfs:label "abrangenciaTerritorial"@pt-BR ;
  rdfs:comment "[OrgaoDeRegistroPublico] abrangência territorial"@pt-BR ;
  rdfs:domain rec:OrgaoDeRegistroPublico ;
  rdfs:range xsd:string .

rec:agencia a owl:DatatypeProperty ;
  rdfs:label "agencia"@pt-BR ;
  rdfs:comment "[ContaBancaria] agência [requer pesquisa adicional]"@pt-BR ;
  rdfs:domain rec:ContaBancaria ;
  rdfs:range xsd:string .

rec:ambitoTerritorial a owl:DatatypeProperty ;
  rdfs:label "ambitoTerritorial"@pt-BR ;
  rdfs:comment "[MedidaDeConstricao] nacional ou exterior"@pt-BR ;
  rdfs:domain rec:MedidaDeConstricao ;
  rdfs:range xsd:string .

rec:aplicacaoPorBem a owl:DatatypeProperty ;
  rdfs:label "aplicacaoPorBem"@pt-BR ;
  rdfs:comment "[FundamentoLegal] aplicação por bem, hoje frequentemente textual"@pt-BR ;
  rdfs:domain rec:FundamentoLegal ;
  rdfs:range xsd:string .

rec:apostilamentoOuLegalizacao a owl:DatatypeProperty ;
  rdfs:label "apostilamentoOuLegalizacao"@pt-BR ;
  rdfs:comment "[DocumentoDoPedido] situação de apostilamento ou legalização"@pt-BR ;
  rdfs:domain rec:DocumentoDoPedido ;
  rdfs:range xsd:string .

rec:atribuicao a owl:DatatypeProperty ;
  rdfs:label "atribuicao"@pt-BR ;
  rdfs:comment "[UnidadeOrganizacional] atribuição da unidade no fluxo de recuperação de ativos"@pt-BR ;
  rdfs:domain rec:UnidadeOrganizacional ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-62 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: O atributo atribuicao, repetido nas subclasses de UnidadeOrganizacional, passa a ser declarado uma vez na superclasse."@pt-BR .

rec:atribuicaoPatrimonial a owl:DatatypeProperty ;
  rdfs:label "atribuicaoPatrimonial"@pt-BR ;
  rdfs:comment "[OrgaoDeAcusacao] atribuição relacionada à recuperação patrimonial"@pt-BR ;
  rdfs:domain rec:OrgaoDeAcusacao ;
  rdfs:range xsd:string .

rec:blockchain a owl:DatatypeProperty ;
  rdfs:label "blockchain"@pt-BR ;
  rdfs:comment "[Criptoativo] Rede/blockchain em que o ativo está registrado [requer pesquisa adicional]. Desmembrado de carteiraBlockchainSaldo."@pt-BR ;
  rdfs:domain rec:Criptoativo ;
  rdfs:range xsd:string .

rec:camposEstruturadosDisponiveis a owl:DatatypeProperty ;
  rdfs:label "camposEstruturadosDisponiveis"@pt-BR ;
  rdfs:comment "[SistemaDeInformacao] campos e dicionário de dados [requer pesquisa adicional]"@pt-BR ;
  rdfs:domain rec:SistemaDeInformacao ;
  rdfs:range xsd:string .

rec:canalDeComunicacao a owl:DatatypeProperty ;
  rdfs:label "canalDeComunicacao"@pt-BR ;
  rdfs:comment "[AutoridadeCentral] canal de comunicação utilizado"@pt-BR ;
  rdfs:domain rec:AutoridadeCentral ;
  rdfs:range xsd:string .

rec:caraterBloqueante a owl:DatatypeProperty ;
  rdfs:label "caraterBloqueante"@pt-BR ;
  rdfs:comment "[RequisitoFormal] indicação de efeito bloqueante"@pt-BR ;
  rdfs:domain rec:RequisitoFormal ;
  rdfs:range xsd:boolean .

rec:carteira a owl:DatatypeProperty ;
  rdfs:label "carteira"@pt-BR ;
  rdfs:comment "[Criptoativo] Endereço da carteira, que funciona como identificador do ativo cripto [requer pesquisa adicional]. Desmembrado de carteiraBlockchainSaldo."@pt-BR ;
  rdfs:domain rec:Criptoativo ;
  rdfs:range xsd:string .

rec:categoriaDoMotivo a owl:DatatypeProperty ;
  rdfs:label "categoriaDoMotivo"@pt-BR ;
  rdfs:comment "[MotivoDeSaneamentoOuDevolucao] categoria do motivo (lista categorizada, ASD R28); texto livre de origem enquanto não houver lista fechada"@pt-BR ;
  rdfs:domain rec:MotivoDeSaneamentoOuDevolucao ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-376 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC em duas categorias: \"MotivoDeDevoluçãoOuSaneamento: motivo (falta de tradução, ausência de apostilamento, dupla incriminação, formulário incompleto, individualização insuficiente do bem) — sem lista fechada e sem registro estruturado\" (pedidos) e \"MotivoDeSaneamentoOuDevolução … EventoDeTramitação TEM_CAUSA Motivo; RequisitoFormal QUANDO_DESCUMPRIDO_GERA Motivo\" (marco normativo). ASD R28 pede exatamente a lista categorizada."@pt-BR .

rec:chassi a owl:DatatypeProperty ;
  rdfs:label "chassi"@pt-BR ;
  rdfs:comment "[Veículo] chassi [requer pesquisa adicional]"@pt-BR ;
  rdfs:domain rec:Veiculo ;
  rdfs:range xsd:string .

rec:chaveDeConsulta a owl:DatatypeProperty ;
  rdfs:label "chaveDeConsulta"@pt-BR ;
  rdfs:comment "[ConsultaAFonte] chave utilizada (identificador fiscal, matrícula, placa, nome)"@pt-BR ;
  rdfs:domain rec:ConsultaAFonte ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-452 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: DKC: ConsultaAFonte / ConsultaAFonteDeDados / RegistroDeConsultaAFonte aparece em cinco categorias (identificação de pessoas, constrição, movimentação financeira, registro e titularidade, valoração) com os mesmos campos — base consultada, data da consulta, data de corte, chave utilizada, resultado (inclusive negativo), via de obtenção — e as relações \"ConsultaAFonte —DIRIGIDA_A→ SistemaOuBaseDeDados\", \"—REALIZADA_POR→ ÓrgãoDeBuscaPatrimonial\", \"—TEM_ALVO→ Pessoa\", \"—PRODUZ→ AsserçãoDeTitularidade / ValorEconômicoDeAtivo / DocumentoFonte\", \"—ATRIBUI→ StatusProbatório\" e \"DossiêPatrimonial —COMPOSTO_POR→ ConsultaAFonte\". A DKD descartou a classe, e com isso SistemaDeInformacao ficou sem uso analítico: nada dizia de que base, em que data e com que chave veio uma informação. É o que o ASD pede em R50 (procedência: base consultada, data da consulta), R51 (resultado como \"foto\" datada, não sobrescrita) e R52 (negativa de consulta registrada, para que ausência de resultado não seja lida como ausência de patrimônio) [R50–R52: lastro apenas sintético — requer validação humana]; a DKC marca a negativa e a data de corte como \"inexistente hoje\". O ORR já previa prov:Activity para \"a cadeia de proveniência das diligências que compõem o dossiê\"."@pt-BR .

rec:citacaoDeBaseLegal a owl:DatatypeProperty ;
  rdfs:label "citacaoDeBaseLegal"@pt-BR ;
  rdfs:comment "[DocumentoDoPedido] presença de citação de tratado ou base legal"@pt-BR ;
  rdfs:domain rec:DocumentoDoPedido ;
  rdfs:range xsd:boolean .

rec:classeEAssunto a owl:DatatypeProperty ;
  rdfs:label "classeEAssunto"@pt-BR ;
  rdfs:comment "[ProcessoJudicial] classe processual e assuntos, conforme as Tabelas Processuais Unificadas do CNJ (DataJud: classe.codigo/nome; assuntos[].codigo/nome)"@pt-BR ;
  rdfs:domain rec:ProcessoJudicial ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-511 (2026-10-06, fonte: metadado): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação com metadado real: o campo estava \"[requer pesquisa adicional]\". No DataJud (CNJ) todo processo traz classe (código e nome) e assuntos (lista de código e nome), ambos das Tabelas Processuais Unificadas do CNJ. A lacuna de estrutura está resolvida; o atributo continua um texto único — separar classe de assuntos é decisão para o DSMI, com a amostra."@pt-BR .

rec:classificacaoDeRisco a owl:DatatypeProperty ;
  rdfs:label "classificacaoDeRisco"@pt-BR ;
  rdfs:comment "[Jurisdição] classificação de risco da jurisdição (ex.: paraíso fiscal, baixa tributação, lista de monitoramento) — fonte e escala [requer pesquisa adicional]"@pt-BR ;
  rdfs:domain rec:Jurisdicao ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-334 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC identificação: \"classificaçãoDeRisco — ex.: jurisdição de paraíso fiscal (citada genericamente) [requer pesquisa adicional]\". ASD R42 (lastro humano) prevê consumo de registros de \"jurisdições de baixa tributação\". A fonte e a escala da classificação seguem [requer pesquisa adicional]."@pt-BR .

rec:cnpj a owl:DatatypeProperty ;
  rdfs:label "cnpj"@pt-BR ;
  rdfs:comment "[PessoaJurídica] número de inscrição no cadastro fiscal nacional de pessoas jurídicas — chave primária de consulta e de resolução de identidade; os demais identificadores vão em IdentificadorDePessoa"@pt-BR ;
  rdfs:domain rec:PessoaJuridica ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-92 (2026-10-05, fonte: modelagem): CNPJ"@pt-BR ;
  skos:changeNote "AJ-497 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação. cpf e cnpj coexistem com IdentificadorDePessoa (tipoDeIdentificador = cadastro fiscal) e pareciam duplicata. Decisão: ficam, como atalho do identificador fiscal nacional — a DKC os descreve como \"chave primária de consulta\" das bases, e é por essa coluna que os dados reais chegam e que a resolução de identidade é feita (ASD R53). IdentificadorDePessoa fica para todos os demais (estrangeiro, registro mercantil, passaporte) e para o que precisa de emissor ou de sinalização de duplicidade. A descrição passa a dizer isso."@pt-BR .

rec:coberturaTerritorial a owl:DatatypeProperty ;
  rdfs:label "coberturaTerritorial"@pt-BR ;
  rdfs:comment "[SistemaDeInformacao] abrangência da fonte (nacional, estadual, por comarca ou município) [requer pesquisa adicional]"@pt-BR ;
  rdfs:domain rec:SistemaDeInformacao ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-463 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: DKC em quatro categorias: \"coberturaTemporalEGeográfica\" (identificação), \"abrangência (nacional, estadual, por comarca/município)\" (registro), \"cobertura territorial (desigual entre regiões/municípios)\" (valoração), \"coberturaTerritorial\" (constrição). Sem ela a negativa de consulta não é interpretável: não achar um imóvel numa base que cobre um estado não diz nada sobre os demais."@pt-BR .

rec:codigo a owl:DatatypeProperty ;
  rdfs:label "codigo"@pt-BR ;
  rdfs:comment "[CodigoPostal] [sem lastro em DKC] Valor do código postal em texto livre — formato varia por país, não decomposto."@pt-BR ;
  rdfs:domain rec:CodigoPostal ;
  rdfs:range xsd:string .

rec:comarcaOuSecao a owl:DatatypeProperty ;
  rdfs:label "comarcaOuSecao"@pt-BR ;
  rdfs:comment "[OrgaoJudicial] comarca ou seção judiciária"@pt-BR ;
  rdfs:domain rec:OrgaoJudicial ;
  rdfs:range xsd:string .

rec:competencia a owl:DatatypeProperty ;
  rdfs:label "competencia"@pt-BR ;
  rdfs:comment "[AutoridadeCentral] competência de tramitação e cooperação"@pt-BR ;
  rdfs:domain rec:AutoridadeCentral ;
  rdfs:range xsd:string .

rec:conclusao a owl:DatatypeProperty ;
  rdfs:label "conclusao"@pt-BR ;
  rdfs:comment "[ParecerJuridico] conclusão do parecer"@pt-BR ;
  rdfs:domain rec:ParecerJuridico ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-252 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura ParecerJurídico (objetoDoParecer, dataDeEmissao, conclusao) emitido pela assessoria jurídica, que analisa o decreto de perdimento e em que a autoridade decisória se baseia (constricao-perdimento-e-destinacao-de-ativos-entidades.md). O ASD confirma, com lastro humano, a assessoria jurídica em perdimento e destinação como usuária que \"subsidia decisões sobre destinação\" — o parecer é esse subsídio. A classe não entrou na DKD; aqui entra como Documento."@pt-BR .

rec:condicaoDePartilha a owl:DatatypeProperty ;
  rdfs:label "condicaoDePartilha"@pt-BR ;
  rdfs:comment "[Repatriacao] condição de partilha"@pt-BR ;
  rdfs:domain rec:Repatriacao ;
  rdfs:range xsd:string .

rec:conteudo a owl:DatatypeProperty ;
  rdfs:label "conteudo"@pt-BR ;
  rdfs:comment "[Correspondencia] conteúdo textual da comunicação"@pt-BR ;
  rdfs:domain rec:Correspondencia ;
  rdfs:range xsd:string .

rec:cotacao a owl:DatatypeProperty ;
  rdfs:label "cotacao"@pt-BR ;
  rdfs:comment "[TaxaDeCambioHistorica] valor da taxa de câmbio na data da cotação (unidades da moeda de destino por unidade da moeda de origem)"@pt-BR ;
  rdfs:domain rec:TaxaDeCambioHistorica ;
  rdfs:range xsd:decimal ;
  skos:changeNote "AJ-231 (2026-10-06, fonte: ontologia_externa): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A classe tinha moedas, data e fonte, mas não a própria taxa — sem ela valorConvertido não é reproduzível. Par FIBO ≡ exchange rate mantido no ORR (a taxa de câmbio do FIBO tem o valor da taxa como propriedade)."@pt-BR .

rec:cpf a owl:DatatypeProperty ;
  rdfs:label "cpf"@pt-BR ;
  rdfs:comment "[PessoaFísica] número de inscrição no cadastro fiscal nacional de pessoas físicas — chave primária de consulta e de resolução de identidade; os demais identificadores vão em IdentificadorDePessoa"@pt-BR ;
  rdfs:domain rec:PessoaFisica ;
  rdfs:range xsd:string ;
  skos:changeNote "AJ-91 (2026-10-05, fonte: modelagem): Código de Pessoa Física"@pt-BR ;
  skos:changeNote "AJ-495 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: Redocumentação. cpf e cnpj coexistem com IdentificadorDePessoa (tipoDeIdentificador = cadastro fiscal) e pareciam duplicata. Decisão: ficam, como atalho do identificador fiscal nacional — a DKC os descreve como \"chave primária de consulta\" das bases, e é por essa coluna que os dados reais chegam e que a resolução de identidade é feita (ASD R53). IdentificadorDePessoa fica para todos os demais (estrangeiro, registro mercantil, passaporte) e para o que precisa de emissor ou de sinalização de duplicidade. A descrição passa a dizer isso."@pt-BR .

rec:criterioDeCabimento a owl:DatatypeProperty ;
  rdfs:label "criterioDeCabimento"@pt-BR ;
  rdfs:comment "[ViaProcessual] critério de cabimento"@pt-BR ;
  rdfs:domain rec:ViaProcessual ;
  rdfs:range xsd:string .

