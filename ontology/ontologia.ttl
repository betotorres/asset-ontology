  rdfs:domain rec:Contrato ;
  rdfs:range rec:EscrituraPublica ;
  rdfs:comment "Especialização de instrumentalizadoPor para o par Contrato INSTRUMENTALIZADO_POR EscrituraPublica: o verbo é sobrecarregado na DKD e este par tem correspondência externa própria (02-alinhamento-relacoes.md)."@pt-BR .

rec:integra a owl:ObjectProperty ;
  rdfs:label "INTEGRA"@pt-BR ;
  rdfs:domain rec:UnidadeOrganizacional ;
  rdfs:range rec:AtorInstitucional ;
  rdfs:comment "UnidadeOrganizacional INTEGRA AtorInstitucional"@pt-BR ;
  skos:changeNote "AJ-107 (2026-10-05, fonte: ontologia_externa): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A definição de UnidadeOrganizacional diz \"unidade interna de um órgão maior\", mas nada ligava a unidade ao órgão. ORG unitOf (IRI confirmada no catálogo)."@pt-BR .

rec:invoca a owl:ObjectProperty ;
  rdfs:label "INVOCA"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:FundamentoLegal rec:PedidoDeCooperacaoJuridicaInternacional ) ] ;
  rdfs:range rec:DispositivoNormativo ;
  rdfs:comment "FundamentoLegal INVOCA DispositivoNormativo"@pt-BR ;
  rdfs:comment "PedidoDeCooperacaoJuridicaInternacional INVOCA DispositivoNormativo"@pt-BR ;
  skos:changeNote "AJ-71 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: FundamentoLegal (\"referência normativa usada para fundamentar\") e DispositivoNormativo (\"dispositivo que fundamenta medida\") vieram de categorias DKC diferentes e não tinham ligação; ASD R16 pede o perdimento vinculado ao marco normativo específico."@pt-BR ;
  skos:changeNote "AJ-72 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ASD R26 pede vincular cada pedido de cooperação ao tratado aplicável e ao dispositivo invocado; a DKD só liga o pedido ao instrumento inteiro."@pt-BR .

rec:julgadoPor a owl:ObjectProperty ;
  rdfs:label "JULGADO_POR"@pt-BR ;
  rdfs:domain rec:IncidenteDeRestituicao ;
  rdfs:range rec:OrgaoJudicial ;
  rdfs:comment "IncidenteDeRestituicao JULGADO_POR OrgaoJudicial"@pt-BR ;
  skos:changeNote "AJ-315 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal, em duas categorias: \"IncidenteDeRestituição —JULGADO_POR→ AutoridadeJudicial\" (constricao-perdimento-e-destinacao-de-ativos-entidades.md) e \"ÓrgãoJudicial —JULGA→ IncidenteDeRestituição\". Hoje o juízo só se infere pela cadeia DecisaoJudicial DECIDE Incidente + OrgaoJudicial PROFERE DecisaoJudicial; pelo princípio da tese (relação explícita vale mais que inferida quando o elo intermediário pode faltar nos dados), o juízo do incidente fica explícito — a decisão nem sempre está estruturada (DKC: \"resultado/decisão\" em texto)."@pt-BR .

rec:lavradoPor a owl:ObjectProperty ;
  rdfs:label "LAVRADO_POR"@pt-BR ;
  rdfs:domain rec:AtoNotarial ;
  rdfs:range rec:TabelionatoDeNotas ;
  rdfs:comment "AtoNotarial LAVRADO_POR TabelionatoDeNotas — Tabelionato lavrante referenciava uma instituicao sem classe propria — criada TabelionatoDeNotas e ligada aqui."@pt-BR ;
  rec:proveniencia "inclui par(es) adicionado(s) manualmente na revisão humana da DKD"@pt-BR .

rec:ligaAtivo a owl:ObjectProperty ;
  rdfs:label "LIGA"@pt-BR ;
  rdfs:domain rec:AssercaoDeTitularidade ;
  rdfs:range rec:Ativo ;
  rdfs:comment "AssercaoDeTitularidade LIGA Ativo — Relação de titularidade reificada."@pt-BR .

rec:ligaTitular a owl:ObjectProperty ;
  rdfs:label "LIGA"@pt-BR ;
  rdfs:domain rec:AssercaoDeTitularidade ;
  rdfs:range rec:Pessoa ;
  rdfs:comment "AssercaoDeTitularidade LIGA Pessoa — Relação de titularidade reificada."@pt-BR .

rec:localizadoEm a owl:ObjectProperty ;
  rdfs:label "LOCALIZADO_EM"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:Ativo rec:Endereco ) ] ;
  rdfs:range rec:Jurisdicao ;
  rdfs:comment "Ativo LOCALIZADO_EM Jurisdição"@pt-BR ;
  rdfs:comment "Endereco LOCALIZADO_EM Jurisdição"@pt-BR ;
  skos:changeNote "AJ-156 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Resposta humana do ASD (B6) lista \"ativo ↔ jurisdição estrangeira\" entre os vínculos mais relevantes; a DKC captura \"jurisdição/país da conta\". Vira relação com a classe Jurisdição, como já feito para AtorInstitucional; o texto livre jurisdicaoOuLocalizacao sai (a localização física do imóvel já é TEM_ENDERECO)."@pt-BR ;
  skos:changeNote "AJ-237 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: País de endereço como texto livre duplicava a classe Jurisdição (\"país ou ordenamento envolvido no ativo, na pessoa, na fonte ou na cooperação\", DKC), que já é o destino de Ativo LOCALIZADO_EM e PessoaJurídica CONSTITUÍDA_EM. O atributo sem lastro sai e entra a relação Endereco LOCALIZADO_EM Jurisdição, pelo mesmo verbo usado em Ativo; FIBO PhysicalAddress tem o país por hasCountry (Country), não como texto. ASD B11, B12 e B39 consultam ativos e endereços por jurisdição."@pt-BR .

rec:menciona a owl:ObjectProperty ;
  rdfs:label "MENCIONA"@pt-BR ;
  rdfs:domain rec:PedidoDeCooperacaoJuridicaInternacional ;
  rdfs:range rec:Pessoa ;
  rdfs:comment "PedidoDeCooperacaoJuridicaInternacional MENCIONA Pessoa — Consolida referências a pessoas envolvidas."@pt-BR .

rec:operadaPor a owl:ObjectProperty ;
  rdfs:label "OPERADA_POR"@pt-BR ;
  rdfs:domain rec:Aeronave ;
  rdfs:range rec:Pessoa ;
  rdfs:comment "Aeronave OPERADA_POR Pessoa — Operador pode ser diferente do proprietario registrado (ex.: leasing) — conceito novo, nao coberto pela heranca de Ativo, entao vira relacao propria em vez de propriedade solta."@pt-BR ;
  rec:proveniencia "inclui par(es) adicionado(s) manualmente na revisão humana da DKD"@pt-BR .

rec:operadoPor a owl:ObjectProperty ;
  rdfs:label "OPERADO_POR"@pt-BR ;
  rdfs:domain rec:SistemaDeInformacao ;
  rdfs:range rec:AtorInstitucional ;
  rdfs:comment "SistemaDeInformacao OPERADO_POR AtorInstitucional — Relacao presente na DKC original (categoria de constricao-perdimento) — SistemaDeInformacao/subtipos operados por algum ator institucional — nao sobreviveu a fusao do LLM."@pt-BR ;
  rec:proveniencia "inclui par(es) adicionado(s) manualmente na revisão humana da DKD"@pt-BR .

rec:pertenceA a owl:ObjectProperty ;
  rdfs:label "PERTENCE_A"@pt-BR ;
  rdfs:domain rec:AtorInstitucional ;
  rdfs:range rec:Jurisdicao ;
  rdfs:comment "AtorInstitucional PERTENCE_A Jurisdição"@pt-BR ;
  skos:changeNote "AJ-112 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Todo órgão pertence a uma jurisdição: a relação sobe de AutoridadeCentral e OrgaoJudicial para AtorInstitucional (mesmo alinhamento FIBO), e o atributo de texto jurisdicao fica redundante."@pt-BR .

rec:possui a owl:ObjectProperty ;
  rdfs:label "POSSUI"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:PedidoDeCooperacaoJuridicaInternacional rec:ProcessoJudicial ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( rec:Correspondencia rec:EventoDeTramitacao ) ] ;
  rdfs:comment "PedidoDeCooperacaoJuridicaInternacional POSSUI Correspondencia — Consolida correspondências associadas ao pedido."@pt-BR ;
  rdfs:comment "PedidoDeCooperacaoJuridicaInternacional POSSUI EventoDeTramitacao"@pt-BR ;
  rdfs:comment "ProcessoJudicial POSSUI EventoDeTramitacao"@pt-BR ;
  skos:changeNote "AJ-371 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura o evento de tramitação em quatro categorias — \"EventoDeAndamento: estado do pedido no momento; data/hora; sequência de estados ao longo do tempo (histórico, não valor único)\" (pedidos), \"EventoDeTramitação: tipoDeEvento (envio, saneamento, reclassificação de via, resposta), dataDoEvento\" (marco normativo), \"EventoDeTramitação (marco/mudança de estado) … OCORRE_EM Pedido, É_PRATICADO_POR órgão, É_REGISTRADO_EM SistemaDeInformação\" (tramitação) e EventoDeReclassificaçãoDeVia/EventoDeRetrabalho (gestão) — e a DKD manteve só faseDoFluxo e status como valor único no pedido. ASD R27 pede os marcos visíveis (pedido formulado, saneamento, complementação, resposta, bloqueio confirmado, repatriação) e R59 a linha do tempo. Evento concreto, com dado por trás — não o gênero abstrato Evento, que ficou descartado."@pt-BR ;
  skos:changeNote "AJ-408 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC tramitação: \"ProcessoJudicial —REGISTRA_EVENTO→ EventoDeTramitação\", com tipos próprios do processo (juntada de documento, prolação de decisão, concessão de exequatur). EventoDeTramitacao (AJ-367) nasceu para o pedido; a definição passa a cobrir também o processo, e POSSUI é o mesmo verbo do pedido. ASD R20 (histórico de decisões sobre o ativo ao longo do processo) e R59 (linha do tempo)."@pt-BR .

rec:praticadoPor a owl:ObjectProperty ;
  rdfs:label "PRATICADO_POR"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:AtoRegistral rec:EventoDeTramitacao ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( rec:OrgaoDeRegistroPublico rec:Agente ) ] ;
  rdfs:comment "AtoRegistral PRATICADO_POR OrgaoDeRegistroPublico"@pt-BR ;
  rdfs:comment "EventoDeTramitacao PRATICADO_POR Agente"@pt-BR ;
  skos:changeNote "AJ-108 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Simétrico a AtoNotarial LAVRADO_POR TabelionatoDeNotas; a definição de OrgaoDeRegistroPublico cita expressamente \"atos registrais\" e não havia relação entre o ato registral e quem o pratica."@pt-BR ;
  skos:changeNote "AJ-373 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura o evento de tramitação em quatro categorias — \"EventoDeAndamento: estado do pedido no momento; data/hora; sequência de estados ao longo do tempo (histórico, não valor único)\" (pedidos), \"EventoDeTramitação: tipoDeEvento (envio, saneamento, reclassificação de via, resposta), dataDoEvento\" (marco normativo), \"EventoDeTramitação (marco/mudança de estado) … OCORRE_EM Pedido, É_PRATICADO_POR órgão, É_REGISTRADO_EM SistemaDeInformação\" (tramitação) e EventoDeReclassificaçãoDeVia/EventoDeRetrabalho (gestão) — e a DKD manteve só faseDoFluxo e status como valor único no pedido. ASD R27 pede os marcos visíveis (pedido formulado, saneamento, complementação, resposta, bloqueio confirmado, repatriação) e R59 a linha do tempo. Evento concreto, com dado por trás — não o gênero abstrato Evento, que ficou descartado."@pt-BR .

rec:previstoEm a owl:ObjectProperty ;
  rdfs:label "PREVISTO_EM"@pt-BR ;
  rdfs:domain rec:TipoPenal ;
  rdfs:range rec:DispositivoNormativo ;
  rdfs:comment "TipoPenal PREVISTO_EM DispositivoNormativo"@pt-BR ;
  skos:changeNote "AJ-88 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ASD R11 (vínculo entre o ativo e a condenação/fato criminoso, hoje só o texto de Ativo.nexoCausal) e R13 (tipificação penal no escopo), ambos com lastro humano. O ASD registra divergência com os perfis sintéticos, que deixariam a tipificação fora; pela hierarquia de evidência do método prevalece a resposta humana, pendente de validação por especialistas. Sem metadado de sistema: atributos [requer pesquisa adicional]."@pt-BR .

rec:produz a owl:ObjectProperty ;
  rdfs:label "PRODUZ"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:AlienacaoAntecipada rec:AtoRegistral rec:AvaliacaoPatrimonial rec:ConsultaAFonte rec:InstituicaoFinanceira rec:Repatriacao rec:RespostaDeCooperacao rec:UnidadeDeBuscaPatrimonial rec:UnidadeDeInteligenciaFinanceira ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( rec:ValorEconomicoDeAtivo rec:AssercaoDeTitularidade rec:Documento rec:ExtratoDeMovimentacaoFinanceira rec:DossieDeBuscaPatrimonial rec:IndicioPatrimonial rec:RelatorioDeInteligenciaFinanceira ) ] ;
  rdfs:comment "AlienacaoAntecipada PRODUZ ValorEconomicoDeAtivo"@pt-BR ;
  rdfs:comment "AtoRegistral PRODUZ AssercaoDeTitularidade"@pt-BR ;
  rdfs:comment "AvaliacaoPatrimonial PRODUZ ValorEconomicoDeAtivo — Relação explicitamente modelada na valoração."@pt-BR ;
  rdfs:comment "ConsultaAFonte PRODUZ Documento"@pt-BR ;
  rdfs:comment "ConsultaAFonte PRODUZ AssercaoDeTitularidade"@pt-BR ;
  rdfs:comment "ConsultaAFonte PRODUZ ValorEconomicoDeAtivo"@pt-BR ;
  rdfs:comment "InstituicaoFinanceira PRODUZ ExtratoDeMovimentacaoFinanceira — Relação explicitamente modelada."@pt-BR ;
  rdfs:comment "Repatriacao PRODUZ ValorEconomicoDeAtivo — Substitui valorRepatriado — mesmo padrão de ValorEconomicoDeAtivo, reaproveita PRODUZ no mesmo espírito de AvaliacaoPatrimonial PRODUZ ValorEconomicoDeAtivo."@pt-BR ;
  rdfs:comment "RespostaDeCooperacao PRODUZ ValorEconomicoDeAtivo — Substitui valorBloqueado/moeda — tipoDeValor já lista \"bloqueado\", mesma granularidade do ativo referenciado pelo pedido."@pt-BR ;
  rdfs:comment "UnidadeDeBuscaPatrimonial PRODUZ DossieDeBuscaPatrimonial — Consolida produção de dossiê pela unidade de busca."@pt-BR ;
  rdfs:comment "UnidadeDeBuscaPatrimonial PRODUZ IndicioPatrimonial"@pt-BR ;
  rdfs:comment "UnidadeDeInteligenciaFinanceira PRODUZ RelatorioDeInteligenciaFinanceira"@pt-BR ;
  rec:proveniencia "inclui par(es) adicionado(s) manualmente na revisão humana da DKD"@pt-BR ;
  skos:changeNote "AJ-110 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura a UnidadeDeInteligenciaFinanceira como \"produtora de relatório de inteligência financeira\" e o RIF como peça anexada ao processo, mas o relatório não tinha classe. formaDeEntrega (\"forma de entrega do produto\") é do relatório, não da unidade."@pt-BR ;
  skos:changeNote "AJ-218 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC registro-e-titularidade: \"AtoRegistral —PRODUZ→ AsserçãoDeTitularidade\" — a transmissão registrada é o que gera a titularidade formal; a DKD só ligava a asserção ao registro como prova (COMPROVADA_POR)."@pt-BR ;
  skos:changeNote "AJ-327 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: IndícioPatrimonial com descricao, origemDaInformacao e dataDaApuracao; \"ÓrgãoDeInvestigação —PRODUZ→ IndícioPatrimonial\", \"IndícioPatrimonial —FUNDAMENTA→ MedidaDeConstrição\" e \"—REFERE_SE_A→ Ativo\" (constricao-perdimento-e-destinacao-de-ativos-entidades.md). Não há classe de órgão de investigação na ontologia (é tipoDeAtor de AtorInstitucional); quem produz o indício, pelo ASD (lastro humano), é a unidade de busca patrimonial."@pt-BR ;
  skos:changeNote "AJ-458 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: DKC: ConsultaAFonte / ConsultaAFonteDeDados / RegistroDeConsultaAFonte aparece em cinco categorias (identificação de pessoas, constrição, movimentação financeira, registro e titularidade, valoração) com os mesmos campos — base consultada, data da consulta, data de corte, chave utilizada, resultado (inclusive negativo), via de obtenção — e as relações \"ConsultaAFonte —DIRIGIDA_A→ SistemaOuBaseDeDados\", \"—REALIZADA_POR→ ÓrgãoDeBuscaPatrimonial\", \"—TEM_ALVO→ Pessoa\", \"—PRODUZ→ AsserçãoDeTitularidade / ValorEconômicoDeAtivo / DocumentoFonte\", \"—ATRIBUI→ StatusProbatório\" e \"DossiêPatrimonial —COMPOSTO_POR→ ConsultaAFonte\". A DKD descartou a classe, e com isso SistemaDeInformacao ficou sem uso analítico: nada dizia de que base, em que data e com que chave veio uma informação. É o que o ASD pede em R50 (procedência: base consultada, data da consulta), R51 (resultado como \"foto\" datada, não sobrescrita) e R52 (negativa de consulta registrada, para que ausência de resultado não seja lida como ausência de patrimônio) [R50–R52: lastro apenas sintético — requer validação humana]; a DKC marca a negativa e a data de corte como \"inexistente hoje\". O ORR já previa prov:Activity para \"a cadeia de proveniência das diligências que compõem o dossiê\"."@pt-BR ;
  skos:changeNote "AJ-459 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: DKC: ConsultaAFonte / ConsultaAFonteDeDados / RegistroDeConsultaAFonte aparece em cinco categorias (identificação de pessoas, constrição, movimentação financeira, registro e titularidade, valoração) com os mesmos campos — base consultada, data da consulta, data de corte, chave utilizada, resultado (inclusive negativo), via de obtenção — e as relações \"ConsultaAFonte —DIRIGIDA_A→ SistemaOuBaseDeDados\", \"—REALIZADA_POR→ ÓrgãoDeBuscaPatrimonial\", \"—TEM_ALVO→ Pessoa\", \"—PRODUZ→ AsserçãoDeTitularidade / ValorEconômicoDeAtivo / DocumentoFonte\", \"—ATRIBUI→ StatusProbatório\" e \"DossiêPatrimonial —COMPOSTO_POR→ ConsultaAFonte\". A DKD descartou a classe, e com isso SistemaDeInformacao ficou sem uso analítico: nada dizia de que base, em que data e com que chave veio uma informação. É o que o ASD pede em R50 (procedência: base consultada, data da consulta), R51 (resultado como \"foto\" datada, não sobrescrita) e R52 (negativa de consulta registrada, para que ausência de resultado não seja lida como ausência de patrimônio) [R50–R52: lastro apenas sintético — requer validação humana]; a DKC marca a negativa e a data de corte como \"inexistente hoje\". O ORR já previa prov:Activity para \"a cadeia de proveniência das diligências que compõem o dossiê\"."@pt-BR ;
  skos:changeNote "AJ-460 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: DKC: ConsultaAFonte / ConsultaAFonteDeDados / RegistroDeConsultaAFonte aparece em cinco categorias (identificação de pessoas, constrição, movimentação financeira, registro e titularidade, valoração) com os mesmos campos — base consultada, data da consulta, data de corte, chave utilizada, resultado (inclusive negativo), via de obtenção — e as relações \"ConsultaAFonte —DIRIGIDA_A→ SistemaOuBaseDeDados\", \"—REALIZADA_POR→ ÓrgãoDeBuscaPatrimonial\", \"—TEM_ALVO→ Pessoa\", \"—PRODUZ→ AsserçãoDeTitularidade / ValorEconômicoDeAtivo / DocumentoFonte\", \"—ATRIBUI→ StatusProbatório\" e \"DossiêPatrimonial —COMPOSTO_POR→ ConsultaAFonte\". A DKD descartou a classe, e com isso SistemaDeInformacao ficou sem uso analítico: nada dizia de que base, em que data e com que chave veio uma informação. É o que o ASD pede em R50 (procedência: base consultada, data da consulta), R51 (resultado como \"foto\" datada, não sobrescrita) e R52 (negativa de consulta registrada, para que ausência de resultado não seja lida como ausência de patrimônio) [R50–R52: lastro apenas sintético — requer validação humana]; a DKC marca a negativa e a data de corte como \"inexistente hoje\". O ORR já previa prov:Activity para \"a cadeia de proveniência das diligências que compõem o dossiê\"."@pt-BR ;
  skos:changeNote "AJ-503 (2026-10-06, fonte: modelagem): sugestão da IA (claude-opus-5-5 (anthropic), via Claude Code), autorizada pelo administrador: AlienacaoAntecipada.valorApurado (\"[requer pesquisa adicional]\", decimal solto) vira a relação que a DKC já registra: \"AlienaçãoJudicialOuLeilão —GERA→ ValorEconômicoDeAtivo\" (valoração), com tipoDeValor \"de alienação\" (AJ-480). Mesmo verbo de Repatriacao e AvaliacaoPatrimonial PRODUZ ValorEconomicoDeAtivo. CPP art. 144-A: o produto da alienação é depositado em conta vinculada ao juízo — é o valor que substitui o bem."@pt-BR .

