rec:refereSeA a owl:ObjectProperty ;
  rdfs:label "REFERE_SE_A"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:Contrato rec:ExtratoDeMovimentacaoFinanceira rec:IndicioPatrimonial rec:InterposicaoDePessoa rec:PedidoDeCooperacaoJuridicaInternacional ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( rec:Ativo rec:ContaBancaria ) ] ;
  rdfs:comment "Contrato REFERE_SE_A Ativo — FIBO defines terms for — bem objeto do contrato"@pt-BR ;
  rdfs:comment "ExtratoDeMovimentacaoFinanceira REFERE_SE_A ContaBancaria — Relação explicitamente modelada."@pt-BR ;
  rdfs:comment "IndicioPatrimonial REFERE_SE_A Ativo"@pt-BR ;
  rdfs:comment "InterposicaoDePessoa REFERE_SE_A Ativo"@pt-BR ;
  rdfs:comment "PedidoDeCooperacaoJuridicaInternacional REFERE_SE_A Ativo — Relação central recorrente."@pt-BR ;
  rec:proveniencia "inclui par(es) adicionado(s) manualmente na revisão humana da DKD"@pt-BR ;
  skos:changeNote "AJ-75 (2026-10-05, fonte: ontologia_externa): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: ASD R4 e R5 (lastro humano; resposta B1: \"pessoa usada como proprietário aparente de um ativo para ocultar a real propriedade\"; cadeia condenado ↔ interposta pessoa ↔ … ↔ ativo). O ORR mantém a lacuna externa FIBO \"controlling nominee\" (o \"laranja\" como classe própria). Sem alinhamento: a IRI não está no catálogo. Sem metadado de sistema: atributos próprios [requer pesquisa adicional]."@pt-BR ;
  skos:changeNote "AJ-329 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC literal: IndícioPatrimonial com descricao, origemDaInformacao e dataDaApuracao; \"ÓrgãoDeInvestigação —PRODUZ→ IndícioPatrimonial\", \"IndícioPatrimonial —FUNDAMENTA→ MedidaDeConstrição\" e \"—REFERE_SE_A→ Ativo\" (constricao-perdimento-e-destinacao-de-ativos-entidades.md). Não há classe de órgão de investigação na ontologia (é tipoDeAtor de AtorInstitucional); quem produz o indício, pelo ASD (lastro humano), é a unidade de busca patrimonial."@pt-BR .

rec:refereSeA_Contrato a owl:ObjectProperty ;
  rdfs:label "REFERE_SE_A (Contrato)"@pt-BR ;
