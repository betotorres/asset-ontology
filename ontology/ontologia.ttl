rec:contem a owl:ObjectProperty ;
  rdfs:label "CONTÉM"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:MatriculaImobiliaria rec:ProcessoJudicial ) ] ;
