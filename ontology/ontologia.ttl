rec:instrumentadoPor a owl:ObjectProperty ;
  rdfs:label "INSTRUMENTADO_POR"@pt-BR ;
  rdfs:domain rec:VinculoDeRepresentacao ;
  rdfs:range rec:ProcuracaoPublica ;
  rdfs:comment "VinculoDeRepresentacao INSTRUMENTADO_POR ProcuracaoPublica"@pt-BR ;
  skos:changeNote "AJ-217 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: DKC identificação de pessoas: \"VínculoDeRepresentação (especialização de VínculoEntrePessoas): tipoDeRepresentação (representante legal, procurador), indicadorDeControleDeFato (ex.: empresa controlada por procuração), INSTRUMENTADO_POR AtoNotarial\". Lacuna externa FTM Representation mantida no ORR, IRI confirmada."@pt-BR .

rec:instrumentalizadoPor a owl:ObjectProperty ;
  rdfs:label "INSTRUMENTALIZADO_POR"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:AtoRegistral rec:Contrato ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( rec:AtoNotarial rec:EscrituraPublica ) ] ;
  rdfs:comment "AtoRegistral INSTRUMENTALIZADO_POR AtoNotarial — Relação explicitamente modelada."@pt-BR ;
  rdfs:comment "Contrato INSTRUMENTALIZADO_POR EscrituraPublica"@pt-BR ;
  skos:changeNote "AJ-241 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: EscrituraPublica \"formaliza negócio sobre bem ou direito (compra e venda, doação, permuta, integralização)\" — esses negócios são contratos, e a classe já carrega valorDeclarado e indicioDeSubdeclaracaoDeValor (DKC C2: \"escritura com valor subdeclarado\"). Nada ligava a escritura ao contrato que ela instrumentaliza; mesmo verbo já usado em AtoRegistral INSTRUMENTALIZADO_POR AtoNotarial. O contrato só por instrumento particular (DKC: \"contrato particular\", \"contrato de gaveta\") é o que não tem essa relação."@pt-BR .

rec:instrumentalizadoPor_AtoRegistral a owl:ObjectProperty ;
