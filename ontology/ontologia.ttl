rec:temEndereco a owl:ObjectProperty ;
  rdfs:label "TEM_ENDERECO"@pt-BR ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( rec:BemImovel rec:PessoaFisica rec:PessoaJuridica rec:RegistroDeIdentificacaoDeCliente ) ] ;
  rdfs:range rec:Endereco ;
  rdfs:comment "BemImovel TEM_ENDERECO Endereco — Substitui o campo de texto livre BemImovel.endereco, promovido à classe Endereco por duplicação com PessoaFísica e PessoaJurídica."@pt-BR ;
  rdfs:comment "PessoaFísica TEM_ENDERECO Endereco — Substitui o campo de texto livre PessoaFísica.enderecoDeclarado, promovido à classe Endereco por duplicação com BemImovel e PessoaJurídica."@pt-BR ;
  rdfs:comment "PessoaJurídica TEM_ENDERECO Endereco — Substitui o campo de texto livre PessoaJurídica.endereco, promovido à classe Endereco por duplicação com BemImovel e PessoaFísica."@pt-BR ;
  rdfs:comment "RegistroDeIdentificacaoDeCliente TEM_ENDERECO Endereco"@pt-BR ;
  rec:proveniencia "inclui par(es) adicionado(s) manualmente na revisão humana da DKD"@pt-BR ;
  skos:changeNote "AJ-238 (2026-10-06, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: A DKC captura o registro KYC do prestador de serviços de ativos virtuais com \"campos de identificação, documento, endereço, contas vinculadas\" (movimentacao-financeira-e-capacidade-economica-entidades.md). O endereço declarado à exchange é dado próprio do registro — pode divergir do endereço cadastral da pessoa, e essa divergência é insumo da busca patrimonial —, então segue o mesmo padrão TEM_ENDERECO de BemImovel, PessoaFísica e PessoaJurídica, com FIBO has address."@pt-BR .

