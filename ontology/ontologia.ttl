rec:temAutoridadeRequerente a owl:ObjectProperty ;
  rdfs:label "TEM_AUTORIDADE_REQUERENTE"@pt-BR ;
  rdfs:domain rec:PedidoDeCooperacaoJuridicaInternacional ;
  rdfs:range rec:AutoridadeCentral ;
  rdfs:comment "PedidoDeCooperacaoJuridicaInternacional TEM_AUTORIDADE_REQUERENTE AutoridadeCentral"@pt-BR ;
  skos:changeNote "AJ-103 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Requerente/requerida/intermediadora é papel por pedido — a mesma autoridade é requerente num pedido e requerida noutro —, então não pode ser atributo da autoridade. ASD R24 pede os papéis de autoridade requisitante e requerida como papéis distintos; viram duas relações do pedido para a autoridade central."@pt-BR .

rec:temAutoridadeRequerida a owl:ObjectProperty ;
  rdfs:label "TEM_AUTORIDADE_REQUERIDA"@pt-BR ;
  rdfs:domain rec:PedidoDeCooperacaoJuridicaInternacional ;
  rdfs:range rec:AutoridadeCentral ;
  rdfs:comment "PedidoDeCooperacaoJuridicaInternacional TEM_AUTORIDADE_REQUERIDA AutoridadeCentral"@pt-BR ;
  skos:changeNote "AJ-104 (2026-10-05, fonte: modelagem): sugestão da IA (claude-fable-5-1 (anthropic), via Claude Code), autorizada pelo administrador: Requerente/requerida/intermediadora é papel por pedido — a mesma autoridade é requerente num pedido e requerida noutro —, então não pode ser atributo da autoridade. ASD R24 pede os papéis de autoridade requisitante e requerida como papéis distintos; viram duas relações do pedido para a autoridade central."@pt-BR .

rec:temCausa a owl:ObjectProperty ;
